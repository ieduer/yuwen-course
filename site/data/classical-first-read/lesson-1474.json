  "title": "5、《论语》十二章",
  "textVersionId": "cfr-lesson-1474-1253a91eca5d93e2",
  "textDigest": "sha256:1253a91eca5d93e2e58cf6662d824103861c1bdd9e7dc3ff44925d45bfd32422",
  "canonicalPunctuatedDigest": "sha256:69478a884240d40b4d77f1479ec4a12734cf048d6c2bfb8558bf8057c31857ac",
  "source": {
