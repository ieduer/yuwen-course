":"n64","label":"64","page":151,"runs":[{"t":"〔为（wéi）坛而盟〕筑台并（在台上）起誓。盟，发誓、起誓。"}]},{"id":"n65","label":"65","page":151,"runs":[{"t":"〔祭以尉首〕用两尉的头作祭品。"}]},{"id":"n66","label":"66","page":151,"runs":[{"t":"〔都尉〕略低于将军的武官。"}]},{"id":"n67","label":"67","page":151,"runs":[{"t":"〔收而攻蕲（qí）〕招收大泽乡的军队，攻打蕲县。蕲，在今安徽宿州南。"}]},{"id":"n68","label":"68","page":151,"runs":[{"t":"〔下〕攻下，攻克。"}]},{"id":"n69","label":"69","page":151,"runs":[{"t":"〔符离〕今属安徽宿州。"}]},{"id":"n70","label":"70","page":151,"runs":[{"t":"〔徇（xùn）〕招抚。"}]},{"id":"n71","label":"71","page":151,"runs":[{"t":"〔铚（zhì）、酂（cuó）、苦（hù）、柘（zhè）、谯（qiáo）〕均为秦时地名。铚，在今安徽宿州西南。酂，在今河南永城西。苦，在今河南鹿邑东。柘，在今河南柘城西北。谯，今安徽亳州。"}]},{"id":"n72","label":"72","page":151,"runs":[{"t":"〔行收兵〕行军中沿途招收士兵。"}]},{"id":"n73","label":"73","page":151,"runs":[{"t":"〔比〕等到。"}]},{"id":"n74","label":"74","page":151,"runs":[{"t":"〔陈〕今河南淮阳。"}]},{"id":"n75","label":"75","page":151,"runs":[{"t":"〔守令皆不在〕郡守、县令都不在。秦时，陈县是郡府、县府的所在地，所以有守有令。"}]},{"id":"n76","label":"76","page":151,"runs":[{"t":"〔守丞〕辅助郡守、县令的主要官吏。"}]},{"id":"n77","label":"77","page":151,"runs":[{"t":"〔谯门〕建有瞭望楼的城门。"}]},{"id":"n78","label":"78","page":151,"runs":[{"t":"〔三老〕掌管教化的乡官。"}]},{"id":"n79","label":"79","page":151,"runs":[{"t":"〔豪杰〕这里指当地有势力有地位的人。"}]},{"id":"n80","label":"80","page":151,"runs":[{"t":"〔与皆来会计事〕一起来集会议事。"}]},{"id":"n81","label":"81","page":152,"runs":[{"t":"〔身被（pī）坚执锐〕自己穿着铠甲，拿着武器，意思是亲自作战。被，同“披”。坚，指铠甲。锐，指武器。"}]},{"id":"n82","label":"82","page":152,"runs":[{"t":"〔社稷（jì）〕国家。社，土地神。稷，谷神。古代帝王诸侯祭社稷，祈求丰年，后来就把社稷作为国家的代称。"}]},{"id":"n83","label":"83","page":152,"runs":[{"t":"〔号为张楚〕对外宣称要张大楚国，即复兴楚国之意。号，宣称。一说定国号为“张楚”。"}]},{"id":"n84","label":"84","page":152,"runs":[{"t":"〔刑其长吏〕惩处当地郡县长官。刑，惩处。"}]}]}
