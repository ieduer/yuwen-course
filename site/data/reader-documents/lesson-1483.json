{"curationManifestSha256":"98e90b3603b34b437bc554810c21f01c4db44d10364211af114d30fde3d67bad","curationVersion":"2026-07-30.2","lessonId":"lesson-1483","main":{"annotations":[{"blocks":[{"runs":[{"text":"毂（ɡǔ）：车轮的中心部位，周围与辐条的一端相接，中间的圆孔用来插车轴。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-1"},{"blocks":[{"runs":[{"text":"当其无，有车之用：意思是，车的功用正是产生于车毂的“无”。无，指车毂的中空处。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-2"},{"blocks":[{"runs":[{"text":"埏（shān）埴（zhí）：和泥（制作陶器）。埏，揉和。埴，黏土。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-3"},{"blocks":[{"runs":[{"text":"户牖（yǒu）：门窗。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-4"},{"blocks":[{"runs":[{"text":"有之以为利，无之以为用：意思是，“有”（车子、器皿、屋室）供人方便利用，正是“无”起了作用。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-5"},{"blocks":[{"runs":[{"text":"企者不立：踮起脚的人不能久立。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-6"},{"blocks":[{"runs":[{"text":"跨者不行：跨大步的人行走不稳。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-7"},{"blocks":[{"runs":[{"text":"自见（xiàn）者不明：自我显露的不能显明。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-8"},{"blocks":[{"runs":[{"text":"自是者不彰：自以为是的不能彰显。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-9"},{"blocks":[{"runs":[{"text":"自伐：自我夸耀。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-10"},{"blocks":[{"runs":[{"text":"长：长久。一说读zhǎng，意思是得到敬重。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-11"},{"blocks":[{"runs":[{"text":"其在道也，曰余食赘行，物或恶之：用道的观点来看，“自见”“自是”“自伐”“自矜”等行为就叫作剩饭、赘瘤，人们常常厌恶它们。行，同“形”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-12"},{"blocks":[{"runs":[{"text":"处：为，做。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-13"},{"blocks":[{"runs":[{"text":"强（qiǎng）行者有志：勤勉而行的人有意志。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-14"},{"blocks":[{"runs":[{"text":"不失其所者久：不丧失立身之基的人能够长久。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-15"},{"blocks":[{"runs":[{"text":"死而不亡者寿：死而不朽的人就是长寿。意思是，有道之人身死而道长存，这就是寿。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-16"},{"blocks":[{"runs":[{"text":"其安易持：事物安然未生变的时候容易持守。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-17"},{"blocks":[{"runs":[{"text":"其未兆易谋：问题还没有显露迹象的时候容易解决。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-18"},{"blocks":[{"runs":[{"text":"其脆易泮：事物脆弱的时候容易分离。泮，同“判”，分离。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-19"},{"blocks":[{"runs":[{"text":"其微易散：事物细微的时候容易散失。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-20"},{"blocks":[{"runs":[{"text":"为之于未有：在事情未发生时就做。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-21"},{"blocks":[{"runs":[{"text":"毫末：毫毛的末端。比喻极其细微的事物。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-22"},{"blocks":[{"runs":[{"text":"累（léi）土：一筐土。累，同“蔂”，土筐。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-23"},{"blocks":[{"runs":[{"text":"为者败之：动手去做的就会坏事。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-24"},{"blocks":[{"runs":[{"text":"执者失之：有所把持的就会失去。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-25"},{"blocks":[{"runs":[{"text":"无为：指顺应自然，不求有所作为。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-26"},{"blocks":[{"runs":[{"text":"几（jī）：接近。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-27"},{"blocks":[{"runs":[{"text":"欲不欲：想要常人所不想要的。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-28"},{"blocks":[{"runs":[{"text":"学不学：学习常人所不学习的。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-29"},{"blocks":[{"runs":[{"text":"复众人之所过：补救众人所犯的过错。复，弥补、补救。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-9996-30"}],"blocks":[{"runs":[{"text":"用斜线（/）给下面文言文断句。（5分）","type":"text"}],"type":"paragraph"},{"runs":[{"text":"天之道其犹张弓与高者抑之下者举之有馀者损之不足者补之天之道损有馀而补不足人之道则不然损不足以奉有馀孰能有馀以奉天下唯有道者是以圣人为而不恃功成而不处。","type":"text"}],"type":"paragraph"},{"blocks":[{"runs":[{"text":"选自《老子道德经注校释》（中华书局2008 年版）","type":"text"}],"type":"paragraph"},{"runs":[{"text":"老子（生卒年不详），即老聃，相传姓李名耳，字伯阳，楚国苦县（今河南鹿邑东）人，春秋时期哲学家，道家学派创始人。做过周朝管理藏书的史官，相传孔子曾向他问礼。《老子》又称《道德经》，传世本共八十一章。其书是否为老子所著，历来有争议，一般认为书中所述基本反映了他的思想。","type":"text"}],"type":"paragraph"}],"type":"quote"},{"runs":[{"text":"三十辐共一毂","type":"text"},{"label":"[1]","noteId":"footnote-9996-1","type":"annotation-ref"},{"text":"，当其无，有车之用","type":"text"},{"label":"[2]","noteId":"footnote-9996-2","type":"annotation-ref"},{"text":"。埏埴","type":"text"},{"label":"[3]","noteId":"footnote-9996-3","type":"annotation-ref"},{"text":"以为器，当其无，有器之用。凿户牖","type":"text"},{"label":"[4]","noteId":"footnote-9996-4","type":"annotation-ref"},{"text":"以为室，当其无，有室之用。故有之以为利，无之以为用","type":"text"},{"label":"[5]","noteId":"footnote-9996-5","type":"annotation-ref"},{"text":"。（第十一章）","type":"text"}],"type":"paragraph"},{"runs":[{"text":"企者不立","type":"text"},{"label":"[6]","noteId":"footnote-9996-6","type":"annotation-ref"},{"text":"，跨者不行","type":"text"},{"label":"[7]","noteId":"footnote-9996-7","type":"annotation-ref"},{"text":"，自见者不明","type":"text"},{"label":"[8]","noteId":"footnote-9996-8","type":"annotation-ref"},{"text":"，自是者不彰","type":"text"},{"label":"[9]","noteId":"footnote-9996-9","type":"annotation-ref"},{"text":"，自伐","type":"text"},{"label":"[10]","noteId":"footnote-9996-10","type":"annotation-ref"},{"text":"者无功，自矜者不长","type":"text"},{"label":"[11]","noteId":"footnote-9996-11","type":"annotation-ref"},{"text":"。其在道也，曰余食赘行，物或恶之","type":"text"},{"label":"[12]","noteId":"footnote-9996-12","type":"annotation-ref"},{"text":"，故有道者不处","type":"text"},{"label":"[13]","noteId":"footnote-9996-13","type":"annotation-ref"},{"text":"。（第二十四章）","type":"text"}],"type":"paragraph"},{"runs":[{"text":"知人者智，自知者明。胜人者有力，自胜者强。知足者富，强行者有志","type":"text"},{"label":"[14]","noteId":"footnote-9996-14","type":"annotation-ref"},{"text":"。不失其所者久","type":"text"},{"label":"[15]","noteId":"footnote-9996-15","type":"annotation-ref"},{"text":"，死而不亡者寿","type":"text"},{"label":"[16]","noteId":"footnote-9996-16","type":"annotation-ref"},{"text":"。（第三十三章）","type":"text"}],"type":"paragraph"},{"runs":[{"text":"其安易持","type":"text"},{"label":"[17]","noteId":"footnote-9996-17","type":"annotation-ref"},{"text":"，其未兆易谋","type":"text"},{"label":"[18]","noteId":"footnote-9996-18","type":"annotation-ref"},{"text":"，其脆易泮","type":"text"},{"label":"[19]","noteId":"footnote-9996-19","type":"annotation-ref"},{"text":"，其微易散","type":"text"},{"label":"[20]","noteId":"footnote-9996-20","type":"annotation-ref"},{"text":"。为之于未有","type":"text"},{"label":"[21]","noteId":"footnote-9996-21","type":"annotation-ref"},{"text":"，治之于未乱。合抱之木，生于毫末","type":"text"},{"label":"[22]","noteId":"footnote-9996-22","type":"annotation-ref"},{"text":"；九层之台，起于累土","type":"text"},{"label":"[23]","noteId":"footnote-9996-23","type":"annotation-ref"},{"text":"；千里之行，始于足下。为者败之","type":"text"},{"label":"[24]","noteId":"footnote-9996-24","type":"annotation-ref"},{"text":"，执者失之","type":"text"},{"label":"[25]","noteId":"footnote-9996-25","type":"annotation-ref"},{"text":"。是以圣人无为","type":"text"},{"label":"[26]","noteId":"footnote-9996-26","type":"annotation-ref"},{"text":"，故无败；无执，故无失。民之从事，常于几","type":"text"},{"label":"[27]","noteId":"footnote-9996-27","type":"annotation-ref"},{"text":"成而败之。慎终如始，则无败事。是以圣人欲不欲","type":"text"},{"label":"[28]","noteId":"footnote-9996-28","type":"annotation-ref"},{"text":"，不贵难得之货，学不学","type":"text"},{"label":"[29]","noteId":"footnote-9996-29","type":"annotation-ref"},{"text":"，复众人之所过","type":"text"},{"label":"[30]","noteId":"footnote-9996-30","type":"annotation-ref"},{"text":"，以辅万物之自然而不敢为。（第六十四章）","type":"text"}],"type":"paragraph"},{"runs":[{"text":"昔晉公子重耳出亡過鄭，鄭君不禮，叔瞻諫曰：「此賢公子也，君厚待之，可以積德。」鄭君不聽。叔瞻又諫曰：「不厚待之，不若殺之，無令有後患。」鄭君又不聽。及公子返晉邦，舉兵伐鄭，大破之，取八城焉。晉獻公以垂棘之璧假道於虞而伐虢，大夫宮之奇諫曰：「不可。脣亡而齒寒，虞、虢相救，非相德也。今日晉滅虢，明日虞必隨之亡。」虞君不聽，受其璧而假之道。晉已取虢，還，反滅虞。此二臣者皆爭於腠理者也，而二君不用也。然則叔瞻、宮之奇亦虞、鄭之扁鵲也，而二君不聽，故鄭以破，虞以亡。故曰：「其安易持也，其未兆易謀也。」","type":"text"}],"type":"paragraph"}],"frontMatter":[],"guidance":[],"links":[{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/cover3/xbs09/6%e8%80%81%e5%ad%90%e5%9b%9b%e7%ab%a0","sourceUrl":"https://sites.google.com/view/pkuschool/cover3/xbs09/6%e8%80%81%e5%ad%90%e5%9b%9b%e7%ab%a0","text":"https://sites.google.com/view/pkuschool/cover3/xbs09/6%e8%80%81%e5%ad%90%e5%9b%9b%e7%ab%a0","title":null}],"media":[{"alt":"","bytes":4205068,"finalUrl":"https://files.rdfzer.com/optimized/2X/9/9d42a1fdd5200e4f7eb6c6de7c61c126bf6b0567_2_14399x959.jpeg","height":959,"id":"media-3be7ea5b411d9af7a9b7","mediaType":"image/jpeg","nativeDisposition":"verified-in-app","receiptCollectedAt":"2026-07-30T01:10:43.464Z","receiptRequired":true,"rightsBasis":"user-authorized-course-source-use-2026-07-29","sha256":"09991329a514b1a7d2a04528a4eec9937fdeb79b1a7a92c0c0b1cedc01fbb6e6","sourceUrl":"https://files.rdfzer.com/optimized/2X/9/9d42a1fdd5200e4f7eb6c6de7c61c126bf6b0567_2_14399x959.jpeg","webDisposition":"source-url","width":14399}],"sourceOnlyBlocks":[],"sourcePostId":9996,"sourcePostNumber":1},"mediaReceiptLedgerSha256":"5487243dd8d14d65dfadc20ed544a999aaa318fc20c291462ea62c69e1eff320","mediaReceiptLedgerVersion":"2026-07-30.2","provenance":{"links":[{"disposition":"system-browser","href":"https://files.rdfzer.com/original/2X/9/9d42a1fdd5200e4f7eb6c6de7c61c126bf6b0567.jpeg","postId":9996,"postNumber":1,"postRole":"primary","sourceUrl":"https://files.rdfzer.com/original/2X/9/9d42a1fdd5200e4f7eb6c6de7c61c126bf6b0567.jpeg","text":"https://files.rdfzer.com/original/2X/9/9d42a1fdd5200e4f7eb6c6de7c61c126bf6b0567.jpeg","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-9996-1","postId":9996,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-9996-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-9996-2","postId":9996,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-9996-2","text":"[2]","title":nu