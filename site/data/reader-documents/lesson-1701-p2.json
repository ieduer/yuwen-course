{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1701-p2","main":{"annotations":[{"blocks":[{"runs":[{"text":"〔兜鍪（móu）〕古代打仗时战士所戴的头盔。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11133-8"},{"blocks":[{"runs":[{"text":"〔胛〕肩胛。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11133-9"},{"blocks":[{"runs":[{"text":"〔渠〕他。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11133-10"},{"blocks":[{"runs":[{"text":"〔半霎〕极短的时间。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11133-11"},{"blocks":[{"runs":[{"text":"〔莳（shì）未匝〕意思是，这块田里还没有栽插完毕。莳，移栽、种植。匝，布满、遍及。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11133-12"},{"blocks":[{"runs":[{"text":"〔照管〕照料，照看。这里是“提防”的意思。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11133-13"}],"blocks":[{"runs":[{"text":"插秧歌\n\n杨万里\n\n田夫抛秧田妇接，小儿拔秧大儿插。\n\n笠是兜鍪","type":"text"},{"label":"[1]","noteId":"footnote-11133-8","type":"annotation-ref"},{"text":"蓑是甲，雨从头上湿到胛","type":"text"},{"label":"[2]","noteId":"footnote-11133-9","type":"annotation-ref"},{"text":"。\n\n唤渠","type":"text"},{"label":"[3]","noteId":"footnote-11133-10","type":"annotation-ref"},{"text":"朝餐歇半霎","type":"text"},{"label":"[4]","noteId":"footnote-11133-11","type":"annotation-ref"},{"text":"，低头折腰只不答：\n\n“秧根未牢莳未匝","type":"text"},{"label":"[5]","noteId":"footnote-11133-12","type":"annotation-ref"},{"text":"，照管","type":"text"},{"label":"[6]","noteId":"footnote-11133-13","type":"annotation-ref"},{"text":"鹅儿与雏鸭。”","type":"text"}],"type":"paragraph"}],"frontMatter":[],"guidance":[],"links":[],"media":[],"sourceOnlyBlocks":[],"sourcePostId":"11133-2","sourcePostNumber":1},"mediaReceiptLedgerSha256":"0319bd9f7623eb57ee396cafc0343cb6c4dc51dce258109a19edbdddd91be71c","mediaReceiptLedgerVersion":"2026-08-09.1","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11133-1","postId":"11133-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11133-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11133-2","postId":"11133-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11133-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11133-3","postId":"11133-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11133-3","text":"[3]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11133-4","postId":"11133-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11133-4","text":"[4]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11133-5","postId":"11133-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11133-5","text":"[5]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11133-6","postId":"11133-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11133-6","text":"[6]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11133-7","postId":"11133-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11133-7","text":"[7]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11133-8","postId":"11133-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11133-8","text":"[8]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11133-9","postId":"11133-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11133-9","text":"[9]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11133-10","postId":"11133-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.