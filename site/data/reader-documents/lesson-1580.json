{"curationManifestSha256":"98e90b3603b34b437bc554810c21f01c4db44d10364211af114d30fde3d67bad","curationVersion":"2026-07-30.2","lessonId":"lesson-1580","main":{"annotations":[{"blocks":[{"runs":[{"text":"〔病偻〕患了脊背弯曲的病。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-1"},{"blocks":[{"runs":[{"text":"〔隆然〕脊背高起的样子。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-2"},{"blocks":[{"runs":[{"text":"〔伏行〕弯着腰走。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-3"},{"blocks":[{"runs":[{"text":"〔名我固当〕用这个名字称呼我确实很恰当。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-4"},{"blocks":[{"runs":[{"text":"〔业种树〕以种树为业。业，以……为业。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-5"},{"blocks":[{"runs":[{"text":"〔观游〕观赏游览。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-6"},{"blocks":[{"runs":[{"text":"〔卖果〕指种树卖果。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-7"},{"blocks":[{"runs":[{"text":"〔争迎取养〕争着迎接和雇用郭橐驼。迎取，迎接。养，用、使。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-8"},{"blocks":[{"runs":[{"text":"〔移徙〕移植。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-9"},{"blocks":[{"runs":[{"text":"〔硕茂〕高大茂盛。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-10"},{"blocks":[{"runs":[{"text":"〔早实以蕃〕结果实早且多。实，结果实。蕃，多。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-11"},{"blocks":[{"runs":[{"text":"〔窥伺效慕〕暗中观察仿效。效慕，仿效。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-12"},{"blocks":[{"runs":[{"text":"〔寿且孳〕活得长久且孳长茂盛。孳，繁殖。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-13"},{"blocks":[{"runs":[{"text":"〔天〕天性，指自然生长规律。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-14"},{"blocks":[{"runs":[{"text":"〔致其性〕使它依照本性生长。致，使达到。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-15"},{"blocks":[{"runs":[{"text":"〔植木之性〕指种树的方法。性，性质、方法。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-16"},{"blocks":[{"runs":[{"text":"〔本〕根。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-17"},{"blocks":[{"runs":[{"text":"〔培〕培土。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-18"},{"blocks":[{"runs":[{"text":"〔其土欲故〕意思是种树要用旧土。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-19"},{"blocks":[{"runs":[{"text":"〔筑〕捣土。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-20"},{"blocks":[{"runs":[{"text":"〔既然已〕已经种完了。既，已经。然，这样。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-21"},{"blocks":[{"runs":[{"text":"〔勿动勿虑〕不要再动它，不要再惦记它。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-22"},{"blocks":[{"runs":[{"text":"〔去不复顾〕离开后就不再去照看它。顾，照看。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-23"},{"blocks":[{"runs":[{"text":"〔莳（shì）〕栽种。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-24"},{"blocks":[{"runs":[{"text":"〔若子〕像对待孩子那样。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-25"},{"blocks":[{"runs":[{"text":"〔其置也若弃〕意思是，种完后就像丢弃了一样不再管它。置，放下。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-26"},{"blocks":[{"runs":[{"text":"〔抑耗其实〕损伤它的果实。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-27"},{"blocks":[{"runs":[{"text":"〔拳〕拳曲，伸展不开。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-28"},{"blocks":[{"runs":[{"text":"〔土易〕土换成了新的。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-29"},{"blocks":[{"runs":[{"text":"〔若不过焉则不及〕（培土）如果不是多了，就是不够。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-30"},{"blocks":[{"runs":[{"text":"〔爱之太恩〕这里指养护太过。恩，宠爱。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-31"},{"blocks":[{"runs":[{"text":"〔爪其肤以验其生枯〕用指甲抠树皮来察看它是活着还是枯死了。爪，指甲，用作动词，用指甲抠、掐。肤，指树皮。生枯，生死。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-32"},{"blocks":[{"runs":[{"text":"〔疏密〕指土的松紧。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-33"},{"blocks":[{"runs":[{"text":"〔离〕背离。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-34"},{"blocks":[{"runs":[{"text":"〔不我若〕不如我，比不上我。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-35"},{"blocks":[{"runs":[{"text":"〔吾又何能为哉〕意思是，我又有什么特别的能耐呢？","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-36"},{"blocks":[{"runs":[{"text":"〔官理〕做官治民。理，治。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-37"},{"blocks":[{"runs":[{"text":"〔长（zhǎng）人者〕做官的。长，统治、治理。人，民。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-38"},{"blocks":[{"runs":[{"text":"〔好烦其令〕喜好多发政令。烦，繁多。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-39"},{"blocks":[{"runs":[{"text":"〔若甚怜焉〕好像很怜爱百姓的样子。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-40"},{"blocks":[{"runs":[{"text":"〔卒以祸〕到头来因此害了他们。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-41"},{"blocks":[{"runs":[{"text":"〔勖尔植〕勉励你们种植。勖，勉励。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-42"},{"blocks":[{"runs":[{"text":"〔早缫（sāo）而绪〕早早地煮茧抽丝。缫，把蚕茧浸在热水里抽出蚕丝。而，你们的。绪，丝头。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-43"},{"blocks":[{"runs":[{"text":"〔缕〕线。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-44"},{"blocks":[{"runs":[{"text":"〔字而幼孩〕养育好你们的小孩。字，养育。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-45"},{"blocks":[{"runs":[{"text":"〔遂而鸡豚〕喂养好你们的鸡和猪。遂，成、养好。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-46"},{"blocks":[{"runs":[{"text":"〔木〕这里指木梆。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-47"},{"blocks":[{"runs":[{"text":"〔吾小人〕我们小民。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-48"},{"blocks":[{"runs":[{"text":"〔辍飧（sūn）饔（yōng）以劳吏〕中断吃饭来慰劳官吏。飧，晚饭。饔，早饭。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-49"},{"blocks":[{"runs":[{"text":"〔又何以蕃吾生而安吾性耶〕又怎么能使我们人口增多、生活安定呢？蕃，使繁盛。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-50"},{"blocks":[{"runs":[{"text":"〔故病且怠〕所以困苦并且疲倦。病，困苦。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10546-51"}],"blocks":[{"runs":[{"text":"**郭橐驼，不知始何名。病偻","type":"text"},{"label":"[1]","noteId":"footnote-10546-1","type":"annotation-ref"},{"text":"，隆然","type":"text"},{"label":"[2]","noteId":"footnote-10546-2","type":"annotation-ref"},{"text":"伏行","type":"text"},{"label":"[3]","noteId":"footnote-10546-3","type":"annotation-ref"},{"text":"，有类橐驼者，故乡人号之“驼”。驼闻之曰：“甚善。名我固当","type":"text"},{"label":"[4]","noteId":"footnote-10546-4","type":"annotation-ref"},{"text":"。”因舍其名，亦自谓“橐驼”云。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"其乡曰丰乐乡，在长安西。驼业种树","type":"text"},{"label":"[5]","noteId":"footnote-10546-5","type":"annotation-ref"},{"text":"，凡长安豪富人为观游","type":"text"},{"label":"[6]","noteId":"footnote-10546-6","type":"annotation-ref"},{"text":"及卖果","type":"text"},{"label":"[7]","noteId":"footnote-10546-7","type":"annotation-ref"},{"text":"者，皆争迎取养","type":"text"},{"label":"[8]","noteId":"footnote-10546-8","type":"annotation-ref"},{"text":"。视驼所种树，或移徙","type":"text"},{"label":"[9]","noteId":"footnote-10546-9","type":"annotation-ref"},{"text":"，无不活；且硕茂","type":"text"},{"label":"[10]","noteId":"footnote-10546-10","type":"annotation-ref"},{"text":"，早实以蕃","type":"text"},{"label":"[11]","noteId":"footnote-10546-11","type":"annotation-ref"},{"text":"。他植者虽窥伺效慕","type":"text"},{"label":"[12]","noteId":"footnote-10546-12","type":"annotation-ref"},{"text":"，莫能如也。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"有问之，对曰：“橐驼非能使木寿且孳","type":"text"},{"label":"[13]","noteId":"footnote-10546-13","type":"annotation-ref"},{"text":"也，能顺木之天","type":"text"},{"label":"[14]","noteId":"footnote-10546-14","type":"annotation-ref"},{"text":"，以致其性","type":"text"},{"label":"[15]","noteId":"footnote-10546-15","type":"annotation-ref"},{"text":"焉尔。凡植木之性","type":"text"},{"label":"[16]","noteId":"footnote-10546-16","type":"annotation-ref"},{"text":"，其本","type":"text"},{"label":"[17]","noteId":"footnote-10546-17","type":"annotation-ref"},{"text":"欲舒，其培","type":"text"},{"label":"[18]","noteId":"footnote-10546-18","type":"annotation-ref"},{"text":"欲平，其土欲故","type":"text"},{"label":"[19]","noteId":"footnote-10546-19","type":"annotation-ref"},{"text":"，其筑","type":"text"},{"label":"[20]","noteId":"footnote-10546-20","type":"annotation-ref"},{"text":"欲密。既然已","type":"text"},{"label":"[21]","noteId":"footnote-10546-21","type":"annotation-ref"},{"text":"，勿动勿虑","type":"text"},{"label":"[22]","noteId":"footnote-10546-22","type":"annotation-ref"},{"text":"，去不复顾","type":"text"},{"label":"[23]","noteId":"footnote-10546-23","type":"annotation-ref"},{"text":"。其莳","type":"text"},{"label":"[24]","noteId":"footnote-10546-24","type":"annotation-ref"},{"text":"也若子","type":"text"},{"label":"[25]","noteId":"footnote-10546-25","type":"annotation-ref"},{"text":"，其置也若弃","type":"text"},{"label":"[26]","noteId":"footnote-10546-26","type":"annotation-ref"},{"text":"，则其天者全而其性得矣。故吾不害其长而已，非有能硕茂之也；不抑耗其实","type":"text"},{"label":"[27]","noteId":"footnote-10546-27","type":"annotation-ref"},{"text":"而已，非有能早而蕃之也。他植者则不然。根拳","type":"text"},{"label":"[28]","noteId":"footnote-10546-28","type":"annotation-ref"},{"text":"而土易","type":"text"},{"label":"[29]","noteId":"footnote-10546-29","type":"annotation-ref"},{"text":"，其培之也，若不过焉则不及","type":"text"},{"label":"[30]","noteId":"footnote-10546-30","type":"annotation-ref"},{"text":"。 苟有能反是者，则又爱之太恩","type":"text"},{"label":"[31]","noteId":"footnote-10546-31","type":"annotation-ref"},{"text":"，忧之太勤。旦视而暮抚，已去而复顾。甚者，爪其肤以验其生枯","type":"text"},{"label":"[32]","noteId":"footnote-10546-32","type":"annotation-ref"},{"text":"，摇其本以观其疏密","type":"text"},{"label":"[33]","noteId":"footnote-10546-33","type":"annotation-ref"},{"text":"，而木之性日以离","type":"text"},{"label":"[34]","noteId":"footnote-10546-34","type":"annotation-ref"},{"text":"矣。虽曰爱之，其实害之；虽曰忧之，其实仇之；故不我若","type":"text"},{"label":"[35]","noteId":"footnote-10546-35","type":"annotation-ref"},{"text":"也。吾又何能为哉","type":"text"},{"label":"[36]","noteId":"footnote-10546-36","type":"annotation-ref"},{"text":" ！”","type":"text"}],"type":"paragraph"},{"runs":[{"text":"问者曰：“以子之道，移之官理","type":"text"},{"label":"[37]","noteId":"footnote-10546-37","type":"annotation-ref"},{"text":"，可乎？”驼曰：“我知种树而已，理，非吾业也。然吾居乡，见长人者","type":"text"},{"label":"[38]","noteId":"footnote-10546-38","type":"annotation-ref"},{"text":"好烦其令","type":"text"},{"label":"[39]","noteId":"footnote-10546-39","type":"annotation-ref"},{"text":"，若甚怜焉","type":"text"},{"label":"[40]","noteId":"footnote-10546-40","type":"annotation-ref"},{"text":"，而卒以祸","type":"text"},{"label":"[41]","noteId":"footnote-10546-41","type":"annotation-ref"},{"text":"。旦暮吏来而呼曰：‘官命促尔耕，勖尔植","type":"text"},{"label":"[42]","noteId":"footnote-10546-42","type":"annotation-ref"},{"text":"，督尔获，早缫而绪","type":"text"},{"label":"[43]","noteId":"footnote-10546-43","type":"annotation-ref"},{"text":"，早织而缕","type":"text"},{"label":"[44]","noteId":"footnote-10546-44","type":"annotation-ref"},{"text":"，字而幼孩","type":"text"},{"label":"[45]","noteId":"footnote-10546-45","type":"annotation-ref"},{"text":"，遂而鸡豚","type":"text"},{"label":"[46]","noteId":"footnote-10546-46","type":"annotation-ref"},{"text":"。’鸣鼓而聚之，击木","type":"text"},{"label":"[47]","noteId":"footnote-10546-47","type":"annotation-ref"},{"text":"而召之。吾小人","type":"text"},{"label":"[48]","noteId":"footnote-10546-48","type":"annotation-ref"},{"text":"辍飧饔以劳吏","type":"text"},{"label":"[49]","noteId":"footnote-10546-49","type":"annotation-ref"},{"text":"者，且不得暇，又何以蕃吾生而安吾性耶","type":"text"},{"label":"[50]","noteId":"footnote-10546-50","type":"annotation-ref"},{"text":" ？故病且怠","type":"text"},{"label":"[51]","noteId":"footnote-10546-51","type":"annotation-ref"},{"text":"。若是，则与吾业者其亦有类乎？”","type":"text"}],"type":"paragraph"},{"runs":[{"text":"问者曰：“嘻，不亦善夫！吾问养树，得养人术。”传其事以为官戒也。**","type":"text"}],"type":"paragraph"},{"blocks":[{"runs":[{"text":"本文寓意深刻，重在因事明理、针砭时弊。阅读时要注意体会文章融叙事说理于一体、婉而多讽的写法，把握对举、类比的说理方式。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"这篇文章采用了传记的常见写法，从郭橐驼的名字由来、乡里职业、本领特长写起，重点记述他的两段话。阅读这部分内容，注意思考郭橐驼与“他植者”在种树方面的根本不同，郭橐驼所说的“顺木之天”与“植木之性”之间的关系等。把这些问题理解透了，才能真正领会文中的道理。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"柳宗元是一位关注现实的文学家，《种树郭橐驼传》有着很强的现实针对性。文中由种树之道“移之官理”，借郭橐驼之口指出“长人者”政令频出的危害，批评了当时的弊政。这种“文章合为时而著”的创作态度，至今还值得学习和提倡。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"古代汉语的人称代词较为丰富。第一人称常用“吾”“我”“余”“予”，第二人称常用“女（汝）”“尔”“而”“若”“乃”，第三人称常用“其”“彼”“之”。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"从课文或之前学过的文章中找出一些实例，对古代的人称代词做一些归纳和总结。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"frontMatter":[{"blocks":[{"runs":[{"text":"选自《柳宗元集》卷十七（中华书局1979 年版）。\n\n橐（tuó）驼，即骆驼。郭橐驼因驼背而得名。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"guidance":[],"links":[{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%b8%89%e5%8d%95%e5%85%83/11-%e7%a7%8d%e6%a0%91%e9%83%ad%e6%a9%90%e9%a9%bc%e4%bc%a0-%e6%9f%b3%e5%ae%97%e5%85%83","sourceUrl":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%b8%89%e5%8d%95%e5%85%83/11-%e7%a7%8d%e6%a0%91%e9%83%ad%e6%a9%90%e9%a9%bc%e4%bc%a0-%e6%9f%b3%e5%ae%97%e5%85%83","text":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%b8%89%e5%8d%95%e5%85%83/11-%e7%a7%8d%e6%a0%91%e9%83%ad%e6%a9%90%e9%a9%bc%e4%bc%a0-%e6%9f%b3%e5%ae%97%e5%85%83","title":null}],"media":[],"sourceOnlyBlocks":[],"sourcePostId":10546,"sourcePostNumber":1},"mediaReceiptLedgerSha256":"5487243dd8d14d65dfadc20ed544a999aaa318fc20c291462ea62c69e1eff320","mediaReceiptLedgerVersion":"2026-07-30.2","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10546-1","postId":10546,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10546-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10546-2","postId":10546,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10546