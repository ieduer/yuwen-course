{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1485","main":{"annotations":[{"blocks":[{"runs":[{"text":"以治天下为事：把治理天下作为（自己的）事务。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10008-1"},{"blocks":[{"runs":[{"text":"焉：于是。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10008-2"},{"blocks":[{"runs":[{"text":"攻：治疗。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10008-3"},{"blocks":[{"runs":[{"text":"当：同“尝”，尝试。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10008-4"},{"blocks":[{"runs":[{"text":"亏：使受损失。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10008-5"},{"blocks":[{"runs":[{"text":"虽：即使。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10008-6"},{"blocks":[{"runs":[{"text":"慈：慈爱。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10008-7"},{"blocks":[{"runs":[{"text":"盗贼：偷窃和劫夺财物的人。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10008-8"},{"blocks":[{"runs":[{"text":"室：家。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10008-9"},{"blocks":[{"runs":[{"text":"家：卿大夫的封地。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10008-10"},{"blocks":[{"runs":[{"text":"乱物：纷乱之事。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10008-11"},{"blocks":[{"runs":[{"text":"具此：全都在这里。具，完备、齐全。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10008-12"},{"blocks":[{"runs":[{"text":"恶（wū）施：怎么实行。恶，相当于“何”“怎么”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10008-13"},{"blocks":[{"runs":[{"text":"亡：同“无”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10008-14"},{"blocks":[{"runs":[{"text":"有：同“又”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10008-15"},{"blocks":[{"runs":[{"text":"劝：鼓励。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10008-16"},{"blocks":[{"runs":[{"text":"交相：互相。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10008-17"},{"blocks":[{"runs":[{"text":"子墨子：墨子的弟子对墨子的尊称。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10008-18"}],"blocks":[{"runs":[{"text":"圣人以治天下为事","type":"text"},{"label":"[1]","noteId":"footnote-10008-1","type":"annotation-ref"},{"text":"者也，必知乱之所自起，","type":"text"},{"disposition":"system-browser","href":"https://www.zdic.net/hans/%E7%84%89","sourceUrl":"https://www.zdic.net/hans/%E7%84%89","text":"焉","type":"link"},{"label":"[2]","noteId":"footnote-10008-2","type":"annotation-ref"},{"text":"能治之；不知乱之所自起，则不能治。譬之如医之攻","type":"text"},{"label":"[3]","noteId":"footnote-10008-3","type":"annotation-ref"},{"text":"人之疾者然，必知疾之所自起，焉能攻之；不知疾之所自起，则弗能攻。治乱者何独不然？必知乱之所自起，焉能治之；不知乱之所自起，则弗能治。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"圣人以治天下为事者也，不可不察乱之所自起。当","type":"text"},{"label":"[4]","noteId":"footnote-10008-4","type":"annotation-ref"},{"text":"察乱何自起？起不相爱。臣子之不孝君父，所谓乱也。子自爱，不爱父，故亏","type":"text"},{"label":"[5]","noteId":"footnote-10008-5","type":"annotation-ref"},{"text":"父而自利；弟自爱，不爱兄，故亏兄而自利；臣自爱，不爱君，故亏君而自利。此所谓乱也。虽","type":"text"},{"label":"[6]","noteId":"footnote-10008-6","type":"annotation-ref"},{"text":"父之不慈","type":"text"},{"label":"[7]","noteId":"footnote-10008-7","type":"annotation-ref"},{"text":"子，兄之不慈弟，君之不慈臣，此亦天下之所谓乱也。父自爱也，不爱子，故亏子而自利；兄自爱也，不爱弟，故亏弟而自利；君自爱也，不爱臣，故亏臣而自利。是何也？皆起不相爱。虽至天下之为盗贼","type":"text"},{"label":"[8]","noteId":"footnote-10008-8","type":"annotation-ref"},{"text":"者，亦然。盗爱其室","type":"text"},{"label":"[9]","noteId":"footnote-10008-9","type":"annotation-ref"},{"text":"，不爱异室，故窃异室以利其室；贼爱其身，不爱人，故贼人以利其身。此何也？皆起不相爱。虽至大夫之相乱家","type":"text"},{"label":"[10]","noteId":"footnote-10008-10","type":"annotation-ref"},{"text":"、诸侯之相攻国者，亦然。大夫各爱其家，不爱异家，故乱异家以利其家；诸侯各爱其国，不爱异国，故攻异国以利其国。天下之乱物","type":"text"},{"label":"[11]","noteId":"footnote-10008-11","type":"annotation-ref"},{"text":"，具此","type":"text"},{"label":"[12]","noteId":"footnote-10008-12","type":"annotation-ref"},{"text":"而已矣。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"察此何自起？皆起不相爱。若使天下","type":"text"},{"disposition":"system-browser","href":"https://www.zdic.net/hans/%E5%85%BC","sourceUrl":"https://www.zdic.net/hans/%E5%85%BC","text":"兼","type":"link"},{"text":"相爱，爱人若爱其身，犹有不孝者乎？视父兄与君若其身，恶施","type":"text"},{"label":"[13]","noteId":"footnote-10008-13","type":"annotation-ref"},{"text":"不孝？犹有不慈者乎？视弟子与臣若其身，恶施不慈？故不孝不慈亡","type":"text"},{"label":"[14]","noteId":"footnote-10008-14","type":"annotation-ref"},{"text":"。犹有盗贼乎？视人之室若其室，谁窃？视人身若其身，谁贼？故盗贼有","type":"text"},{"label":"[15]","noteId":"footnote-10008-15","type":"annotation-ref"},{"text":"亡。犹有大夫之相乱家、诸侯之相攻国者乎？视人家若其家，谁乱？视人国若其国，谁攻？故大夫之相乱家、诸侯之相攻国者有亡。若使天下兼相爱，国与国不相攻，家与家不相乱，盗贼无有，君臣父子皆能孝慈，若此则天下治。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"故圣人以治天下为事者，恶得不禁恶而劝","type":"text"},{"label":"[16]","noteId":"footnote-10008-16","type":"annotation-ref"},{"text":"爱？故天下兼相爱则治，交相","type":"text"},{"label":"[17]","noteId":"footnote-10008-17","type":"annotation-ref"},{"text":"恶则乱。故子墨子","type":"text"},{"label":"[18]","noteId":"footnote-10008-18","type":"annotation-ref"},{"text":"曰不可以不劝爱人者，此也。","type":"text"}],"type":"paragraph"}],"frontMatter":[{"blocks":[{"runs":[{"text":"选自《墨子校注》（中华书局2006 年版）。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"墨子（约前468—前376），名翟（dí），春秋战国之际思想家，墨家学派创始人。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"《墨子》一书是墨子本人、墨子弟子以及后期墨家著述的汇编。《兼爱》有上、中、下三篇，这里选的是上篇。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"guidance":[],"links":[{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/cover3/xbs09/7-%e5%85%bc%e7%88%b1%e5%a2%a8%e5%ad%90","sourceUrl":"https://sites.google.com/view/pkuschool/cover3/xbs09/7-%e5%85%bc%e7%88%b1%e5%a2%a8%e5%ad%90","text":"https://sites.google.com/view/pkuschool/cover3/xbs09/7-%e5%85%bc%e7%88%b1%e5%a2%a8%e5%ad%90","title":null},{"disposition":"system-browser","href":"https://www.zdic.net/hans/%E5%85%BC","sourceUrl":"https://www.zdic.net/hans/%E5%85%BC","text":"兼","title":null},{"disposition":"system-browser","href":"https://www.zdic.net/hans/%E7%84%89","sourceUrl":"https://www.zdic.net/hans/%E7%84%89","text":"焉","title":null}],"media":[],"sourceOnlyBlocks":[],"sourcePostId":10008,"sourcePostNumber":1},"mediaReceiptLedgerSha256":"0319bd9f7623eb57ee396cafc0343cb6c4dc51dce258109a19edbdddd91be71c","mediaReceiptLedgerVersion":"2026-08-09.1","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10008-1","postId":10008,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10008-1","text":"[1]","title":null},{"disposition":"system-browser","href":"https://www.zdic.net/hans/%E7%84%89","postId":10008,"postNumber":1,"postRole":"primary","sourceUrl":"https://www.zdic.net/hans/%E7%84%89","text":"焉","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10008-2","postId":10008,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10008-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10008-3","postId":10008,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10008-3","text":"[3]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10008-4","postId":10008,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10008-4","text":"[4]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10008-5","postId":10008,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10008-5","text":"[5]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10008-6","postId":10008,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10008-6","text":"[6]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10008-7","postId":10008,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10008-7","text":"[7]","title":null