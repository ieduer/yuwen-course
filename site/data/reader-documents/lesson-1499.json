{"curationManifestSha256":"98e90b3603b34b437bc554810c21f01c4db44d10364211af114d30fde3d67bad","curationVersion":"2026-07-30.2","lessonId":"lesson-1499","main":{"annotations":[{"blocks":[{"runs":[{"text":"高堂：高大的厅堂。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10080-1"},{"blocks":[{"runs":[{"text":"得意：指有兴致。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10080-2"},{"blocks":[{"runs":[{"text":"会须：应当。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10080-3"},{"blocks":[{"runs":[{"text":"钟鼓馔玉：指击钟敲鼓，食用珍美的菜肴，代指富贵生活。馔玉，像玉一样珍美的食品。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10080-4"},{"blocks":[{"runs":[{"text":"愿：一作“复”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10080-5"},{"blocks":[{"runs":[{"text":"寂寞：指不为世所用，默默无闻。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10080-6"},{"blocks":[{"runs":[{"text":"陈王：指曹植，曾被封为陈王。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10080-7"},{"blocks":[{"runs":[{"text":"平乐：宫观名，故址在今河南洛阳附近。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10080-8"},{"blocks":[{"runs":[{"text":"斗酒十千：一斗酒值十千钱，指酒美而贵。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10080-9"},{"blocks":[{"runs":[{"text":"恣欢谑（xuè）：尽情地欢乐戏谑。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10080-10"},{"blocks":[{"runs":[{"text":"主人：指元丹丘。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10080-11"},{"blocks":[{"runs":[{"text":"径须沽取：毫不犹豫地买酒。径须，直须、应当。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10080-12"},{"blocks":[{"runs":[{"text":"五花马：一种名贵的马，毛色作五花（一说把马鬃修剪成五个花瓣）。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10080-13"},{"blocks":[{"runs":[{"text":"千金裘：珍贵的皮衣。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10080-14"},{"blocks":[{"runs":[{"text":"儿：指侍僮。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10080-15"},{"blocks":[{"runs":[{"text":"将出：牵出，拿出。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10080-16"},{"blocks":[{"runs":[{"text":"销：排遣。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10080-17"}],"blocks":[{"runs":[{"text":"君不见黄河之水天上来，奔流到海不复回。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"君不见高堂","type":"text"},{"label":"[1]","noteId":"footnote-10080-1","type":"annotation-ref"},{"text":"明镜悲白发，朝如青丝暮成雪。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"人生得意","type":"text"},{"label":"[2]","noteId":"footnote-10080-2","type":"annotation-ref"},{"text":"须尽欢，莫使金樽空对月。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"天生我材必有用，千金散尽还复来。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"烹羊宰牛且为乐，会须","type":"text"},{"label":"[3]","noteId":"footnote-10080-3","type":"annotation-ref"},{"text":"一饮三百杯。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"岑夫子，丹丘生，将进酒，杯莫停。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"与君歌一曲，请君为我倾耳听。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"钟鼓馔玉","type":"text"},{"label":"[4]","noteId":"footnote-10080-4","type":"annotation-ref"},{"text":"不足贵，但愿长醉不愿","type":"text"},{"label":"[5]","noteId":"footnote-10080-5","type":"annotation-ref"},{"text":"醒。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"古来圣贤皆寂寞","type":"text"},{"label":"[6]","noteId":"footnote-10080-6","type":"annotation-ref"},{"text":"，惟有饮者留其名。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"陈王","type":"text"},{"label":"[7]","noteId":"footnote-10080-7","type":"annotation-ref"},{"text":"昔时宴平乐","type":"text"},{"label":"[8]","noteId":"footnote-10080-8","type":"annotation-ref"},{"text":"，斗酒十千","type":"text"},{"label":"[9]","noteId":"footnote-10080-9","type":"annotation-ref"},{"text":"恣欢谑","type":"text"},{"label":"[10]","noteId":"footnote-10080-10","type":"annotation-ref"},{"text":"。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"主人","type":"text"},{"label":"[11]","noteId":"footnote-10080-11","type":"annotation-ref"},{"text":"何为言少钱，径须沽取","type":"text"},{"label":"[12]","noteId":"footnote-10080-12","type":"annotation-ref"},{"text":"对君酌。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"五花马","type":"text"},{"label":"[13]","noteId":"footnote-10080-13","type":"annotation-ref"},{"text":"、千金裘","type":"text"},{"label":"[14]","noteId":"footnote-10080-14","type":"annotation-ref"},{"text":"，呼儿","type":"text"},{"label":"[15]","noteId":"footnote-10080-15","type":"annotation-ref"},{"text":"将出","type":"text"},{"label":"[16]","noteId":"footnote-10080-16","type":"annotation-ref"},{"text":"换美酒，与尔同销","type":"text"},{"label":"[17]","noteId":"footnote-10080-17","type":"annotation-ref"},{"text":"万古愁。","type":"text"}],"type":"paragraph"},{"blocks":[{"runs":[{"text":"李白怀才不遇，与友人岑勋、元丹丘登高宴饮，借酒抒情，一泄其寂寞的愁怀，由此产生了《将进酒》这首诗。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"诗中所云“天生我材必有用，千金散尽还复来”，以及“古来圣贤皆寂寞，惟有饮者留其名”，表达了怀才不遇的郁愤，传达出舍我其谁的自信；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"而“人生得意须尽欢”“会须一饮三百杯”“但愿长醉不愿醒”等语句，淋漓尽致地展现了诗人于穷愁之境中的狂放不羁。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"黄河奔流入海的宏大空间，无疑也暗示了时光流逝；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"“古来圣贤皆寂寞”的感叹，更使诗人的郁愤、失意之情具有了典型意义。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"诵读时，要细心体会诗人豪迈激昂的笔调，感受他虽人生失意却依然潇洒自信的胸怀。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"以……意象，造……意境；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"以……直抒胸臆，展……心绪。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"frontMatter":[{"blocks":[{"runs":[{"text":"选自《李白集校注》卷三（上海古籍出版社1980 年版）。将qiānɡ进酒，汉乐府旧题。将，请。进酒，饮酒。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"此诗大约作于天宝十一载（752）。李白和友人岑勋在嵩山另一好友元丹丘的颍阳山居做客，三人登高欢饮。诗中的“岑夫子”即岑勋，“丹丘生”即元丹丘。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"guidance":[],"links":[{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/cover3/%e4%b8%ad%e5%9b%bd%e5%8f%a4%e5%85%b8%e8%af%97%e6%ad%8c%e7%9a%84%e6%84%8f%e8%b1%a1/%e5%b0%86%e8%bf%9b%e9%85%92%e6%9d%8e-%e7%99%bd","sourceUrl":"https://sites.google.com/view/pkuschool/cover3/%e4%b8%ad%e5%9b%bd%e5%8f%a4%e5%85%b8%e8%af%97%e6%ad%8c%e7%9a%84%e6%84%8f%e8%b1%a1/%e5%b0%86%e8%bf%9b%e9%85%92%e6%9d%8e-%e7%99%bd","text":"https://sites.google.com/view/pkuschool/cover3/%e4%b8%ad%e5%9b%bd%e5%8f%a4%e5%85%b8%e8%af%97%e6%ad%8c%e7%9a%84%e6%84%8f%e8%b1%a1/%e5%b0%86%e8%bf%9b%e9%85%92%e6%9d%8e-%e7%99%bd","title":null}],"media":[],"sourceOnlyBlocks":[],"sourcePostId":10080,"sourcePostNumber":1},"mediaReceiptLedgerSha256":"5487243dd8d14d65dfadc20ed544a999aaa318fc20c291462ea62c69e1eff320","mediaReceiptLedgerVersion":"2026-07-30.2","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10080-1","postId":10080,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10080-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10080-2","postId":10080,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10080-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10080-3","postId":10080,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10080-3","text":"[3]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10080-4","postId":10080,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10080-4","text":"[4]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10080-5","postId":10080,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10080-5","text":"[5]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10080-6","postId":10080,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10080-6","text":"[6]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10080-7","postId":10080,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10080-7","text":"[7]","title":null},{"disposition":"interna