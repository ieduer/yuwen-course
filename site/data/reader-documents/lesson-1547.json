{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1547","main":{"annotations":[{"blocks":[{"runs":[{"text":"公元738年","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-1"},{"blocks":[{"runs":[{"text":"主将。指辅国大将军、右羽林大将军兼御史大夫张守珪","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-2"},{"blocks":[{"runs":[{"text":"和（hè）按照别人诗词的题材和体裁作诗词，作为酬答","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-3"},{"blocks":[{"runs":[{"text":"唐人写时事，常托之于汉代。下文“汉将”，用法与此相类","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-4"},{"blocks":[{"runs":[{"text":"烽烟和尘土，指战乱","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-5"},{"blocks":[{"runs":[{"text":"指残忍暴虐的敌寇","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-6"},{"blocks":[{"runs":[{"text":"男子汉本来就重视在战场上纵横驰骋","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-7"},{"blocks":[{"runs":[{"text":"指给予褒奖恩宠","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-8"},{"blocks":[{"runs":[{"text":"𪭢chuānɡ 指击打钲、铙之类的金属乐器和鼓，作为行军指挥信号。金，指军中作信号用的钲、铙等金属乐器。伐，敲击","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-9"},{"blocks":[{"runs":[{"text":"古关名，即今山海关（在今河北秦皇岛）","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-10"},{"blocks":[{"runs":[{"text":"旌旆（pèi）旗帜","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-11"},{"blocks":[{"runs":[{"text":"舒展的样子","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-12"},{"blocks":[{"runs":[{"text":"山名，在今河北昌黎西北","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-13"},{"blocks":[{"runs":[{"text":"武官名，泛指统帅","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-14"},{"blocks":[{"runs":[{"text":"即羽檄，古代军事文书，插鸟羽以示紧急，必须迅速传递","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-15"},{"blocks":[{"runs":[{"text":"唐代对蒙古高原大沙漠以北及其迤西今准噶尔盆地一带广大地区的泛称","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-16"},{"blocks":[{"runs":[{"text":"打猎时焚山驱兽之火，借指游牧民族兴兵打仗的战火","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-17"},{"blocks":[{"runs":[{"text":"古代称狼山者不止一处，这里借指边地交战区域的山","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-18"},{"blocks":[{"runs":[{"text":"即边地，靠近边境的地域","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-19"},{"blocks":[{"runs":[{"text":"指敌人侵犯，来势凶猛如同风雨交加。胡骑，这里指契丹人、奚人的军队。凭陵，逼压","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-20"},{"blocks":[{"runs":[{"text":"战场","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-21"},{"blocks":[{"runs":[{"text":"死生各半，指伤亡惨重","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-22"},{"blocks":[{"runs":[{"text":"指统帅的营帐中","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-23"},{"blocks":[{"runs":[{"text":"晚秋，深秋","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-24"},{"blocks":[{"runs":[{"text":"〔腓（féi）枯萎","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-25"},{"blocks":[{"runs":[{"text":"承受","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-26"},{"blocks":[{"runs":[{"text":"天子的知遇之恩","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-27"},{"blocks":[{"runs":[{"text":"用铁片制作的战衣，借指战士","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-28"},{"blocks":[{"runs":[{"text":"玉制筷子，比喻思妇的眼泪","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-29"},{"blocks":[{"runs":[{"text":"蓟州（今属天津）以北地区","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-30"},{"blocks":[{"runs":[{"text":"边地动荡不安，难以越过。飘飖 yáo，随风飘动，形容动荡不安。那可，即“哪可”","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-31"},{"blocks":[{"runs":[{"text":"极远的地方","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-32"},{"blocks":[{"runs":[{"text":"早、午、晚","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-33"},{"blocks":[{"runs":[{"text":"浓重堆积似战阵的云层","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-34"},{"blocks":[{"runs":[{"text":"凄凉的声音","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-35"},{"blocks":[{"runs":[{"text":"三足长柄的锅，古代军中兼用于炊煮和巡更敲击的铜制用具","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-36"},{"blocks":[{"runs":[{"text":"意思是，历来志士为（保卫国家的）气节献身，难道是为了个人的功勋！","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-37"},{"blocks":[{"runs":[{"text":"这句是感慨当时没有李将军那样的守边将帅。李将军，指西汉名将李广。李广任右北平（辖今河北承德及天津蓟州区以东地区）太守，捍御匈奴，关爱士卒，匈奴称其为“汉之飞将军”，数岁不敢进犯。一说指战国时赵将李牧。李牧对抗匈奴，厚待战士，曾破匈奴十余万骑，使匈奴十余年不敢靠近赵国边境","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10353-38"}],"blocks":[{"runs":[{"text":"开元二十六年","type":"text"},{"label":"[1]","noteId":"footnote-10353-1","type":"annotation-ref"},{"text":"，客有从元戎","type":"text"},{"label":"[2]","noteId":"footnote-10353-2","type":"annotation-ref"},{"text":"出塞而还者，作《燕歌行》以示，适感征戍之事，因而和","type":"text"},{"label":"[3]","noteId":"footnote-10353-3","type":"annotation-ref"},{"text":"焉。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"汉家","type":"text"},{"label":"[4]","noteId":"footnote-10353-4","type":"annotation-ref"},{"text":"烟尘","type":"text"},{"label":"[5]","noteId":"footnote-10353-5","type":"annotation-ref"},{"text":"在东北，汉将辞家破残贼","type":"text"},{"label":"[6]","noteId":"footnote-10353-6","type":"annotation-ref"},{"text":"。\n\n男儿本自重横行","type":"text"},{"label":"[7]","noteId":"footnote-10353-7","type":"annotation-ref"},{"text":"，天子非常赐颜色","type":"text"},{"label":"[8]","noteId":"footnote-10353-8","type":"annotation-ref"},{"text":"。\n\n𪭢金伐鼓","type":"text"},{"label":"[9]","noteId":"footnote-10353-9","type":"annotation-ref"},{"text":"下榆关","type":"text"},{"label":"[10]","noteId":"footnote-10353-10","type":"annotation-ref"},{"text":"，旌旆","type":"text"},{"label":"[11]","noteId":"footnote-10353-11","type":"annotation-ref"},{"text":"逶迤","type":"text"},{"label":"[12]","noteId":"footnote-10353-12","type":"annotation-ref"},{"text":"碣石","type":"text"},{"label":"[13]","noteId":"footnote-10353-13","type":"annotation-ref"},{"text":"间。\n\n校尉","type":"text"},{"label":"[14]","noteId":"footnote-10353-14","type":"annotation-ref"},{"text":"羽书","type":"text"},{"label":"[15]","noteId":"footnote-10353-15","type":"annotation-ref"},{"text":"飞瀚海","type":"text"},{"label":"[16]","noteId":"footnote-10353-16","type":"annotation-ref"},{"text":"，单于猎火","type":"text"},{"label":"[17]","noteId":"footnote-10353-17","type":"annotation-ref"},{"text":"照狼山","type":"text"},{"label":"[18]","noteId":"footnote-10353-18","type":"annotation-ref"},{"text":"。\n\n山川萧条极边土","type":"text"},{"label":"[19]","noteId":"footnote-10353-19","type":"annotation-ref"},{"text":"，胡骑凭陵杂风雨","type":"text"},{"label":"[20]","noteId":"footnote-10353-20","type":"annotation-ref"},{"text":"。\n\n战士军前","type":"text"},{"label":"[21]","noteId":"footnote-10353-21","type":"annotation-ref"},{"text":"半死生","type":"text"},{"label":"[22]","noteId":"footnote-10353-22","type":"annotation-ref"},{"text":"，美人帐下","type":"text"},{"label":"[23]","noteId":"footnote-10353-23","type":"annotation-ref"},{"text":"犹歌舞。\n\n大漠穷秋","type":"text"},{"label":"[24]","noteId":"footnote-10353-24","type":"annotation-ref"},{"text":"塞草腓","type":"text"},{"label":"[25]","noteId":"footnote-10353-25","type":"annotation-ref"},{"text":"，孤城落日斗兵稀。\n\n身当","type":"text"},{"label":"[26]","noteId":"footnote-10353-26","type":"annotation-ref"},{"text":"恩遇","type":"text"},{"label":"[27]","noteId":"footnote-10353-27","type":"annotation-ref"},{"text":"常轻敌，力尽关山未解围。\n\n铁衣","type":"text"},{"label":"[28]","noteId":"footnote-10353-28","type":"annotation-ref"},{"text":"远戍辛勤久，玉箸","type":"text"},{"label":"[29]","noteId":"footnote-10353-29","type":"annotation-ref"},{"text":"应啼别离后。\n\n少妇城南欲断肠，征人蓟北","type":"text"},{"label":"[30]","noteId":"footnote-10353-30","type":"annotation-ref"},{"text":"空回首。\n\n边庭飘飖那可度","type":"text"},{"label":"[31]","noteId":"footnote-10353-31","type":"annotation-ref"},{"text":"，绝域","type":"text"},{"label":"[32]","noteId":"footnote-10353-32","type":"annotation-ref"},{"text":"苍茫无所有。\n\n杀气三时","type":"text"},{"label":"[33]","noteId":"footnote-10353-33","type":"annotation-ref"},{"text":"作阵云","type":"text"},{"label":"[34]","noteId":"footnote-10353-34","type":"annotation-ref"},{"text":"，寒声","type":"text"},{"label":"[35]","noteId":"footnote-10353-35","type":"annotation-ref"},{"text":"一夜传刁斗","type":"text"},{"label":"[36]","noteId":"footnote-10353-36","type":"annotation-ref"},{"text":"。\n\n相看白刃血纷纷，死节从来岂顾勋","type":"text"},{"label":"[37]","noteId":"footnote-10353-37","type":"annotation-ref"},{"text":"！\n\n君不见沙场征战苦，至今犹忆李将军","type":"text"},{"label":"[38]","noteId":"footnote-10353-38","type":"annotation-ref"},{"text":"。","type":"text"}],"type":"paragraph"},{"blocks":[{"runs":[{"text":"大漠深秋，","type":"text"},{"disposition":"system-browser","href":"https://www.zdic.net/hans/%E9%92%B2","sourceUrl":"https://www.zdic.net/hans/%E9%92%B2","text":"钲","type":"link"},{"text":"鼓声声，旌旗逶迤，羽檄飞大漠，战火照狼山，山川萧条，孤城落日，寒夜巡更的刁斗，鲜血染红的白刃……出师、失利、被围、死斗，《燕歌行》写了这样一场边关战事。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"气势雄浑悲壮，惊天动地。战士拼死力战，将军轻敌骄逸，对比鲜明，力透纸背。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"诗歌接着又写后方思妇断肠，征人回首，遍地动荡，绝域苍茫，呈现出宏阔视野，体现了强烈的现实批判意义。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"此诗格调雄健激越，慷慨悲壮，节奏起伏跌宕，张弛有度，诵读时须细加体会。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"frontMatter":[{"blocks":[{"runs":[{"text":"选自《高适集校注》（上海古籍出版社1984 年版）。燕歌行，乐府旧题。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"高适（约700—765），字达夫，一字仲武，河北蓨（tiáo）县（今河北景县南）人，唐代诗人。他与岑参的边塞诗代表了唐代边塞诗的最高成就。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"guidance":[],"links":[{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/xbz000/%e5%8f%a4%e8%af%97%e8%af%8d%e8%af%b5%e8%af%bb/%e7%87%95%e6%ad%8c%e8%a1%8c%e5%b9%b6%e5%ba%8f-%e9%ab%98%e9%80%82","sourceUrl":"https://sites.google.com/view/pkuschool/xbz000/%e5%8f%a4%e8%af%97%e8%af%8d%e8%af%b5%e8%af%bb/%e7%87%95%e6%ad%8c%e8%a1%8c%e5%b9%b6%e5%ba%8f-%e9%ab%98%e9%80%82","text":"https://sites.google.com/view/pkuschool/xbz000/%e5%8f%a4%e8%af%97%e8%af%8d%e8%af%b5%e8%af%bb/%e7%87%95%e6%ad%8c%e8%a1%8c%e5%b9%b6%e5%ba%8f-%e9%ab%98%e9%80%82","title":null},{"disposition":"system-browser","href":"https://www.zdic.net/hans/%E9%92%B2","sourceUrl":"https://www.zdic.net/hans/%E9%92%B2","text":"钲","title":null}],"media":[],"sourceOnlyBlocks":[],"sourcePostId":10353,"sourcePostNumber":1},"mediaReceiptLedgerSha256":"0319bd9f7623eb57ee396cafc0343cb6c4dc51dce258109a19edbdddd91be71c","mediaReceiptLedgerVersion":"2026-08-09.1","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10353-1","postId":10353,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10353-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10353-2","postId":10353,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10353-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10353-3","postId":10353,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10353-3","text":"[3]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10353-4","postId":10353,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10353-4","text":"[4]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10353-5","postId":10353,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10353-5","text":"[5]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10353-6","postId":10353,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10353-6","text":"[6]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10353-7","postId":10353,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10353-7","text"