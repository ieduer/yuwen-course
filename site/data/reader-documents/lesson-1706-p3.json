{"curationManifestSha256":"98e90b3603b34b437bc554810c21f01c4db44d10364211af114d30fde3d67bad","curationVersion":"2026-07-30.2","lessonId":"lesson-1706-p3","main":{"annotations":[{"blocks":[{"runs":[{"text":"选自《李清照集校注》卷一（人民文学出版社1979年版）。声声慢，词牌名。北宋末年李清照南渡避乱，不久北宋灭亡，丈夫病死，她只身逃难，境遇悲惨。这首词是作者南渡后晚年的作品。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-24"},{"blocks":[{"runs":[{"text":"〔戚戚〕悲愁、哀伤的样子。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-25"},{"blocks":[{"runs":[{"text":"〔乍暖还（huán）寒〕忽暖忽冷，天气变化无常。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-26"},{"blocks":[{"runs":[{"text":"〔将息〕养息，休息。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-27"},{"blocks":[{"runs":[{"text":"〔黄花〕菊花。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-28"},{"blocks":[{"runs":[{"text":"〔憔悴损〕枯萎，凋零殆尽。憔悴，凋零、枯萎。损，这里相当于〔极〕，表示程度很深。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-29"},{"blocks":[{"runs":[{"text":"〔堪〕可以，能够。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-30"},{"blocks":[{"runs":[{"text":"〔怎生得黑〕怎样挨到天黑。怎生，怎么、怎样。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-31"},{"blocks":[{"runs":[{"text":"〔次第〕光景，状况。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-32"},{"blocks":[{"runs":[{"text":"〔怎一个愁字了得〕意思是，一个“愁”字怎么能概括得尽呢？","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-33"}],"blocks":[{"runs":[{"text":"声声慢","type":"text"},{"label":"[1]","noteId":"footnote-11138-24","type":"annotation-ref"},{"text":"\n\n李清照\n\n寻寻觅觅，冷冷清清，凄凄惨惨戚戚","type":"text"},{"label":"[2]","noteId":"footnote-11138-25","type":"annotation-ref"},{"text":"。乍暖还寒","type":"text"},{"label":"[3]","noteId":"footnote-11138-26","type":"annotation-ref"},{"text":"时候，最难将息","type":"text"},{"label":"[4]","noteId":"footnote-11138-27","type":"annotation-ref"},{"text":"。三杯两盏淡酒，怎敌他、晚来风急！雁过也，正伤心，却是旧时相识。\n\n满地黄花","type":"text"},{"label":"[5]","noteId":"footnote-11138-28","type":"annotation-ref"},{"text":"堆积，憔悴损","type":"text"},{"label":"[6]","noteId":"footnote-11138-29","type":"annotation-ref"},{"text":"，如今有谁堪","type":"text"},{"label":"[7]","noteId":"footnote-11138-30","type":"annotation-ref"},{"text":"摘？守着窗儿，独自怎生得黑","type":"text"},{"label":"[8]","noteId":"footnote-11138-31","type":"annotation-ref"},{"text":"！梧桐更兼细雨，到黄昏、点点滴滴。这次第","type":"text"},{"label":"[9]","noteId":"footnote-11138-32","type":"annotation-ref"},{"text":"，怎一个愁字了得","type":"text"},{"label":"[10]","noteId":"footnote-11138-33","type":"annotation-ref"},{"text":"！","type":"text"}],"type":"paragraph"}],"frontMatter":[],"guidance":[],"links":[],"media":[],"sourceOnlyBlocks":[],"sourcePostId":"11138-3","sourcePostNumber":1},"mediaReceiptLedgerSha256":"5487243dd8d14d65dfadc20ed544a999aaa318fc20c291462ea62c69e1eff320","mediaReceiptLedgerVersion":"2026-07-30.2","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11138-1","postId":"11138-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11138-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11138-2","postId":"11138-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11138-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11138-3","postId":"11138-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11138-3","text":"[3]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11138-4","postId":"11138-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11138-4","text":"[4]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11138-5","postId":"11138-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11138-5","text":"[5]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-111