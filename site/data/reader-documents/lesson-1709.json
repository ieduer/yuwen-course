e7951897254fd9fffd62cd1","sourceUrl":"https://files.rdfzer.com/original/2X/4/41c2e301ac58a87db955a0f9c48ac445d1d23648.png","webDisposition":"source-url","width":1044}],"posts":[{"cookedSha256":"cf8e3ecf1026e4691b0203b0e7e7aeda2296746a18164fb7026f7bcfc59d6132","createdAt":"2024-08-21T12:17:03Z","plainTextSha256":"ba5080230761a721f981f12403c6a2c1869196fbced2d67c2df1631cca926d36","postId":11141,"postNumber":1,"replyToPostNumber":null,"role":"primary","updatedAt":"2024-08-21T12:17:03Z"},{"cookedSha256":"28dc5b89071cbc0284ff9531959b31312dc76b61b38ee847597bac92f85ff6f2","createdAt":"2024-10-17T03:32:44Z","plainTextSha256":"edef718eb81a8b4cf9a2df85ed65fefb61d899c5d1d515325631c749c7a457e4","postId":18339,"postNumber":2,"replyToPostNumber":null,"role":"resource-only","updatedAt":"2024-10-17T03:32:44Z"}],"roleAuditDecisions":[],"sourceLessonPath":"data/lessons/lesson-1709.json","sourceLessonUpdatedAt":"2024-10-17T03:32:45Z","sourcePostCount":2},"resources":[{"disposition":"internal","href":"https://forum.rdfzer.com/uploads/short-url/2RkXOrtfygIYIhPdQfyVyuy5MzR.pdf","kind":"link","label":"乡土中国.pdf","postId":18339,"postNumber":null,"sourceUrl":"https://forum.rdfzer.com/uploads/short-url/2RkXOrtfygIYIhPdQfyVyuy5MzR.pdf"}],"roleAuditSha256":"65654ae8bd58de3c8040438da7fc213c00b7175d6dc82802a995f46c4cdfd4a7","roleAuditVersion":"2026-07-30.2","schemaVersion":"yw-reader-document-v1","supplementary":[],"title":"第五单元 整本书阅读"}
