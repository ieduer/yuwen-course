{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1704-p2","main":{"annotations":[{"blocks":[{"runs":[{"text":"适应世俗。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-16"},{"blocks":[{"runs":[{"text":"气质，情致。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-17"},{"blocks":[{"runs":[{"text":"指山林。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-18"},{"blocks":[{"runs":[{"text":"指世俗的种种束缚。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-19"},{"blocks":[{"runs":[{"text":"陶渊明大约二十五岁离开少时居所， 直到五十五岁辞去彭泽令方归，所以说“一去三十 年”。或疑当作“十三年”。自开始做官至辞去彭泽 令，前后为十三年。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-20"},{"blocks":[{"runs":[{"text":"被关在笼中的鸟。羁，约束。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-21"},{"blocks":[{"runs":[{"text":"南面的田野。一作“南亩”，指农田。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-22"},{"blocks":[{"runs":[{"text":"持守愚拙的本性，即不学巧伪，不争名利。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-23"},{"blocks":[{"runs":[{"text":"宅子四周有十几亩地。方，四周围绕。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-24"},{"blocks":[{"runs":[{"text":"迷蒙隐约的样子。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-25"},{"blocks":[{"runs":[{"text":"隐约的样子。一说“轻柔的样子”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-26"},{"blocks":[{"runs":[{"text":"指村落。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-27"},{"blocks":[{"runs":[{"text":"顶端。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-28"},{"blocks":[{"runs":[{"text":"门户庭院。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-29"},{"blocks":[{"runs":[{"text":"指世俗的繁杂琐事。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-30"},{"blocks":[{"runs":[{"text":"静室。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-31"},{"blocks":[{"runs":[{"text":"余暇，空闲。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-32"},{"blocks":[{"runs":[{"text":"关鸟兽的笼子。这里指束缚本性的俗世。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-33"}],"blocks":[{"runs":[{"text":"归园田居（其一）\n\n陶渊明\n\n少无适俗","type":"text"},{"label":"[1]","noteId":"footnote-11136-16","type":"annotation-ref"},{"text":"韵","type":"text"},{"label":"[2]","noteId":"footnote-11136-17","type":"annotation-ref"},{"text":"，性本爱丘山","type":"text"},{"label":"[3]","noteId":"footnote-11136-18","type":"annotation-ref"},{"text":"。\n\n误落尘网","type":"text"},{"label":"[4]","noteId":"footnote-11136-19","type":"annotation-ref"},{"text":"中，一去三十年","type":"text"},{"label":"[5]","noteId":"footnote-11136-20","type":"annotation-ref"},{"text":"。\n\n羁鸟","type":"text"},{"label":"[6]","noteId":"footnote-11136-21","type":"annotation-ref"},{"text":"恋旧林，池鱼思故渊。\n\n开荒南野","type":"text"},{"label":"[7]","noteId":"footnote-11136-22","type":"annotation-ref"},{"text":"际，守拙","type":"text"},{"label":"[8]","noteId":"footnote-11136-23","type":"annotation-ref"},{"text":"归园田。\n\n方宅十余亩","type":"text"},{"label":"[9]","noteId":"footnote-11136-24","type":"annotation-ref"},{"text":"，草屋八九间。\n\n榆柳荫后檐，桃李罗堂前。\n\n暧暧","type":"text"},{"label":"[10]","noteId":"footnote-11136-25","type":"annotation-ref"},{"text":"远人村，依依","type":"text"},{"label":"[11]","noteId":"footnote-11136-26","type":"annotation-ref"},{"text":"墟里","type":"text"},{"label":"[12]","noteId":"footnote-11136-27","type":"annotation-ref"},{"text":"烟。\n\n狗吠深巷中，鸡鸣桑树颠","type":"text"},{"label":"[13]","noteId":"footnote-11136-28","type":"annotation-ref"},{"text":"。\n\n户庭","type":"text"},{"label":"[14]","noteId":"footnote-11136-29","type":"annotation-ref"},{"text":"无尘杂","type":"text"},{"label":"[15]","noteId":"footnote-11136-30","type":"annotation-ref"},{"text":"，虚室","type":"text"},{"label":"[16]","noteId":"footnote-11136-31","type":"annotation-ref"},{"text":"有余闲","type":"text"},{"label":"[17]","noteId":"footnote-11136-32","type":"annotation-ref"},{"text":"。\n\n久在樊笼","type":"text"},{"label":"[18]","noteId":"footnote-11136-33","type":"annotation-ref"},{"text":"里，复得返自然。","type":"text"}],"type":"paragraph"}],"frontMatter":[],"guidance":[],"links":[],"media":[],"sourceOnlyBlocks":[],"sourcePostId":"11136-2","sourcePostNumber":1},"mediaReceiptLedgerSha256":"0319bd9f7623eb57ee396cafc0343cb6c4dc51dce258109a19edbdddd91be71c","mediaReceiptLedgerVersion":"2026-08-09.1","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11136-1","postId":"11136-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11136-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11136-2","postId":"11136-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11136-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11136-3","postId":"11136-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11136-3","text":"[3]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11136-4","postId":"11136-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11136-4","text":"[4]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11136-5","postId":"11136-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11136-5","text":"[5]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11136-6","postId":"11136-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11136-6","text":"[6]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11136-7","postId":"11136-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11136-7","text":"[7]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#f