tSha256":"955b06b47c4b7bc51b7c4bde801b9487ab046411bb71ddad002f3f02f3f36fc3","postId":53572,"postNumber":6,"replyToPostNumber":null,"role":"resource-only","updatedAt":"2025-04-10T08:44:51Z"}],"roleAuditDecisions":[],"sourceLessonPath":"data/lessons/lesson-1530.json","sourceLessonUpdatedAt":"2025-04-10T08:44:51Z","sourcePostCount":4},"resources":[{"disposition":"internal","href":"https://forum.rdfzer.com/uploads/short-url/fRA8ru3aWpX2MVviKu1thu3PAsI.pdf","kind":"link","label":"赵树理文集(全四册) (赵树理).pdf","postId":53572,"postNumber":null,"sourceUrl":"https://forum.rdfzer.com/uploads/short-url/fRA8ru3aWpX2MVviKu1thu3PAsI.pdf"},{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/xbz000/%e7%ac%ac%e4%ba%8c%e5%8d%95%e5%85%83/%e5%b0%8f%e4%ba%8c%e9%bb%91%e7%bb%93%e5%a9%9a%e8%8a%82%e9%80%89-%e8%b5%b5%e6%a0%91%e7%90%86","kind":"link","label":"https://sites.google.com/view/pkuschool/xbz000/%e7%ac%ac%e4%ba%8c%e5%8d%95%e5%85%83/%e5%b0%8f%e4%ba%8c%e9%bb%91%e7%bb%93%e5%a9%9a%e8%8a%82%e9%80%89-%e8%b5%b5%e6","postId":null,"postNumber":1,"sourceUrl":"https://sites.google.com/view/pkuschool/xbz000/%e7%ac%ac%e4%ba%8c%e5%8d%95%e5%85%83/%e5%b0%8f%e4%ba%8c%e9%bb%91%e7%bb%93%e5%a9%9a%e8%8a%82%e9%80%89-%e8%b5%b5%e6%a0%91%e7%90%86"}],"roleAuditSha256":"65654ae8bd58de3c8040438da7fc213c00b7175d6dc82802a995f46c4cdfd4a7","roleAuditVersion":"2026-07-30.2","schemaVersion":"yw-reader-document-v1","supplementary":[],"title":"* 小二黑结婚(节选)/ 赵树理"}
