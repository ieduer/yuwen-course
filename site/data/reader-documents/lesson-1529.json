"title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/uploads/short-url/kKDytAUIacaV82Ma4NLXLsGwTmp.pdf","postId":52553,"postNumber":5,"postRole":"resource-only","sourceUrl":"https://forum.rdfzer.com/uploads/short-url/kKDytAUIacaV82Ma4NLXLsGwTmp.pdf","text":"hhd1.pdf","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/uploads/short-url/kxkq78eQceqWcDKCa3Ai0FX5Hs3.pdf","postId":52553,"postNumber":5,"postRole":"resource-only","sourceUrl":"https://forum.rdfzer.com/uploads/short-url/kxkq78eQceqWcDKCa3Ai0FX5Hs3.pdf","text":"hhd2.pdf","title":null},{"disposition":"system-browser","href":"https://files.rdfzer.com/original/2X/9/9e1d2b40f3198f639bbf30af490687394bebbd4b.png","postId":53806,"postNumber":7,"postRole":"discussion","sourceUrl":"https://files.rdfzer.com/original/2X/9/9e1d2b40f3198f639bbf30af490687394bebbd4b.png","text":"https://files.rdfzer.com/original/2X/9/9e1d2b40f3198f639bbf30af490687394bebbd4b.png","title":null},{"disposition":"system-browser","href":"https://files.rdfzer.com/original/2X/8/8987df376f12fd973caf101b9b32d621baf63f28.png","postId":53806,"postNumber":7,"postRole":"discussion","sourceUrl":"https://files.rdfzer.com/original/2X/8/8987df376f12fd973caf101b9b32d621baf63f28.png","text":"https://files.rdfzer.com/original/2X/8/8987df376f12fd973caf101b9b32d621baf63f28.png","title":null},{"disposition":"system-browser","href":"https://files.rdfzer.com/original/2X/9/92ede5fb190e4d140a87c8965391162aeab60032.png","postId":53806,"postNumber":7,"postRole":"discussion","sourceUrl":"https://files.rdfzer.com/original/2X/9/92ede5fb190e4d140a87c8965391162aeab60032.png","text":"This is a 2025 postgraduate entrance examination paper for Contemporary Chinese Literature (subject 642) from Peking University's Chinese Language and Literature department.","title":"This is a 2025 postgraduate entrance examination paper for Contemporary Chinese Literature (subject 642) from Peking University's Chinese Language and Literature department.