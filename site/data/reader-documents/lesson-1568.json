{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1568","main":{"annotations":[],"blocks":[{"runs":[{"text":"轻轻的我走了，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"正如我轻轻的来；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我轻轻的招手，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"作别西天的云彩。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"那河畔的金柳，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"是夕阳中的新娘；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"波光里的艳影，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在我的心头荡漾。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"软泥上的青荇①，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"油油的在水底招摇:","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在康河的柔波里，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我甘心做一条水草!","type":"text"}],"type":"paragraph"},{"runs":[{"text":"那榆荫下的一潭，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"不是清泉，是天上虹","type":"text"}],"type":"paragraph"},{"runs":[{"text":"揉碎在浮藻间，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"沉淀着彩虹似的梦。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"寻梦？撑一支长篙，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"向青草更青处漫溯,","type":"text"}],"type":"paragraph"},{"runs":[{"text":"满载一船星辉，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在星辉斑斓里放歌。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"但我不能放歌，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"悄悄是别离的笙箫；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"夏虫也为我沉默，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"沉默是今晚的康桥!","type":"text"}],"type":"paragraph"},{"runs":[{"text":"悄悄的我走了，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"正如我悄悄的来；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我挥一挥衣袖，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"不带走一片云彩。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"十一月六日，中国海上","type":"text"}],"type":"paragraph"},{"runs":[{"text":"①〔荇（xìng）〕多年生草本植物，叶子略呈圆形，根生在水底。","type":"text"}],"type":"paragraph"},{"blocks":[{"runs":[{"text":"艾青追求诗的散文化，把现代自由体诗推向新的历史高度；以徐志摩为代表的新月派借鉴西方诗歌形式，融入中国传统格律，进行了新诗格律化的尝试。不同流派、不同风格，相互竞争，共同发展，推动了新诗的繁荣。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"《 大堰河——我的保姆》是诗人写于狱中的成名作，是献给他心目中的母亲——中国大地上勤劳善良而又命运悲苦的普通农妇的颂歌。诗中朴实真挚而强烈的感情，自有一种动人的力量。除了直接抒情，诗中还有许多叙述和描写，学习时注意体会其对情感抒发的作用。有感情地朗诵这首诗，感受现代自由体诗的特点，体会大堰河这一形象的意义。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"《 再别康桥》是一首抒情诗，表达了作者对康桥依依惜别的深情。从形式上来说，这首诗充分体现了新月派“三美”的主张，即音乐美、绘画美和建筑美。学习时要通过反复朗诵，体会诗的节奏韵律，感受诗句的美，看看诗人的感情与诗歌的形式是如何完美融为一体的。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"可以通过比较阅读的方式，体会这两首诗艺术风格的差异，并结合相关资料，了解中国新诗不同流派的特点。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"frontMatter":[{"blocks":[{"runs":[{"text":"选自《徐志摩诗全编》（浙江文艺出版社1987 年版）。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"徐志摩（1897—1931），浙江海宁人，诗人、散文家。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"康桥，现在译作“剑桥”，是英国剑桥大学所在地，徐志摩曾在剑桥大学留学。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"guidance":[],"links":[{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%ba%8c%e5%8d%95%e5%85%83/%e5%86%8d%e5%88%ab%e5%ba%b7%e6%a1%a5-%e5%be%90%e5%bf%97%e6%91%a9","sourceUrl":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%ba%8c%e5%8d%95%e5%85%83/%e5%86%8d%e5%88%ab%e5%ba%b7%e6%a1%a5-%e5%be%90%e5%bf%97%e6%91%a9","text":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%ba%8c%e5%8d%95%e5%85%83/%e5%86%8d%e5%88%ab%e5%ba%b7%e6%a1%a5-%e5%be%90%e5%bf%97%e6%91%a9","title":null}],"media":[],"sourceOnlyBlocks":[],"sourcePostId":10472,"sourcePostNumber":1},"mediaReceiptLedgerSha256":"0319bd9f7623eb57ee396cafc0343cb6c4dc51dce258109a19edbdddd91be71c","mediaReceiptLedgerVersion":"2026-08-09.1","provenance":{"links":[{"disposition":"system-browser","href":"https://