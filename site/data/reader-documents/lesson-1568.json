zer.com/original/2X/3/30874cc1ced0fcddc265e71141a58051a8cd5720.jpeg","kind":"link","label":"IMG_22","postId":51982,"postNumber":null,"sourceUrl":"https://files.rdfzer.com/original/2X/3/30874cc1ced0fcddc265e71141a58051a8cd5720.jpeg"},{"disposition":"internal","href":"https://forum.rdfzer.com/uploads/short-url/694LktotGSV9SHXi1P98pSvXL5f.pdf","kind":"document","label":"徐志摩诗_11137580.pdf","postId":null,"postNumber":7,"sourceUrl":"https://forum.rdfzer.com/uploads/short-url/694LktotGSV9SHXi1P98pSvXL5f.pdf"},{"disposition":"internal","href":"https://forum.rdfzer.com/uploads/short-url/scityCQ2Z8FgL2wp1dEn9RnippL.pdf","kind":"document","label":"新月集 飞鸟集.81130041_92.pdf","postId":null,"postNumber":7,"sourceUrl":"https://forum.rdfzer.com/uploads/short-url/scityCQ2Z8FgL2wp1dEn9RnippL.pdf"},{"disposition":"internal","href":"https://forum.rdfzer.com/uploads/short-url/wDlxxvYRomOEo8BDgSjrRjWwYVG.pdf","kind":"document","label":"23新月诗选 陈梦家编 解放军文艺出版社 2000年7.pdf","postId":null,"postNumber":7,"sourceUrl":"https://forum.rdfzer.com/uploads/short-url/wDlxxvYRomOEo8BDgSjrRjWwYVG.pdf"},{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%ba%8c%e5%8d%95%e5%85%83/%e5%86%8d%e5%88%ab%e5%ba%b7%e6%a1%a5-%e5%be%90%e5%bf%97%e6%91%a9","kind":"link","label":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%ba%8c%e5%8d%95%e5%85%83/%e5%86%8d%e5%88%ab%e5%ba%b7%e6%a1%a5-%e5%be%90%e5%bf%97","postId":null,"postNumber":1,"sourceUrl":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%ba%8c%e5%8d%95%e5%85%83/%e5%86%8d%e5%88%ab%e5%ba%b7%e6%a1%a5-%e5%be%90%e5%bf%97%e6%91%a9"}],"roleAuditSha256":"65654ae8bd58de3c8040438da7fc213c00b7175d6dc82802a995f46c4cdfd4a7","roleAuditVersion":"2026-07-30.2","schemaVersion":"yw-reader-document-v1","supplementary":[],"title":"* 再别康桥/ 徐志摩"}
