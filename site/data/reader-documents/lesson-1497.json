{"curationManifestSha256":"98e90b3603b34b437bc554810c21f01c4db44d10364211af114d30fde3d67bad","curationVersion":"2026-07-30.2","lessonId":"lesson-1497","main":{"annotations":[{"blocks":[{"runs":[{"text":"袍：长袍，类似于斗篷。行军者白天当衣服穿，晚上当被子盖。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10072-1"},{"blocks":[{"runs":[{"text":"王于兴师：周王出兵打仗。于，句中助词。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10072-2"},{"blocks":[{"runs":[{"text":"同仇：指共同对付敌人。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10072-3"},{"blocks":[{"runs":[{"text":"泽：同“襗（zé）”，贴身穿的衣服。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10072-4"},{"blocks":[{"runs":[{"text":"偕作：一同起来，指共同行动。作，起。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10072-5"},{"blocks":[{"runs":[{"text":"甲兵：铠甲和兵器。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10072-6"}],"blocks":[{"runs":[{"text":"岂曰无衣？与子同袍","type":"text"},{"label":"[1]","noteId":"footnote-10072-1","type":"annotation-ref"},{"text":"。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"王于兴师","type":"text"},{"label":"[2]","noteId":"footnote-10072-2","type":"annotation-ref"},{"text":"，修我戈矛，与子同仇","type":"text"},{"label":"[3]","noteId":"footnote-10072-3","type":"annotation-ref"},{"text":"。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"岂曰无衣？与子同泽","type":"text"},{"label":"[4]","noteId":"footnote-10072-4","type":"annotation-ref"},{"text":"。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"王于兴师，修我矛戟，与子偕作","type":"text"},{"label":"[5]","noteId":"footnote-10072-5","type":"annotation-ref"},{"text":"。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"岂曰无衣？与子同裳。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"王于兴师，修我甲兵","type":"text"},{"label":"[6]","noteId":"footnote-10072-6","type":"annotation-ref"},{"text":"，与子偕行。","type":"text"}],"type":"paragraph"},{"blocks":[{"runs":[{"text":"《无衣》产生于秦地。该诗反复咏唱：怎么能说没有衣服穿呢？我的衣服跟你共享。修好我们的铠甲和兵器，我跟你一同奔赴战场。诗歌既表现了慷慨赴敌、同仇敌忾的豪情，也表现了战士之间深厚的情谊。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"朱熹评价这首诗，强调它体现了秦人“尚气概，先勇力，忘生轻死”的气魄和“与子同仇”的“欢爱之心”（《诗集传》）。诵读这首诗，注意体会质朴诗句中蕴含的真挚情感。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"frontMatter":[{"blocks":[{"runs":[{"text":"选自《诗经注析》（中华书局1991 年版）","type":"text"}],"type":"paragraph"}],"type":"quote"}],"guidance":[],"links":[{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/cover3/%e4%b8%ad%e5%9b%bd%e5%8f%a4%e5%85%b8%e8%af%97%e6%ad%8c%e7%9a%84%e6%84%8f%e8%b1%a1/%e6%97%a0%e8%a1%a3%e8%af%97%e7%bb%8f%e7%a7%a6%e9%a3%8e","sourceUrl":"https://sites.google.com/view/pkuschool/cover3/%e4%b8%ad%e5%9b%bd%e5%8f%a4%e5%85%b8%e8%af%97%e6%ad%8c%e7%9a%84%e6%84%8f%e8%b1%a1/%e6%97%a0%e8%a1%a3%e8%af%97%e7%bb%8f%e7%a7%a6%e9%a3%8e","text":"https://sites.google.com/view/pkuschool/cover3/%e4%b8%ad%e5%9b%bd%e5%8f%a4%e5%85%b8%e8%af%97%e6%ad%8c%e7%9a%84%e6%84%8f%e8%b1%a1/%e6%97%a0%e8%a1%a3%e8%af%97%e7%bb%8f%e7%a7%a6%e9%a3%8e","title":null}],"media":[],"sourceOnlyBlocks":[],"sourcePostId":10072,"sourcePostNumber":1},"mediaReceiptLedgerSha256":"5487243dd8d14d65dfadc20ed544a999aaa318fc20c291462ea62c69e1eff320","mediaReceiptLedgerVersion":"2026-07-30.2","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10072-1","postId":10072,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10072-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10072-2","postId":10072,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10072-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10072-3","postId":10072,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10072-3","text":"[3]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10072-4","postId":10072,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10072-4","text":"[