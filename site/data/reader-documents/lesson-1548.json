":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-10359-6","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-10359-7","postId":10359,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-10359-7","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-10359-8","postId":10359,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-10359-8","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-10359-9","postId":10359,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-10359-9","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-10359-10","postId":10359,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-10359-10","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-10359-11","postId":10359,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-10359-11","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-10359-12","postId":10359,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-10359-12","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-10359-13","postId":10359,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-10359-13","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-10359-14","postId":10359,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-10359-14","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-10359-15","postId":10359,"postNumber":1,"postRole":"primar