{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1703","main":{"annotations":[],"blocks":[{"runs":[{"text":"优美的古诗词是中华传统文化的瑰宝，蕴含着中","type":"text"}],"type":"paragraph"},{"runs":[{"text":"华儿女代代相传的文化基因。阅读古诗词作品，可以","type":"text"}],"type":"paragraph"},{"runs":[{"text":"体味古人丰富的情感、深邃的思想、多样的人生，加","type":"text"}],"type":"paragraph"},{"runs":[{"text":"深对社会的思考，增强对人生的感悟，激发对中华优","type":"text"}],"type":"paragraph"},{"runs":[{"text":"秀传统文化的热爱之情。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"本单元汇集了不同时期、不同体式的诗词名作。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"曹操对“天下归心”的渴望，陶渊明“复得返自然”","type":"text"}],"type":"paragraph"},{"runs":[{"text":"的淡泊，展示了两种不同的人生状态；李白驰骋想象","type":"text"}],"type":"paragraph"},{"runs":[{"text":"的豪迈，杜甫登高望远的悲凉，白居易“同是天涯沦","type":"text"}],"type":"paragraph"},{"runs":[{"text":"落人”的慨叹，表现出各自的人生境遇和情感世界；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"苏轼、辛弃疾词的豪放，李清照词的婉约，则展示出","type":"text"}],"type":"paragraph"},{"runs":[{"text":"宋词不同的审美追求。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"学习本单元，要逐步掌握古诗词鉴赏的基本方法，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"认识古诗词的当代价值，增强对中华优秀传统文化的","type":"text"}],"type":"paragraph"},{"runs":[{"text":"传承意识。要在诵读和想象中感受诗歌的意境，欣赏","type":"text"}],"type":"paragraph"},{"runs":[{"text":"其独特的艺术魅力；感受诗人的精神世界，体会诗人","type":"text"}],"type":"paragraph"},{"runs":[{"text":"对社会的思考与对人生的感悟，提高自身的思想修养","type":"text"}],"type":"paragraph"},{"runs":[{"text":"和文化品位；尝试写作文学短评。","type":"text"}],"type":"paragraph"}],"frontMatter":[],"guidance":[],"links":[],"media":[{"alt":"","bytes":88919,"finalUrl":"https://files.rdfzer.com/original/2X/f/ffdd4e83dc7b5d89756ac8a68ffa851b2e04d51a.jpeg","height":1146,"id":"media-d2dfb6a4a8bd78a7f0d2","mediaType":"image/jpeg","nativeDisposition":"verified-in-app","receiptCollectedAt":"2026-07-30T01:10:43.464Z","receiptRequired":true,"rightsBasis":"user-authorized-course-source-use-2026-07-29","sha256":"510