{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1578","main":{"annotations":[{"blocks":[{"runs":[{"text":"〔癸（guǐ）丑〕指永和九年。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-1"},{"blocks":[{"runs":[{"text":"〔修禊（xì）〕古代民俗，于农历三月上旬的巳日（三国魏以后始固定为三月初三）到水边嬉戏，以祓除不祥，称为“修禊”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-2"},{"blocks":[{"runs":[{"text":"〔毕〕全，都。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-3"},{"blocks":[{"runs":[{"text":"〔咸〕全，都。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-4"},{"blocks":[{"runs":[{"text":"〔修竹〕高高的竹子。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-5"},{"blocks":[{"runs":[{"text":"〔映带〕景物互相衬托。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-6"},{"blocks":[{"runs":[{"text":"〔引以为流觞（shāng）曲水〕引（清流激湍）来作为流觞的曲水。流觞，把盛酒的杯浮在水面从上游放出，循曲水而下，流到谁的面前，谁就取来饮用。觞，酒杯。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-7"},{"blocks":[{"runs":[{"text":"〔次〕旁边。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-8"},{"blocks":[{"runs":[{"text":"〔幽情〕深远高雅的情思。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-9"},{"blocks":[{"runs":[{"text":"〔惠风〕和风。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-10"},{"blocks":[{"runs":[{"text":"〔品类〕自然界的万物。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-11"},{"blocks":[{"runs":[{"text":"〔所以游目骋怀〕借以纵目观赏，开畅胸怀。骋，开畅、舒展。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-12"},{"blocks":[{"runs":[{"text":"〔夫人之相与，俯仰一世〕人与人交往，很快便度过一生。相与，互相交往。俯仰，一俯一仰之间，比喻时间短暂。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-13"},{"blocks":[{"runs":[{"text":"〔取诸怀抱，悟言一室之内〕意思是，（有的人）在室中晤谈，互相倾吐心里话。诸，相当于“之于”。怀抱，心怀。悟言，晤谈、对谈。悟，同“晤”，面对。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-14"},{"blocks":[{"runs":[{"text":"〔因寄所托，放浪形骸之外〕意思是，（有的人）把情怀寄托在所爱好的事物上，言行不受拘束，狂放不羁。放浪形骸，放纵、不受拘束。形骸，人的躯体。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-15"},{"blocks":[{"runs":[{"text":"〔趣舍万殊〕意思是，各有各的爱好，取舍各不相同。趣，同“取”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-16"},{"blocks":[{"runs":[{"text":"〔静躁〕静与动。躁，动。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-17"},{"blocks":[{"runs":[{"text":"〔欣于所遇〕对所接触的感到欣喜。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-18"},{"blocks":[{"runs":[{"text":"〔暂得于己〕一时感到自得。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-19"},{"blocks":[{"runs":[{"text":"〔快然自足〕（感到）高兴和满足。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-20"},{"blocks":[{"runs":[{"text":"〔不知老之将至〕不知道老年将要到来。语出《论语·述而》。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-21"},{"blocks":[{"runs":[{"text":"〔所之既倦〕（对于）所喜爱或得到的已经厌倦。之，求得。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-22"},{"blocks":[{"runs":[{"text":"〔情随事迁〕感情随着情况的变化而变化。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-23"},{"blocks":[{"runs":[{"text":"〔感慨系之〕感慨随着这种变化而有所不同。系，连接。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-24"},{"blocks":[{"runs":[{"text":"〔犹〕尚且。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-25"},{"blocks":[{"runs":[{"text":"〔以之兴怀〕因它而引起心中的感触。以，因。之，指“向之所欣……已为陈迹”。兴，发生、引起。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-26"},{"blocks":[{"runs":[{"text":"〔修短随化〕寿命长短，听凭造化。化，指自然。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-27"},{"blocks":[{"runs":[{"text":"〔终期于尽〕终究归结于消灭。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-28"},{"blocks":[{"runs":[{"text":"〔死生亦大矣〕死生是一件大事。语出《庄子·德充符》。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-29"},{"blocks":[{"runs":[{"text":"〔每览昔人兴感之由〕每当看到古人（对死生）发生感慨的原因。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-30"},{"blocks":[{"runs":[{"text":"〔若合一契〕像符契那样相合（意思是发生感触的原因相同）。契，即符契，古代符信的一种，以金玉竹木等制成，上刻文字，分成两半，合在一起可为凭验。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-31"},{"blocks":[{"runs":[{"text":"〔嗟悼〕叹息哀伤。悼，悲伤。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-32"},{"blocks":[{"runs":[{"text":"〔不能喻之于怀〕不能明白于心。意思是，看到古人对死生发生感慨的文章，就为此悲伤感叹，也说不出是什么原因。喻，明白。一说是消解、释怀的意思。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-33"},{"blocks":[{"runs":[{"text":"〔固知一死生为虚诞，齐彭殇（shāng）为妄作〕就知道把死和生等同起来的说法是不真实的，把长寿和短命等同起来的说法是虚妄之谈。固，乃。一， 把……看作一样。齐，把……看作相等。虚诞，虚妄荒诞。彭，即彭祖，传说他曾活到八百岁。殇，未成年而死去的人。妄作，虚妄之谈。一死生、齐彭殇，都是《庄子·齐物论》中的看法。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-34"},{"blocks":[{"runs":[{"text":"〔列叙时人〕一个一个记下当时与会的人。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-35"},{"blocks":[{"runs":[{"text":"〔致〕意态，情趣。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10538-36"}],"blocks":[{"runs":[{"text":"兰亭修禊图（局部） ［明］文征明 作","type":"text"}],"type":"paragraph"},{"runs":[{"text":"永和九年，岁在癸丑","type":"text"},{"label":"[1]","noteId":"footnote-10538-1","type":"annotation-ref"},{"text":"，暮春之初，会于会稽山阴之兰亭，修禊","type":"text"},{"label":"[2]","noteId":"footnote-10538-2","type":"annotation-ref"},{"text":"事也。群贤毕","type":"text"},{"label":"[3]","noteId":"footnote-10538-3","type":"annotation-ref"},{"text":"至，少长咸","type":"text"},{"label":"[4]","noteId":"footnote-10538-4","type":"annotation-ref"},{"text":"集。此地有崇山峻岭，茂林修竹","type":"text"},{"label":"[5]","noteId":"footnote-10538-5","type":"annotation-ref"},{"text":"，又有清流激湍，映带","type":"text"},{"label":"[6]","noteId":"footnote-10538-6","type":"annotation-ref"},{"text":"左右，引以为流觞曲水","type":"text"},{"label":"[7]","noteId":"footnote-10538-7","type":"annotation-ref"},{"text":"，列坐其次","type":"text"},{"label":"[8]","noteId":"footnote-10538-8","type":"annotation-ref"},{"text":"。虽无丝竹管弦之盛，一觞一咏，亦足以畅叙幽情","type":"text"},{"label":"[9]","noteId":"footnote-10538-9","type":"annotation-ref"},{"text":"。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"是日也，天朗气清，惠风","type":"text"},{"label":"[10]","noteId":"footnote-10538-10","type":"annotation-ref"},{"text":"和畅。仰观宇宙之大，俯察品类","type":"text"},{"label":"[11]","noteId":"footnote-10538-11","type":"annotation-ref"},{"text":"之盛，所以游目骋怀","type":"text"},{"label":"[12]","noteId":"footnote-10538-12","type":"annotation-ref"},{"text":"，足以极视听之娱，信可乐也。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"夫人之相与，俯仰一世","type":"text"},{"label":"[13]","noteId":"footnote-10538-13","type":"annotation-ref"},{"text":"。或取诸怀抱，悟言一室之内","type":"text"},{"label":"[14]","noteId":"footnote-10538-14","type":"annotation-ref"},{"text":"；或因寄所托，放浪形骸之外","type":"text"},{"label":"[15]","noteId":"footnote-10538-15","type":"annotation-ref"},{"text":"。虽趣舍万殊","type":"text"},{"label":"[16]","noteId":"footnote-10538-16","type":"annotation-ref"},{"text":"，静躁","type":"text"},{"label":"[17]","noteId":"footnote-10538-17","type":"annotation-ref"},{"text":"不同，当其欣于所遇","type":"text"},{"label":"[18]","noteId":"footnote-10538-18","type":"annotation-ref"},{"text":"，暂得于己","type":"text"},{"label":"[19]","noteId":"footnote-10538-19","type":"annotation-ref"},{"text":"，快然自足","type":"text"},{"label":"[20]","noteId":"footnote-10538-20","type":"annotation-ref"},{"text":"，不知老之将至","type":"text"},{"label":"[21]","noteId":"footnote-10538-21","type":"annotation-ref"},{"text":"；及其所之既倦","type":"text"},{"label":"[22]","noteId":"footnote-10538-22","type":"annotation-ref"},{"text":"，情随事迁","type":"text"},{"label":"[23]","noteId":"footnote-10538-23","type":"annotation-ref"},{"text":"，感慨系之","type":"text"},{"label":"[24]","noteId":"footnote-10538-24","type":"annotation-ref"},{"text":"矣。向之所欣，俯仰之间，已为陈迹，犹","type":"text"},{"label":"[25]","noteId":"footnote-10538-25","type":"annotation-ref"},{"text":"不能不以之兴怀","type":"text"},{"label":"[26]","noteId":"footnote-10538-26","type":"annotation-ref"},{"text":"，况修短随化","type":"text"},{"label":"[27]","noteId":"footnote-10538-27","type":"annotation-ref"},{"text":"，终期于尽","type":"text"},{"label":"[28]","noteId":"footnote-10538-28","type":"annotation-ref"},{"text":"！古人云：“死生亦大矣","type":"text"},{"label":"[29]","noteId":"footnote-10538-29","type":"annotation-ref"},{"text":"。”岂不痛哉!","type":"text"}],"type":"paragraph"},{"runs":[{"text":"每览昔人兴感之由","type":"text"},{"label":"[30]","noteId":"footnote-10538-30","type":"annotation-ref"},{"text":"，若合一契","type":"text"},{"label":"[31]","noteId":"footnote-10538-31","type":"annotation-ref"},{"text":"，未尝不临文嗟悼","type":"text"},{"label":"[32]","noteId":"footnote-10538-32","type":"annotation-ref"},{"text":"，不能喻之于怀","type":"text"},{"label":"[33]","noteId":"footnote-10538-33","type":"annotation-ref"},{"text":"。固知一死生为虚诞，齐彭殇为妄作","type":"text"},{"label":"[34]","noteId":"footnote-10538-34","type":"annotation-ref"},{"text":"。后之视今，亦犹今之视昔，悲夫！故列叙时人","type":"text"},{"label":"[35]","noteId":"footnote-10538-35","type":"annotation-ref"},{"text":"，录其所述，虽世殊事异，所以兴怀，其致","type":"text"},{"label":"[36]","noteId":"footnote-10538-36","type":"annotation-ref"},{"text":"一也。后之览者，亦将有感于斯文。","type":"text"}],"type":"paragraph"}],"frontMatter":[{"blocks":[{"runs":[{"text":"选自《晋书·王羲之传》（中华书局1974 年版）。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"王羲之（303—361， 一说321—379）， 字逸少， 祖籍琅玡（lángyá）临沂（今属山东），后迁居会（kuài）稽山阴（今浙江绍兴），东晋书法家。因曾任右军将军，世称“王右军”。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"东晋穆帝永和九年（353），王羲之和当时的名士谢安、孙绰等人，于三月三日在会稽郡山阴的兰亭集会。他们曲水流觞，饮酒赋诗，各抒怀抱，最后由王羲之作序一篇，是为《兰亭集序》。兰亭，在今浙江绍兴西南兰渚山。","type":"text"}],"type":"paragraph"},{"runs":[{"disposition":"system-browser","href":"https://www.dpm.org.cn/collection/handwriting/228279.html","sourceUrl":"https://www.dpm.org.cn/collection/handwriting/228279.html","text":"冯承素行书摹兰亭序卷 - 故宫博物院冯承素行书摹兰亭序卷","type":"link"}],"type":"paragraph"}],"type":"quote"}],"guidance":[],"links":[{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%b8%89%e5%8d%95%e5%85%83/10-%e5%85%b0%e4%ba%ad%e9%9b%86%e5%ba%8f-%e7%8e%8b%e7%be%b2%e4%b9%8b?","sourceUrl":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%b8%89%e5%8d%95%e5%85%83/10-%e5%85%b0%e4%ba%ad%e9%9b%86%e5%ba%8f-%e7%8e%8b%e7%be%b2%e4%b9%8b?","text":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%b8%89%e5%8d%95%e5%85%83/10-%e5%85%b0%e4%ba%ad%e9%9b%86%e5%ba%8f-%e7%8e%8b%e7%be%b2%e4%b9%8b?","title":null},{"disposition":"system-browser","href":"https://www.dpm.org.cn/collection/handwriting/228279.html","sourceUrl":"https://www.dpm.org.cn/collection/handwriting/228279.html","text":"冯承素行书摹兰亭序卷 - 故宫博物院冯承素行书摹兰亭序卷","title":null}],"media":[{"alt":"","bytes":73177,"finalUrl":"https://files.rdfzer.com/original/2X/0/0d5a9397daf23fcec54dab3e75e0d3c0b28fbd92.jpeg","height":302,"id":"media-79b15e79b1609d816706","mediaType":"image/jpeg","nativeDisposition":"verified-in-app","receiptCollectedAt":"2026-07-30T01:10:43.464Z","receiptRequired":true,"rightsBasis":"user-authorized-course-source-use-2026-07-29","sha256":"f7d0dc3a95c8714b2dbbd82d7a35438b23dec12712d8118353db08bbcb82e7ec","sourceUrl":"https://files.rdfzer.com/original/2X/0/0d5a9397daf23fcec54dab3e75e0d3c0b28fbd92.jpeg","webDisposition":"source-url","width":456}],"sourceOnlyBlocks":[],"sourcePostId":10538,"sourcePostNumber":1},"mediaReceiptLedgerSha256":"0319bd9f7623eb57ee396cafc0343cb6c4dc51dce258109a19edbdddd91be71c","mediaReceiptLedgerVersion":"2026-08-09.1","provenance":{"links":[{"disposition":"system-browser","href":"https://www.dpm.org.cn/collection/handwriting/228279.html","postId":10538,"postNumber":1,"postRole":"primary","sourceUrl":"https://www.dpm.org.cn/collection/handwriting/228279.html","text":"冯承素行书摹兰亭序卷 - 故宫博物院冯承素行书摹兰亭序卷","title":null},{"disposition":"system-browser","href":"https://files.rdfzer.com/original/2X/0/0d5a9397daf23fcec54dab3e75e0d3c0b28fbd92.jpeg","postId":10538,"postNumber":1,"postRole":"primary","sourceUrl":"https://files.rdfzer.com/original/2X/0/0d5a9397daf23fcec54dab3e75e0d3c0b28fbd92.jpeg","text":"https://files.rdfzer.com/original/2X/0/0d5a9397daf23fcec54dab3e75e0d3c0b28fbd92.jpeg","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#f