{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1550","main":{"annotations":[{"blocks":[{"runs":[{"text":"锦瑟：漆有织锦纹的瑟。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10375-1"},{"blocks":[{"runs":[{"text":"无端：无缘由。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10375-2"},{"blocks":[{"runs":[{"text":"柱：瑟上系弦的木块。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10375-3"},{"blocks":[{"runs":[{"text":"华年：指青年时代。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10375-4"},{"blocks":[{"runs":[{"text":"庄生晓梦迷蝴蝶：庄周梦到自己变成了蝴蝶，醒来后觉得自己还是庄周，因此困惑不已。典出《庄子·齐物论》。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10375-5"},{"blocks":[{"runs":[{"text":"望帝春心托杜鹃：望帝把思恋爱慕的情怀寄托在杜鹃哀切的啼鸣之中。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10375-6"},{"blocks":[{"runs":[{"text":"珠有泪：传说海中有鲛人，其泪化为珍珠。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10375-7"},{"blocks":[{"runs":[{"text":"蓝田：地名，在今陕西，以出产美玉闻名。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10375-8"},{"blocks":[{"runs":[{"text":"惘然：模糊不清的样子。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10375-9"}],"blocks":[{"runs":[{"text":"锦瑟","type":"text"},{"label":"[1]","noteId":"footnote-10375-1","type":"annotation-ref"},{"text":"无端","type":"text"},{"label":"[2]","noteId":"footnote-10375-2","type":"annotation-ref"},{"text":"五十弦，一弦一柱","type":"text"},{"label":"[3]","noteId":"footnote-10375-3","type":"annotation-ref"},{"text":"思华年","type":"text"},{"label":"[4]","noteId":"footnote-10375-4","type":"annotation-ref"},{"text":"。\n\n庄生晓梦迷蝴蝶","type":"text"},{"label":"[5]","noteId":"footnote-10375-5","type":"annotation-ref"},{"text":"，望帝春心托杜鹃","type":"text"},{"label":"[6]","noteId":"footnote-10375-6","type":"annotation-ref"},{"text":"。\n\n沧海月明珠有泪","type":"text"},{"label":"[7]","noteId":"footnote-10375-7","type":"annotation-ref"},{"text":"，蓝田","type":"text"},{"label":"[8]","noteId":"footnote-10375-8","type":"annotation-ref"},{"text":"日暖玉生烟。\n\n此情可待成追忆，只是当时已惘然","type":"text"},{"label":"[9]","noteId":"footnote-10375-9","type":"annotation-ref"},{"text":"。","type":"text"}],"type":"paragraph"},{"blocks":[{"runs":[{"text":"王士禛在《戏仿元遗山论诗绝句三十二首》（其十一）中曾说，“一篇《锦瑟》解人难”。这首诗历来有多样的解释。可以这样解读：锦瑟本有五十弦却说“无端”，流露了诗人心底的嗔怨。这一嗔怨，关联着他对青春年华的怀想。回顾平生，有多少情、多少事，早已迷离惝恍，宛如“庄周梦蝶”的故事一样，真实与梦境无法分辨，唯有曾经的感受，既如月光中带泪的珍珠，带着伤感，又如蓝田美玉的温润，引人怀恋。但究竟如何，却又难以说清。诵读这首诗，应当仔细体会诗人如何传达往事如烟的独特感受。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"frontMatter":[{"blocks":[{"runs":[{"text":"选自《玉谿生诗集笺注》卷二（上海古籍出版社1979 年版）。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"guidance":[],"links":[{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/xbz000/%e5%8f%a4%e8%af%97%e8%af%8d%e8%af%b5%e8%af%bb/%e9%94%a6%e7%91%9f-%e6%9d%8e%e5%95%86%e9%9a%90","sourceUrl":"https://sites.google.com/view/pkuschool/xbz000/%e5%8f%a4%e8%af%97%e8%af%8d%e8%af%b5%e8%af%bb/%e9%94%a6%e7%91%9f-%e6%9d%8e%e5%95%86%e9%9a%90","text":"https://sites.google.com/view/pkuschool/xbz000/%e5%8f%a4%e8%af%97%e8%af%8d%e8%af%b5%e8%af%bb/%e9%94%a6%e7%91%9f-%e6%9d%8e%e5%95%86%e9%9a%90","title":null}],"media":[],"sourceOnlyBlocks":[],"sourcePostId":10375,"sourcePostNumber":1},"mediaReceiptLedgerSha256":"0319bd9f7623eb57ee396cafc0343cb6c4dc51dce258109a19edbdddd91be71c","mediaReceiptLedgerVersion":"2026-08-09.1","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10375-1","postId":10375,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10375-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10375-2","postId":10375,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10375-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10375-3","postId":10375,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#foo