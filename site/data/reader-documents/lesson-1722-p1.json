{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1722-p1","main":{"annotations":[{"blocks":[{"runs":[{"text":"静女其姝（shū）：娴静的女子很漂亮。姝，美丽、漂亮。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11163-1"},{"blocks":[{"runs":[{"text":"俟（sì）：等待。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11163-2"},{"blocks":[{"runs":[{"text":"城隅：城角。一说指城上的角楼。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11163-3"},{"blocks":[{"runs":[{"text":"爱：同“ （ài）”，隐藏。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11163-4"},{"blocks":[{"runs":[{"text":"搔首踟蹰（chíchú）：以手指挠头，徘徊不进。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11163-5"},{"blocks":[{"runs":[{"text":"娈（luán）：美好。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11163-6"},{"blocks":[{"runs":[{"text":"彤管：红色的管状物。一说指初生时呈红色的管状的草。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11163-7"},{"blocks":[{"runs":[{"text":"炜（wěi）：色红而光亮。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11163-8"},{"blocks":[{"runs":[{"text":"说怿女美：喜爱你的美丽。说，同“悦”。怿，喜悦。女，同“汝”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11163-9"},{"blocks":[{"runs":[{"text":"自牧归荑（tí）：从远郊归来赠送我初生的茅草。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11163-10"},{"blocks":[{"runs":[{"text":"洵美且异：确实美好而且与众不同。洵，诚然、实在。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11163-11"},{"blocks":[{"runs":[{"text":"匪女之为美：并非你这荑草美。匪，同“非”，表示否定判断。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11163-12"}],"blocks":[{"type":"divider"},{"runs":[{"text":"《诗经·邶风》","type":"text"}],"type":"paragraph"},{"runs":[{"text":"静女其姝","type":"text"},{"label":"[1]","noteId":"footnote-11163-1","type":"annotation-ref"},{"text":"，俟","type":"text"},{"label":"[2]","noteId":"footnote-11163-2","type":"annotation-ref"},{"text":"我于城隅","type":"text"},{"label":"[3]","noteId":"footnote-11163-3","type":"annotation-ref"},{"text":"。\n\n爱","type":"text"},{"label":"[4]","noteId":"footnote-11163-4","type":"annotation-ref"},{"text":"而不见，搔首踟蹰","type":"text"},{"label":"[5]","noteId":"footnote-11163-5","type":"annotation-ref"},{"text":"。\n\n静女其娈","type":"text"},{"label":"[6]","noteId":"footnote-11163-6","type":"annotation-ref"},{"text":"，贻我彤管","type":"text"},{"label":"[7]","noteId":"footnote-11163-7","type":"annotation-ref"},{"text":"。\n\n彤管有炜","type":"text"},{"label":"[8]","noteId":"footnote-11163-8","type":"annotation-ref"},{"text":"，说怿女美","type":"text"},{"label":"[9]","noteId":"footnote-11163-9","type":"annotation-ref"},{"text":"。\n\n自牧归荑","type":"text"},{"label":"[10]","noteId":"footnote-11163-10","type":"annotation-ref"},{"text":"，洵美且异","type":"text"},{"label":"[11]","noteId":"footnote-11163-11","type":"annotation-ref"},{"text":"。\n\n匪女之为美","type":"text"},{"label":"[12]","noteId":"footnote-11163-12","type":"annotation-ref"},{"text":"，美人之贻。","type":"text"}],"type":"paragraph"},{"type":"divider"},{"blocks":[{"runs":[{"text":"这是一首古老的爱情诗。开篇先以男子之口，引出一位娴静而美丽的女子。接着叙述她原本与男子约定相会，却“爱而不见”，令男子独自徘徊，这样的场景，表现了爱情萌发时的甜蜜和欢乐。接下来说静女赠送的彤管很美丽、讨人喜爱，后面又退一步说并非彤管好，而是因为它是美人赠送的。如此反复借彤管“表白”，其实都是抒发对静女的爱，真实且有情趣。诵读这首诗，思考“彤管”这类美好事物在诗中的象征作用，感受反复手法在表情达意上的作用。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"frontMatter":[{"blocks":[{"runs":[{"text":"选自《诗经注析》（中华书局1991 年版）。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"guidance":[],"links":[],"media":[],"sourceOnlyBlocks":[],"sourcePostId":"11163-1","sourcePostNumber":1},"mediaReceiptLedgerSha256":"0319bd9f7623eb57ee396cafc0343cb6c4dc51dce258109a19edbdddd91be71c","mediaReceiptLedgerVersion":"2026-08-09.1","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11163-1","postId":"11163-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11163-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11163-2","postId":"11163-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11163-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11163-3","postId":"11163-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11163-3","text":"[3]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11163-4","postId":"11163-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11163-4","text":"[4]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11163-5","postId":"11163-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11163-5","text":"[5]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11163-6","postId":"11163-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11163-6","text":"[6]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11163-7","postId":"11163-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11163-7","text":"[7]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11163-8","postId":"11163-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11163-8","text":"[8]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11163-9","postId":"11163-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11163-9","text":"[9]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11163-10","postId":"11163-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11163-10","text":"[10]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11163-11","postId":"11163-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11163-11","text":"[11]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11163-12","postId":"11163-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11163-12","text":"[12]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11163-1","postId":"11163-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11163-1","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11163-2","postId":"11163-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11163-2","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11163-3","postId":"11163-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11163-3","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11163-4","postId":"11163-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11163-4","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11163-5","postId":"11163-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11163-5","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11163-6","postId":"11163-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11163-6","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11163-7","postId":"11163-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11163-7","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11163-8","postId":"11163-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.