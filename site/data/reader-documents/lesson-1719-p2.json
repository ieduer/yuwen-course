{"curationManifestSha256":"98e90b3603b34b437bc554810c21f01c4db44d10364211af114d30fde3d67bad","curationVersion":"2026-07-30.2","lessonId":"lesson-1719-p2","main":{"annotations":[{"blocks":[{"runs":[{"text":"选自《惜抱轩诗文集》卷十四（上海古籍出版社1992年版）。姚鼐（1732—1815），字姬传，桐城（今属安徽）人，清代散文家。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-1"},{"blocks":[{"runs":[{"text":"汶（wèn）水，发源于山东莱芜东北原山，向西南流经泰安。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-2"},{"blocks":[{"runs":[{"text":"济（jǐ）水，发源于河南济源西王屋山，东流到山东入海。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-3"},{"blocks":[{"runs":[{"text":"阳谷，山南面山谷中的水。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-4"},{"blocks":[{"runs":[{"text":"当其南北分者，在那（阳谷和阴谷）南北分界处的。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-5"},{"blocks":[{"runs":[{"text":"古长城，古代的长城，指春秋战国时齐国所筑长城的遗址，古时齐鲁两国以此分界。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-6"},{"blocks":[{"runs":[{"text":"以，在。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-7"},{"blocks":[{"runs":[{"text":"乾隆三十九年，公元1774年。乾隆，清高宗的年号（1736—1795）。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-8"},{"blocks":[{"runs":[{"text":"乘，这里是“冒”的意思。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-9"},{"blocks":[{"runs":[{"text":"齐河、长清，清代县名，今属山东。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-10"},{"blocks":[{"runs":[{"text":"限，界限。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-11"},{"blocks":[{"runs":[{"text":"是月丁未，这个月的丁未日（乾隆三十九年十二月二十八日）。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-12"},{"blocks":[{"runs":[{"text":"朱孝纯子颍（yǐng），朱孝纯，字子颍。当时是泰安府的知府。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-13"},{"blocks":[{"runs":[{"text":"磴，石阶。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-14"},{"blocks":[{"runs":[{"text":"环水，水名，又名“梳洗河”。郦道元《水经注·汶水》：“又合环水，水出泰山南溪。”","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-15"},{"blocks":[{"runs":[{"text":"循以入，顺着（中谷）进山。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-16"},{"blocks":[{"runs":[{"text":"道少半，路不到一半。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-17"},{"blocks":[{"runs":[{"text":"中岭，山名，又名“中溪山”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-18"},{"blocks":[{"runs":[{"text":"崖限当道者，像门槛一样横在路上的山崖。限，门槛。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-19"},{"blocks":[{"runs":[{"text":"云，助词，无实义。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-20"},{"blocks":[{"runs":[{"text":"几（jī），几乎。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-21"},{"blocks":[{"runs":[{"text":"苍山负雪，明烛天南，青黑色的山上覆盖着白雪，雪反射的光照亮了南面的天空。负，背。烛，照。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-22"},{"blocks":[{"runs":[{"text":"城郭，指城市。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-23"},{"blocks":[{"runs":[{"text":"徂徕（cúlái），山名，在泰安城东南。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-24"},{"blocks":[{"runs":[{"text":"居，停留。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-25"},{"blocks":[{"runs":[{"text":"戊申晦，戊申日月底这一天。晦，农历每月的最后一天。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-26"},{"blocks":[{"runs":[{"text":"五鼓，五更。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-27"},{"blocks":[{"runs":[{"text":"日观亭，亭名，在日观峰上。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-28"},{"blocks":[{"runs":[{"text":"漫，弥漫。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-29"},{"blocks":[{"runs":[{"text":"稍，逐渐。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-30"},{"blocks":[{"runs":[{"text":"樗蒱（chūpú），古代的一种博戏，这里指樗蒱所用的掷具，长形而末端尖锐，立起来像山峰。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-31"},{"blocks":[{"runs":[{"text":"极天，天边。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-32"},{"blocks":[{"runs":[{"text":"采，同“彩”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-33"},{"blocks":[{"runs":[{"text":"丹，朱砂。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-34"},{"blocks":[{"runs":[{"text":"东海，泛指东面的海。这里是想象，实际上在泰山顶上并不能看见东海。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-35"},{"blocks":[{"runs":[{"text":"或得日或否，有的被日光照着，有的没有被照着。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-36"},{"blocks":[{"runs":[{"text":"绛皓（hào）驳色，或红或白，颜色错杂。绛，大红。皓，白。驳，杂。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-37"},{"blocks":[{"runs":[{"text":"偻，脊背弯曲的样子。引申为鞠躬的样子。日观峰西面诸峰都比日观峰低，所以说“若偻”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-38"},{"blocks":[{"runs":[{"text":"岱祠，东岳大帝庙。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-39"},{"blocks":[{"runs":[{"text":"碧霞元君，传说是东岳大帝的女儿。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-40"},{"blocks":[{"runs":[{"text":"行宫，皇帝出外巡行时居住的处所。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-41"},{"blocks":[{"runs":[{"text":"显庆，唐高宗的年号（656—661）。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-42"},{"blocks":[{"runs":[{"text":"漫失，模糊或缺失。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-43"},{"blocks":[{"runs":[{"text":"圜，同“圆”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11156-44"}],"blocks":[{"runs":[{"text":"登泰山记","type":"text"},{"label":"[1]","noteId":"footnote-11156-1","type":"annotation-ref"}],"type":"paragraph"},{"runs":[{"text":"姚 鼐","type":"text"}],"type":"paragraph"},{"runs":[{"text":"泰山之阳，汶水","type":"text"},{"label":"[2]","noteId":"footnote-11156-2","type":"annotation-ref"},{"text":"西流；其阴，济水","type":"text"},{"label":"[3]","noteId":"footnote-11156-3","type":"annotation-ref"},{"text":"东流。阳谷","type":"text"},{"label":"[4]","noteId":"footnote-11156-4","type":"annotation-ref"},{"text":"皆入汶，阴谷皆入济。当其南北分者","type":"text"},{"label":"[5]","noteId":"footnote-11156-5","type":"annotation-ref"},{"text":"，古长城","type":"text"},{"label":"[6]","noteId":"footnote-11156-6","type":"annotation-ref"},{"text":"也。最高日观峰，在长城南十五里。余以","type":"text"},{"label":"[7]","noteId":"footnote-11156-7","type":"annotation-ref"},{"text":"乾隆三十九年","type":"text"},{"label":"[8]","noteId":"footnote-11156-8","type":"annotation-ref"},{"text":"十二月，自京师乘","type":"text"},{"label":"[9]","noteId":"footnote-11156-9","type":"annotation-ref"},{"text":"风雪，历齐河、长清","type":"text"},{"label":"[10]","noteId":"footnote-11156-10","type":"annotation-ref"},{"text":"，穿泰山西北谷，越长城之限","type":"text"},{"label":"[11]","noteId":"footnote-11156-11","type":"annotation-ref"},{"text":"，至于泰安。是月丁未","type":"text"},{"label":"[12]","noteId":"footnote-11156-12","type":"annotation-ref"},{"text":"，与知府朱孝纯子颍","type":"text"},{"label":"[13]","noteId":"footnote-11156-13","type":"annotation-ref"},{"text":"由南麓登。四十五里，道皆砌石为磴","type":"text"},{"label":"[14]","noteId":"footnote-11156-14","type":"annotation-ref"},{"text":"，其级七千有余。泰山正南面有三谷。中谷绕泰安城下，郦道元所谓环水","type":"text"},{"label":"[15]","noteId":"footnote-11156-15","type":"annotation-ref"},{"text":"也。余始循以入","type":"text"},{"label":"[16]","noteId":"footnote-11156-16","type":"annotation-ref"},{"text":"，道少半","type":"text"},{"label":"[17]","noteId":"footnote-11156-17","type":"annotation-ref"},{"text":"，越中岭","type":"text"},{"label":"[18]","noteId":"footnote-11156-18","type":"annotation-ref"},{"text":"，复循西谷，遂至其巅。古时登山，循东谷入，道有天门。东谷者，古谓之天门溪水，余所不至也。今所经中岭及山巅，崖限当道者","type":"text"},{"label":"[19]","noteId":"footnote-11156-19","type":"annotation-ref"},{"text":"，世皆谓之天门云","type":"text"},{"label":"[20]","noteId":"footnote-11156-20","type":"annotation-ref"},{"text":"。道中迷雾冰滑，磴几","type":"text"},{"label":"[21]","noteId":"footnote-11156-21","type":"annotation-ref"},{"text":"不可登。及既上，苍山负雪，明烛天南","type":"text"},{"label":"[22]","noteId":"footnote-11156-22","type":"annotation-ref"},{"text":"。望晚日照城郭","type":"text"},{"label":"[23]","noteId":"footnote-11156-23","type":"annotation-ref"},{"text":"，汶水、徂徕","type":"text"},{"label":"[24]","noteId":"footnote-11156-24","type":"annotation-ref"},{"text":"如画，而半山居","type":"text"},{"label":"[25]","noteId":"footnote-11156-25","type":"annotation-ref"},{"text":"雾若带然。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"戊申晦","type":"text"},{"label":"[26]","noteId":"footnote-11156-26","type":"annotation-ref"},{"text":"，五鼓","type":"text"},{"label":"[27]","noteId":"footnote-11156-27","type":"annotation-ref"},{"text":"，与子颍坐日观亭","type":"text"},{"label":"[28]","noteId":"footnote-11156-28","type":"annotation-ref"},{"text":"，待日出。大风扬积雪击面。亭东自足下皆云漫","type":"text"},{"label":"[29]","noteId":"footnote-11156-29","type":"annotation-ref"},{"text":"。稍","type":"text"},{"label":"[30]","noteId":"footnote-11156-30","type":"annotation-ref"},{"text":"见云中白若樗蒱","type":"text"},{"label":"[31]","noteId":"footnote-11156-31","type":"annotation-ref"},{"text":"数十立者，山也。极天","type":"text"},{"label":"[32]","noteId":"footnote-11156-32","type":"annotation-ref"},{"text":"云一线异色，须臾成五采","type":"text"},{"label":"[33]","noteId":"footnote-11156-33","type":"annotation-ref"},{"text":"。日上，正赤如丹","type":"text"},{"label":"[34]","noteId":"footnote-11156-34","type":"annotation-ref"},{"text":"，下有红光动摇承之，或曰，此东海","type":"text"},{"label":"[35]","noteId":"footnote-11156-35","type":"annotation-ref"},{"text":"也。回视日观以西峰，或得日或否","type":"text"},{"label":"[36]","noteId":"footnote-11156-36","type":"annotation-ref"},{"text":"，绛皓驳色","type":"text"},{"label":"[37]","noteId":"footnote-11156-37","type":"annotation-ref"},{"text":"，而皆若偻","type":"text"},{"label":"[38]","noteId":"footnote-11156-38","type":"annotation-ref"},{"text":"。亭西有岱祠","type":"text"},{"label":"[39]","noteId":"footnote-11156-39","type":"annotation-ref"},{"text":"，又有碧霞元君","type":"text"},{"label":"[40]","noteId":"footnote-11156-40","type":"annotation-ref"},{"text":"祠。皇帝行宫","type":"text"},{"label":"[41]","noteId":"footnote-11156-41","type":"annotation-ref"},{"text":" 在碧霞元君祠东。是日观道中石刻，自唐显庆","type":"text"},{"label":"[42]","noteId":"footnote-11156-42","type":"annotation-ref"},{"text":"以来；其远古刻尽漫失","type":"text"},{"label":"[43]","noteId":"footnote-11156-43","type":"annotation-ref"},{"text":"。僻不当道者，皆不及往。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"山多石，少土。石苍黑色，多平方，少圜","type":"text"},{"label":"[44]","noteId":"footnote-11156-44","type":"annotation-ref"},{"text":"。少杂树，多松，生石罅，皆平顶。冰雪，无瀑水，无鸟兽音迹。至日观数里内无树，而雪与人膝齐。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"桐城姚鼐记。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"泰山图 ［清］张深 作","type":"text"}],"type":"paragraph"}],"frontMatter":[],"guidance":[],"links":[],"media":[{"alt":"","bytes":30918,"finalUrl":"https://files.rdfzer.com/original/2X/1/107729110b61d092df555e2ce1276098f0217c9b.jpeg","height":530,"id":"media-152d37c051d4de876828","mediaType":"image/jpeg","nativeDisposition":"verified-in-app","receiptCollectedAt":"2026-07-30T01:10:43.464Z","receiptRequired":true,"rightsBasis":"user-authorized-course-source-use-2026-07-29","sha256":"9f2f6c9d61bf308fc65070191b1f0bfe97793516f4ee65ca32126dfa9b64c56c","sourceUrl":"https://files.rdfzer.com/original/2X/1/107729110b61d092df555e2ce1276098f0217c9b.jpeg","webDisposition":"source-url","width":175}],"sourceOnlyBlocks":[],"sourcePostId":"11156-2","sourcePostNumber":1},"mediaReceiptLedgerSha256":"5487243dd8d14d65dfadc20ed544a999aaa318fc20c291462ea62c69e1eff320","mediaReceiptLedgerVersion":"2026-07-30.2","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11156-1","postId":"11156-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11156-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11156-2","postId":"11156-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11156-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11156-3","postId":"11156-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11156-3","text":"[3]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11156-4","postId":"11156-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11156-4","text":"[4]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11156-5","postId":"11156-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11156-5","text":"[5]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11156-6","postId":"11156-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11156-6","text":"[6]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11156-7","postId":"11156-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11156-7","text":"[7]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11156-8","postId":"11156-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11156-8","text":"[8]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11156-9","postId":"11156-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11156-9","text":"[9]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11156-10","postId":"11156-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11156-10","text":"[10]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11156-11","postId":"11156-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11156-11","text":"[11]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11156-12","postId":"11156-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11156-12","text":"[12]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#fo