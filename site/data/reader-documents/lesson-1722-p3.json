{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1722-p3","main":{"annotations":[{"blocks":[{"runs":[{"text":"春花秋月：指季节的更替。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11165-1"},{"blocks":[{"runs":[{"text":"往事知多少：意思是多少往事都难以忘却。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11165-2"},{"blocks":[{"runs":[{"text":"故国：指南唐。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11165-3"},{"blocks":[{"runs":[{"text":"雕栏玉砌：雕饰华美的栏杆与用玉石砌成的台阶，指宫殿建筑。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11165-4"},{"blocks":[{"runs":[{"text":"朱颜改：红润的容颜改变了，指人已憔悴。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11165-5"},{"blocks":[{"runs":[{"text":"几多：多少。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11165-6"}],"blocks":[{"type":"divider"},{"runs":[{"text":"《虞美人》","type":"text"}],"type":"paragraph"},{"runs":[{"text":"春花秋月","type":"text"},{"label":"[1]","noteId":"footnote-11165-1","type":"annotation-ref"},{"text":" 何时了，往事知多少","type":"text"},{"label":"[2]","noteId":"footnote-11165-2","type":"annotation-ref"},{"text":"。\n\n小楼昨夜又东风，故国","type":"text"},{"label":"[3]","noteId":"footnote-11165-3","type":"annotation-ref"},{"text":" 不堪回首月明中。\n\n雕栏玉砌","type":"text"},{"label":"[4]","noteId":"footnote-11165-4","type":"annotation-ref"},{"text":"应犹在，只是朱颜改","type":"text"},{"label":"[5]","noteId":"footnote-11165-5","type":"annotation-ref"},{"text":"。\n\n问君能有几多","type":"text"},{"label":"[6]","noteId":"footnote-11165-6","type":"annotation-ref"},{"text":"愁，恰似一江春水向东流。","type":"text"}],"type":"paragraph"},{"type":"divider"},{"blocks":[{"runs":[{"text":"李煜的这首词，将俘囚生活的幽怨、月夜听风的无眠、物是人非的无奈、愁怀难解的悲凉，以及对往日帝王生活的怀想，编织在一起，将亡国之痛、故国之思寄寓其中。词人通过具体的物象，把抽象的愁绪具象化，如“问君能有几多愁，恰似一江春水向东流”，千古流传，引发了不同时代人们的感叹，诵读时要细加品味。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"frontMatter":[{"blocks":[{"runs":[{"text":"选自《南唐二主词校订》（中华书局2007 年版）。虞美人，词牌名。李煜（937—978），字重光，徐州（今属江苏）人，南唐后主，世称李后主。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"guidance":[],"links":[],"media":[],"sourceOnlyBlocks":[],"sourcePostId":"11165-3","sourcePostNumber":1},"mediaReceiptLedgerSha256":"0319bd9f7623eb57ee396cafc0343cb6c4dc51dce258109a19edbdddd91be71c","mediaReceiptLedgerVersion":"2026-08-09.1","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11165-1","postId":"11165-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11165-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11165-2","postId":"11165-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11165-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11165-3","postId":"11165-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11165-3","text":"[3]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11165-4","postId":"11165-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11165-4","text":"[4]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11165-5","postId":"11165-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11165-5","text":"[5]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11165-6","postId":"11165-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11165-6","text":"[6]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11165-1","postId":"11165-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11165-1","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11165-2","postId":"11165-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11165-2","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11165-3","postId":"11165-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11165-3","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11165-4","postId":"11165-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11165-4","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11165-5","postId":"11165-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11165-5","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11165-6","postId":"11165-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11165-6","text":"↩︎","title":null}],"media":[],"posts":[{"cookedSha256":"88999ae5b7004f552994e4d5a86ab89dcfe3c106f300c0a3fe1ae16a89bd90e7","createdAt":"2024-08-21T16:02:59Z","plainTextSha256":"94aa5766769316e1a5f13f1f78c7f05b5161edee21d15b738b3bca70a64780ee","postId":"11165-3","postNumber":1,"replyToPostNumber":null,"role":"primary","updatedAt":"2024-08-21T16:02:59Z"}],"roleAuditDecisions":[],"sourceLessonPath":"data/lessons/lesson-1722-p3.json","sourceLessonUpdatedAt":"2024-08-21T16:09:28Z","sourcePostCount":1},"resources":[],"roleAuditSha256":"65654ae8bd58de3c8040438da7fc213c00b7175d6dc82802a995f46c4cdfd4a7","roleAuditVersion":"2026-07-30.2","schemaVersion":"yw-reader-document-v1","supplementary":[],"title":"虞美人（春花秋月何时了）"}
