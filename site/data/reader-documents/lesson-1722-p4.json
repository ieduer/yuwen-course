{"curationManifestSha256":"98e90b3603b34b437bc554810c21f01c4db44d10364211af114d30fde3d67bad","curationVersion":"2026-07-30.2","lessonId":"lesson-1722-p4","main":{"annotations":[{"blocks":[{"runs":[{"text":"纤云弄巧：纤细的云编织出各种巧妙的图案样式，比喻织女制作云锦的手艺高超。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11166-1"},{"blocks":[{"runs":[{"text":"飞星传恨：流星传递分别的愁苦。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11166-2"},{"blocks":[{"runs":[{"text":"银汉迢迢暗度：夜里渡过辽阔的天河。传说每年农历七月七日夜，织女、牛郎借鹊桥越过天河相会。银汉，天河、银河。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11166-3"},{"blocks":[{"runs":[{"text":"金风：秋风。五行学说以秋天与金相配。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11166-4"},{"blocks":[{"runs":[{"text":"胜却：胜过。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11166-5"},{"blocks":[{"runs":[{"text":"佳期：这里指重聚相守的美好时光。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11166-6"},{"blocks":[{"runs":[{"text":"忍顾鹊桥归路：怎么忍心回望由鹊桥回去的路。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11166-7"},{"blocks":[{"runs":[{"text":"朝朝暮暮：指朝夕相守。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11166-8"}],"blocks":[{"type":"divider"},{"runs":[{"text":"《鹊桥仙》","type":"text"}],"type":"paragraph"},{"runs":[{"text":"纤云弄巧","type":"text"},{"label":"[1]","noteId":"footnote-11166-1","type":"annotation-ref"},{"text":"，飞星传恨","type":"text"},{"label":"[2]","noteId":"footnote-11166-2","type":"annotation-ref"},{"text":"，银汉迢迢暗度","type":"text"},{"label":"[3]","noteId":"footnote-11166-3","type":"annotation-ref"},{"text":"。\n\n金风","type":"text"},{"label":"[4]","noteId":"footnote-11166-4","type":"annotation-ref"},{"text":"玉露一相逢，便胜却","type":"text"},{"label":"[5]","noteId":"footnote-11166-5","type":"annotation-ref"},{"text":"人间无数。\n\n柔情似水，佳期","type":"text"},{"label":"[6]","noteId":"footnote-11166-6","type":"annotation-ref"},{"text":"如梦，忍顾鹊桥归路","type":"text"},{"label":"[7]","noteId":"footnote-11166-7","type":"annotation-ref"},{"text":"！\n\n两情若是久长时，又岂在朝朝暮暮","type":"text"},{"label":"[8]","noteId":"footnote-11166-8","type":"annotation-ref"},{"text":"。","type":"text"}],"type":"paragraph"},{"type":"divider"},{"blocks":[{"runs":[{"text":"这首词借鹊桥相会的传说，歌咏忠贞不渝的爱情。词人不认为织女和牛郎聚少离多值得哀怨，因为他们短暂的相会，远胜世人无数次的相聚，时空阻隔反而酿就了他们相会的甜蜜。词人还说，只要彼此情意长久，即使不能朝夕相守，也无须黯然神伤。诵读这首词，体会词人命意的高妙，理解他对爱情的独特见解。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"frontMatter":[{"blocks":[{"runs":[{"text":"选自《淮海居士长短句笺注》卷中（上海古籍出版社2008 年版）。鹊桥仙，词牌名。秦观（1049—1100），字少游，又字太虚，号淮海居士，高邮（今属江苏）人，北宋词人。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"guidance":[],"links":[],"media":[],"sourceOnlyBlocks":[],"sourcePostId":"11166-4","sourcePostNumber":1},"mediaReceiptLedgerSha256":"5487243dd8d14d65dfadc20ed544a999aaa318fc20c291462ea62c69e1eff320","mediaReceiptLedgerVersion":"2026-07-30.2","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11166-1","postId":"11166-4","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11166-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11166-2","postId":"11166-4","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11166-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11166-3","postId":"11166-4","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11166-3","text":"[3]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11166-4","postId":"11166-4","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11166-4","text":"[4]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11166-5","postId":"11166-4","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11166-5","text":"[5]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11166-6","postId":"11166-4","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11166-6","text":"[6]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11166-7","postId":"11166-4","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11166-7","text":"[7]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11166-8","postId":"11166-4","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11166-8","text":"[8]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11166-1","postId":"11166-4","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11166-1","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11166-2","postId":"11166-4","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11166-2","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11166-3","postId":"11166-4","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11166-3","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11166-4","postId":"11166-4","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11166-4","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11166-5","postId":"11166-4","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11166-5","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11166-6","postId":"11166-4","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11166-6","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11166-7","postId":"11166-4","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11166-7","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11166-8","postId":"11166-4","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11166-8","text":"↩︎","title":null}],"media":[],"posts":[{"cookedSha256":"8b4947469dc74604c4aff4d4714752e98f7ccfb58983ed0621b962d1625a2f81","createdAt":"2024-08-21T16:09:28Z","plainTextSha256":"023de4306dbda60198684ad739c2f03312942b61d6a76648c2336bc9d4702b0f","postId":"11166-4","postNumber":1,"replyToPostNumber":null,"role":"primary","updatedAt":"2024-08-21T16:09:28Z"}],"roleAuditDecisions":[],"sourceLessonPath":"data/lessons/lesson-1722-p4.json","sourceLessonUpdatedAt":"2024-08-21T16:09:28Z","sourcePostCount":1},"resources":[],"roleAuditSha256":"65654ae8bd58de3c8040438da7fc213c00b7175d6dc82802a995f46c4cdfd4a7","roleAuditVersion":"2026-07-30.2","schemaVersion":"yw-reader-document-v1","supplementary":[],"title":"鹊桥仙（纤云弄巧）"}
