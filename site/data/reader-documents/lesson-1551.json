{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1551","main":{"annotations":[],"blocks":[{"blocks":[{"runs":[{"text":"《普通高中教科书 语文》由教育部组织编写，北京大学温儒敏教授担任总主编，经国家教材委员会审核通过。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"国家教材委员会委员、国家教材委员会语文学科专家委员会和思想政治审议专家委员会委员及有关专家，对教科书的编写与修改完善给予了悉心指导和严格把关，提出了很多宝贵的意见建议。北京、天津、上海、浙江、山东、河南、四川、宁夏、新疆、海南等省（自治区、直辖市）教育科学研究院（所）、教研室及部分学校参加教科书的试教试用，为教科书的修改完善提出了很好的意见建议。余党绪、韩涵、陈恒舒、曹晛等同志参与了部分教材编写工作。同时，教科书还征求了许多专家学者和广大一线教师的意见。在此，向各位专家和教师表示感谢。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"人民教育出版社承担了教科书的编辑出版工作，在组织编写、排版印制、试教试用等方面给予了全方位的协助。中学语文编辑室王本华、朱于国为全套教科书的编写修改做了大量统筹协调工作。吕敬人等为本套教科书的整体设计提供了艺术指导，房海莹承担本书的美术设计工作。此外，在教科书编写、编辑出版过程中，还有很多业界同仁和社会各界朋友都提供过帮助，在此一并表示诚挚的谢意。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"真诚希望广大师生、家长提出宝贵意见，我们将集思广益，不断修订，使教科书趋于完善。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"联系方式","type":"text"}],"type":"paragraph"},{"runs":[{"text":"电话：010-58758620","type":"text"}],"type":"paragraph"},{"runs":[{"text":"电子邮箱：jcfk@pep.com.cn","type":"text"}],"type":"paragraph"},{"runs":[{"text":"编者","type":"text"}],"type":"paragraph"},{"runs":[{"text":"2020 年7 月","type":"text"}],"type":"paragraph"}],"type":"quote"},{"runs":[{"text":"《普通高中教科书 语文》由教育部组织编写，北京大学温儒敏教授担任总主编，2019 年经国家教材委员会审核通过。\n\n国家教材委员会委员、国家教材委员会语文学科专家委员会和思想政治审议专家委员会委员及有关专家，对教科书的编写与修改完善给予了悉心指导和严格把关，提出了很多宝贵的意见建议。北京、天津、上海、浙江、山东、河南、四川、宁夏、新疆、海南等省（自治区、直辖市）教育科学研究院（所）、教研室及部分学校参加教科书的试教试用，为教科书的修改完善提出了很好的意见建议。余党绪、韩涵、陈恒舒、曹晛等同志参与了部分教材编写工作。同时，教科书还征求了许多专家学者和广大一线教师的意见。在此，向各位专家和教师表示感谢。\n\n人民教育出版社承担了教科书的编辑出版工作，在组织编写、排版印制、试教试用等方面给予了全方位的协助。中学语文编辑室王本华、朱于国为全套教科书的编写修改做了大量统筹协调工作。房海莹承担本书的美术设计工作。此外，在教科书编写、编辑出版过程中，还有很多业界同仁和社会各界朋友都提供过帮助，在此一并表示诚挚的谢意。\n\n教科书投入使用后，我们根据各方意见作了修订，真诚希望广大师生和家长继续提出宝贵意见！","type":"text"}],"type":"paragraph"},{"runs":[{"text":"联系方式\n\n电话：010-58758626\n\n电子邮箱：jcfk@pep.com.cn","type":"text"}],"type":"paragraph"},{"runs":[{"text":"编者\n\n2023 年7 月","type":"text"}],"type":"paragraph"}],"frontMatter":[],"guidance":[],"links":[{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/xbz000/%e5%90%8e-%e8%ae%b0","sourceUrl":"https://sites.google.com/view/pkuschool/xbz000/%e5%90%8e-%e8%ae%b0","text":"https://sites.google.com/view/pkuschool/xbz000/%e5%90%8e-%e8%ae%b0","title":null}],"media":[],"sourceOnlyBlocks":[],"sourcePostId":10381,"sourcePostNumber":1},"mediaReceiptLedgerSha256":"0319bd9f7623eb57ee396cafc0343cb6c4dc51dce258109a19edbdddd91be71c","mediaReceiptLedgerVersion":"2026-08-09.1","provenance":{"links":[{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/xbz000/%e5%90%8e-%e8%ae%b0","postId":10381,"postNumber":1,"postRole":"primary","sourceUrl":"https://sites.google.com/view/pkuschool/xbz000/%e5%90%8e-%e8%ae%b0","text":"https://sites.google.com/view/pkuschool/xbz000/%e5%90%8e-%e8%ae%b0","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#p-10384-h-1","postId":10384,"postNumber":4,"postRole":"discussion","sourceUrl":"https://forum.rdfzer.com/#p-10384-h-1","text":"#p-10384-h-1","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#p-10386-h-1","postId":10386,"postNumber":6,"postRole":"discussion","sourceUrl":"https://forum.rdfzer.com/#p-10386-h-1","text":"#p-10386-h-1","title":null}],"media":[{"alt":":sweat_smile:","bytes":null,"height":20,"id":"media-3413e829616feaa6d7e9","mediaType":"image/png","nativeDisposition":"blocked-missing-receipt","postId":10386,"postNumber":6,"postRole":"discussion","receiptRequired":true,"sha256":null,"sourceUrl":"https://forum.rdfzer.com/images/emoji/apple/sweat_smile.png?v=15","webDisposition":"source-url","width":20},{"alt":":flexed_biceps:","bytes":null,"height":20,"id":"media-9d34750c5554b17a3830","mediaType":"image/png","nativeDisposition":"blocked-missing-receipt","postId":10386,"postNumber":6,"postRole":"discussion","receiptRequired":true,"sha256":null,"sourceUrl":"https://forum.rdfzer.com/images/emoji/