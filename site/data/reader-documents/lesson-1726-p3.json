{"curationManifestSha256":"98e90b3603b34b437bc554810c21f01c4db44d10364211af114d30fde3d67bad","curationVersion":"2026-07-30.2","lessonId":"lesson-1726-p3","main":{"annotations":[{"blocks":[{"runs":[{"text":"选自《庄子·养生主》（《庄子集释》，中华书局2004年版）。题目是编者加的。庖丁，名为“丁”的厨师。一说即厨师，“丁”指从事专门劳动的人。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-1"},{"blocks":[{"runs":[{"text":"文惠君：即梁惠王，战国时魏国国君。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-2"},{"blocks":[{"runs":[{"text":"所触：接触的地方。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-3"},{"blocks":[{"runs":[{"text":"履：踩。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-4"},{"blocks":[{"runs":[{"text":"踦（yǐ）：抵住，指宰牛之时用膝盖抵住牛。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-5"},{"blocks":[{"runs":[{"text":"砉（xū）然向（xiǎng）然：砉砉作响。砉，拟声词，皮肉筋骨分离的声音。向，同“响”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-6"},{"blocks":[{"runs":[{"text":"奏刀然：进刀时发出“然”的声音。奏，进。然，拟声词，插刀裂物的声音。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-7"},{"blocks":[{"runs":[{"text":"中（zhòng）音：合乎音律。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-8"},{"blocks":[{"runs":[{"text":"合于《桑林》之舞：合乎《桑林》舞乐的节拍。《桑林》，传说中商汤时的乐曲名。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-9"},{"blocks":[{"runs":[{"text":"乃中《经首》之会：又合乎《经首》乐曲的节奏。《经首》，传说中尧时的乐曲名。乃，又。会，节奏。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-10"},{"blocks":[{"runs":[{"text":"盖：同“盍”，何、怎么。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-11"},{"blocks":[{"runs":[{"text":"道：天道，自然的规律。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-12"},{"blocks":[{"runs":[{"text":"进乎技矣：超过技术了。进，超过。技，具体的操作技术。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-13"},{"blocks":[{"runs":[{"text":"无非牛者：没有不是（完整的）牛的。意思是跟一般人所见的一样。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-14"},{"blocks":[{"runs":[{"text":"未尝见全牛也：未曾看到完整的牛了。这是说对牛的全身结构完全摸清了，不再把一头牛看成全牛，而是把它看成可以拆解的东西。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-15"},{"blocks":[{"runs":[{"text":"臣以神遇而不以目视：我只用精神去和牛接触，而不用眼睛去看。遇，接触。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-16"},{"blocks":[{"runs":[{"text":"官知止而神欲行：感觉器官的作用停止了，而精神在活动。意思是，解牛时可以不用感觉器官，而只靠精神活动来行事。神欲，精神活动。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-17"},{"blocks":[{"runs":[{"text":"天理：这里指牛体的自然结构。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-18"},{"blocks":[{"runs":[{"text":"批大郤（xì）：击入大的（筋骨连接处的）缝隙。批，击。郤，同“隙”，空隙。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-19"},{"blocks":[{"runs":[{"text":"导大窾（kuǎn）：引刀进入（骨节之间的）空处。导，引导，这里指引刀进入。窾，空隙。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-20"},{"blocks":[{"runs":[{"text":"因其固然：顺着牛体本来的结构。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-21"},{"blocks":[{"runs":[{"text":"技经肯綮（qìng）之未尝：脉络相连和筋骨相结合的地方，不曾拿刀去尝试。意思是，用刀的技术高超，从不经过容易使刀口钝折的地方。技，应是“枝”字，指支脉。经，指经脉。肯，附在骨上的肉。綮，筋骨结合处。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-22"},{"blocks":[{"runs":[{"text":"：大骨。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-23"},{"blocks":[{"runs":[{"text":"更：更换。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-24"},{"blocks":[{"runs":[{"text":"割：割肉。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-25"},{"blocks":[{"runs":[{"text":"族庖：一般的厨师。族，众。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-26"},{"blocks":[{"runs":[{"text":"折：断，指用刀砍断骨头。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-27"},{"blocks":[{"runs":[{"text":"新发于硎（xíng）：刚从磨刀石上磨出来。硎，磨刀石。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-28"},{"blocks":[{"runs":[{"text":"彼节者有间（jiàn）：那牛骨节间有空隙。间，空隙。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-29"},{"blocks":[{"runs":[{"text":"无厚：没有厚度。这里形容刀口薄。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-30"},{"blocks":[{"runs":[{"text":"恢恢乎：宽绰的样子。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-31"},{"blocks":[{"runs":[{"text":"族：筋骨交错聚结的地方。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-32"},{"blocks":[{"runs":[{"text":"怵（chù）然：戒惧的样子。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-33"},{"blocks":[{"runs":[{"text":"视为止，行为迟：眼睛因为（筋骨交错聚结的地方）而凝视不动，动作也因此慢下来。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-34"},{"blocks":[{"runs":[{"text":"微：轻。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-35"},{"blocks":[{"runs":[{"text":"謋（huò）：拟声词，迅速裂开的声音。这里形容骨与肉分开的声音。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-36"},{"blocks":[{"runs":[{"text":"委：散落，卸落。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-37"},{"blocks":[{"runs":[{"text":"踌躇满志：悠然自得，心满意足。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-38"},{"blocks":[{"runs":[{"text":"善：这里指揩拭。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-39"},{"blocks":[{"runs":[{"text":"养生：指养生之道。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11172-40"}],"blocks":[{"runs":[{"text":"庖丁解牛","type":"text"},{"label":"[1]","noteId":"footnote-11172-1","type":"annotation-ref"},{"text":"\n\n《庄子》","type":"text"}],"type":"paragraph"},{"runs":[{"text":"庖丁为文惠君","type":"text"},{"label":"[2]","noteId":"footnote-11172-2","type":"annotation-ref"},{"text":"解牛，手之所触","type":"text"},{"label":"[3]","noteId":"footnote-11172-3","type":"annotation-ref"},{"text":"，肩之所倚，足之所履","type":"text"},{"label":"[4]","noteId":"footnote-11172-4","type":"annotation-ref"},{"text":"，膝之所踦","type":"text"},{"label":"[5]","noteId":"footnote-11172-5","type":"annotation-ref"},{"text":"，砉然向然","type":"text"},{"label":"[6]","noteId":"footnote-11172-6","type":"annotation-ref"},{"text":"，奏刀然","type":"text"},{"label":"[7]","noteId":"footnote-11172-7","type":"annotation-ref"},{"text":"，莫不中音","type":"text"},{"label":"[8]","noteId":"footnote-11172-8","type":"annotation-ref"},{"text":"。合于《桑林》之舞","type":"text"},{"label":"[9]","noteId":"footnote-11172-9","type":"annotation-ref"},{"text":"，乃中《经首》之会","type":"text"},{"label":"[10]","noteId":"footnote-11172-10","type":"annotation-ref"},{"text":"。\n\n文惠君曰：“嘻，善哉！技盖","type":"text"},{"label":"[11]","noteId":"footnote-11172-11","type":"annotation-ref"},{"text":"至此乎？”\n\n庖丁释刀对曰：“臣之所好者道","type":"text"},{"label":"[12]","noteId":"footnote-11172-12","type":"annotation-ref"},{"text":"也，进乎技矣","type":"text"},{"label":"[13]","noteId":"footnote-11172-13","type":"annotation-ref"},{"text":"。始臣之解牛之时，所见无非牛者","type":"text"},{"label":"[14]","noteId":"footnote-11172-14","type":"annotation-ref"},{"text":"；三年之后 ，未尝见全牛也","type":"text"},{"label":"[15]","noteId":"footnote-11172-15","type":"annotation-ref"},{"text":"。方今之时，臣以神遇而不以目视","type":"text"},{"label":"[16]","noteId":"footnote-11172-16","type":"annotation-ref"},{"text":"，官知止而神欲行","type":"text"},{"label":"[17]","noteId":"footnote-11172-17","type":"annotation-ref"},{"text":"。依乎天理","type":"text"},{"label":"[18]","noteId":"footnote-11172-18","type":"annotation-ref"},{"text":"，批大郤","type":"text"},{"label":"[19]","noteId":"footnote-11172-19","type":"annotation-ref"},{"text":"，导大窾","type":"text"},{"label":"[20]","noteId":"footnote-11172-20","type":"annotation-ref"},{"text":"，因其固然","type":"text"},{"label":"[21]","noteId":"footnote-11172-21","type":"annotation-ref"},{"text":"，技经肯綮之未尝","type":"text"},{"label":"[22]","noteId":"footnote-11172-22","type":"annotation-ref"},{"text":"，而况大","type":"text"},{"label":"[23]","noteId":"footnote-11172-23","type":"annotation-ref"},{"text":"乎！良庖岁更","type":"text"},{"label":"[24]","noteId":"footnote-11172-24","type":"annotation-ref"},{"text":"刀，割","type":"text"},{"label":"[25]","noteId":"footnote-11172-25","type":"annotation-ref"},{"text":"也；族庖","type":"text"},{"label":"[26]","noteId":"footnote-11172-26","type":"annotation-ref"},{"text":"月更刀，折","type":"text"},{"label":"[27]","noteId":"footnote-11172-27","type":"annotation-ref"},{"text":"也。今臣之刀十九年矣，所解数千牛矣，而刀刃若新发于硎","type":"text"},{"label":"[28]","noteId":"footnote-11172-28","type":"annotation-ref"},{"text":"。彼节者有间","type":"text"},{"label":"[29]","noteId":"footnote-11172-29","type":"annotation-ref"},{"text":"，而刀刃者无厚","type":"text"},{"label":"[30]","noteId":"footnote-11172-30","type":"annotation-ref"},{"text":"；以无厚入有间，恢恢乎","type":"text"},{"label":"[31]","noteId":"footnote-11172-31","type":"annotation-ref"},{"text":"其于游刃必有余地矣！是以十九年而刀刃若新发于硎。虽然，每至于族","type":"text"},{"label":"[32]","noteId":"footnote-11172-32","type":"annotation-ref"},{"text":"，吾见其难为，怵然","type":"text"},{"label":"[33]","noteId":"footnote-11172-33","type":"annotation-ref"},{"text":"为戒，视为止，行为迟","type":"text"},{"label":"[34]","noteId":"footnote-11172-34","type":"annotation-ref"},{"text":"，动刀甚微","type":"text"},{"label":"[35]","noteId":"footnote-11172-35","type":"annotation-ref"},{"text":"。謋","type":"text"},{"label":"[36]","noteId":"footnote-11172-36","type":"annotation-ref"},{"text":"然已解，如土委","type":"text"},{"label":"[37]","noteId":"footnote-11172-37","type":"annotation-ref"},{"text":"地。提刀而立，为之四顾，为之踌躇满志","type":"text"},{"label":"[38]","noteId":"footnote-11172-38","type":"annotation-ref"},{"text":"，善","type":"text"},{"label":"[39]","noteId":"footnote-11172-39","type":"annotation-ref"},{"text":"刀而藏之。”\n\n文惠君曰：“善哉！吾闻庖丁之言，得养生","type":"text"},{"label":"[40]","noteId":"footnote-11172-40","type":"annotation-ref"},{"text":"焉。”","type":"text"}],"type":"paragraph"}],"frontMatter":[],"guidance":[],"links":[],"media":[],"sourceOnlyBlocks":[],"sourcePostId":"11172-3","sourcePostNumber":1},"mediaReceiptLedgerSha256":"5487243dd8d14d65dfadc20ed544a999aaa318fc20c291462ea62c69e1eff320","mediaReceiptLedgerVersion":"2026-07-30.2","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11172-1","postId":"11172-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11172-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11172-2","postId":"11172-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11172-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11172-3","postId":"11172-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11172-3","text":"[3]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11172-4","postId":"11172-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11172-4","text":"[4]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11172-5","postId":"11172-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11172-5","text":"[5]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11172-6","postId":"11172-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11172-6","text":"[6]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11172-7","postId":"11172-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11172-7","text":"[7]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11172-8","postId":"11172-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11172-8","text":"[8]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11172-9","postId":"11172-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11172-9","text":"[9]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11172-10","postId":"11172-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11172-10","text":"[10]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11172-11","postId":"11172-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11172-11","text":"[11]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11172-12","postId":"11172-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11172-12","text":"[12]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11172-13","postId":"11172-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11172-13","text":"[13]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11172-14","postId":"11172-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11172-14","text":"[14]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11172-15","postId":"11172-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11172-15","text":"[15]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11172-16","postId":"11172-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11172-16","text":"[16]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11172-17","postId":"11172-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11172-17","text":"[17]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11172-18","postId":"11172-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11172-18","text":"[18]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11172-19","postId":"11172-3","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11172-19","text":"[19]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11172-20","postId":"11172-3","postNumber":1,"postRole":"primary","sourceUrl":"https:/