{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1727","main":{"annotations":[{"blocks":[{"runs":[{"text":"节选自《左传·僖公三十年》（《春秋左传注》，中华书局1990年版）。题目是编者加的。烛之武，郑国大夫。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-1"},{"blocks":[{"runs":[{"text":"晋侯、秦伯：指晋文公和秦穆公。秦穆公（？—前621），名任好，秦国国君，春秋五霸之一。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-2"},{"blocks":[{"runs":[{"text":"无礼于晋：指晋文公早年出亡经过郑国时，郑国没有以应有的礼遇对待他。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-3"},{"blocks":[{"runs":[{"text":"贰于楚：指郑国依附于晋的同时又亲附于楚。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-4"},{"blocks":[{"runs":[{"text":"晋军函陵：晋军驻扎在函陵。军，驻扎。函陵，郑国地名，在今河南新郑北。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-5"},{"blocks":[{"runs":[{"text":"氾（fán）南：氾水的南面，也属郑地。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-6"},{"blocks":[{"runs":[{"text":"佚（yì）之狐：郑国大夫。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-7"},{"blocks":[{"runs":[{"text":"郑伯：指郑文公（？—前628），名捷，郑国国君。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-8"},{"blocks":[{"runs":[{"text":"壮：壮年。古时男子三十为“壮”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-9"},{"blocks":[{"runs":[{"text":"犹：尚且。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-10"},{"blocks":[{"runs":[{"text":"无能为也已：不能干什么了。也已，语气助词，表示确定。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-11"},{"blocks":[{"runs":[{"text":"许：答应。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-12"},{"blocks":[{"runs":[{"text":"缒（zhuì）：用绳子拴着人（或物）从上往下送。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-13"},{"blocks":[{"runs":[{"text":"既：已经。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-14"},{"blocks":[{"runs":[{"text":"敢以烦执事：冒昧地用（亡郑这件事）麻烦您。敢，自言冒昧的谦辞。执事，办事的官员，代指对方（秦穆公），表示恭敬。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-15"},{"blocks":[{"runs":[{"text":"越国以鄙远：越过别国而把远地当作边邑。国，指晋国，地处秦、郑之间。鄙，边邑，这里用作动词。远，指郑国。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-16"},{"blocks":[{"runs":[{"text":"焉用亡郑以陪邻：哪里用得着灭掉郑国而给邻国增加土地呢？陪，增加。邻，邻国，指晋国。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-17"},{"blocks":[{"runs":[{"text":"邻之厚，君之薄也：邻国的势力雄厚了，您秦国的势力（就）相对削弱了。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-18"},{"blocks":[{"runs":[{"text":"若舍郑以为东道主：如果（您）放弃（围攻）郑国而把它作为东方道路上（招待过客）的主人。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-19"},{"blocks":[{"runs":[{"text":"行李：外交使者。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-20"},{"blocks":[{"runs":[{"text":"共（gōng）其乏困：供给他们缺少的资粮。共，同“供”，供给。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-21"},{"blocks":[{"runs":[{"text":"尝为晋君赐矣：曾经给予晋君恩惠。为，给予。赐，恩惠。这里指秦穆公曾派兵护送晋惠公回国的事。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-22"},{"blocks":[{"runs":[{"text":"许君焦、瑕：（晋惠公）答应给您焦、瑕这两个地方。焦、瑕，均在今河南三门峡一带。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-23"},{"blocks":[{"runs":[{"text":"朝济而夕设版焉：指晋惠公早上渡过黄河回国，晚上就修筑防御工事。济，渡河。设版，修筑防御工事。版，指版筑的工事。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-24"},{"blocks":[{"runs":[{"text":"既东封郑：在东边使郑国成为它的边境之后。封，疆界，这里用作动词。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-25"},{"blocks":[{"runs":[{"text":"肆其西封：扩张它西边的疆界。意思是，晋国灭了郑国以后，必将进攻秦国。肆，延伸、扩张。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-26"},{"blocks":[{"runs":[{"text":"阙（quē）秦：使秦国土地减少。阙，侵损、削减。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-27"},{"blocks":[{"runs":[{"text":"将焉取之：将从哪里取得它所贪求的土地呢？焉，从哪里。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-28"},{"blocks":[{"runs":[{"text":"唯君图之：希望您考虑这件事。唯，表示希望、祈请。之，指“阙秦以利晋”这件事。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-29"},{"blocks":[{"runs":[{"text":"杞子、逢（páng）孙、杨孙：三人都是秦国的大夫。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-30"},{"blocks":[{"runs":[{"text":"子犯：晋国大夫狐偃（晋文公的舅舅），字子犯。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-31"},{"blocks":[{"runs":[{"text":"公：指晋文公。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-32"},{"blocks":[{"runs":[{"text":"微夫（fú）人之力不及此：没有那个人的力量，我是到不了这个地位的。晋文公曾在外流亡十九年，得到秦穆公的帮助才回到晋国做了国君。微，没有。夫人，那个人，指秦穆公。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-33"},{"blocks":[{"runs":[{"text":"因人之力而敝之，不仁：依靠别人的力量，又反过来损害他，这是不仁义的。因，依靠。敝，损害。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-34"},{"blocks":[{"runs":[{"text":"失其所与，不知（zhì）：失掉自己的同盟者，这是不明智的。与，结交、同盟。知，同“智”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-35"},{"blocks":[{"runs":[{"text":"以乱易整，不武：用混乱相攻取代和谐一致，这是不符合武德的。武，指使用武力时所应遵守的道义准则。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-36"},{"blocks":[{"runs":[{"text":"吾其还也：我们还是回去吧。其，表示祈使。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11174-37"}],"blocks":[{"runs":[{"text":"烛之武退秦师","type":"text"},{"label":"[1]","noteId":"footnote-11174-1","type":"annotation-ref"},{"text":"\n\n《左传》","type":"text"}],"type":"paragraph"},{"runs":[{"text":"春秋列国形势简图（前630 年）","type":"text"}],"type":"paragraph"},{"runs":[{"text":"晋侯、秦伯","type":"text"},{"label":"[2]","noteId":"footnote-11174-2","type":"annotation-ref"},{"text":"围郑，以其无礼于晋","type":"text"},{"label":"[3]","noteId":"footnote-11174-3","type":"annotation-ref"},{"text":"，且贰于楚","type":"text"},{"label":"[4]","noteId":"footnote-11174-4","type":"annotation-ref"},{"text":"也。晋军函陵","type":"text"},{"label":"[5]","noteId":"footnote-11174-5","type":"annotation-ref"},{"text":"，秦军氾南","type":"text"},{"label":"[6]","noteId":"footnote-11174-6","type":"annotation-ref"},{"text":"。\n\n佚之狐","type":"text"},{"label":"[7]","noteId":"footnote-11174-7","type":"annotation-ref"},{"text":"言于郑伯","type":"text"},{"label":"[8]","noteId":"footnote-11174-8","type":"annotation-ref"},{"text":"曰：“国危矣，若使烛之武见秦君，师必退。”\n\n公从之。辞曰：“臣之壮","type":"text"},{"label":"[9]","noteId":"footnote-11174-9","type":"annotation-ref"},{"text":"也，犹","type":"text"},{"label":"[10]","noteId":"footnote-11174-10","type":"annotation-ref"},{"text":"不如人；今老矣，无能为也已","type":"text"},{"label":"[11]","noteId":"footnote-11174-11","type":"annotation-ref"},{"text":"。”\n\n公曰：“吾不能早用子，今急而求子，是寡人之过也。然郑亡，子亦有不利焉。”许","type":"text"},{"label":"[12]","noteId":"footnote-11174-12","type":"annotation-ref"},{"text":"之。\n\n夜缒","type":"text"},{"label":"[13]","noteId":"footnote-11174-13","type":"annotation-ref"},{"text":"而出，见秦伯，曰：“秦、晋围郑，郑既","type":"text"},{"label":"[14]","noteId":"footnote-11174-14","type":"annotation-ref"},{"text":"知亡矣。若亡郑而有益于君，敢以烦执事","type":"text"},{"label":"[15]","noteId":"footnote-11174-15","type":"annotation-ref"},{"text":"。越国以鄙远","type":"text"},{"label":"[16]","noteId":"footnote-11174-16","type":"annotation-ref"},{"text":"，君知其难也，焉用亡郑以陪邻","type":"text"},{"label":"[17]","noteId":"footnote-11174-17","type":"annotation-ref"},{"text":"？邻之厚，君之薄也","type":"text"},{"label":"[18]","noteId":"footnote-11174-18","type":"annotation-ref"},{"text":"。若舍郑以为东道主","type":"text"},{"label":"[19]","noteId":"footnote-11174-19","type":"annotation-ref"},{"text":"，行李","type":"text"},{"label":"[20]","noteId":"footnote-11174-20","type":"annotation-ref"},{"text":"之往来，共其乏困","type":"text"},{"label":"[21]","noteId":"footnote-11174-21","type":"annotation-ref"},{"text":"，君亦无所害。且君尝为晋君赐矣","type":"text"},{"label":"[22]","noteId":"footnote-11174-22","type":"annotation-ref"},{"text":"，许君焦、瑕","type":"text"},{"label":"[23]","noteId":"footnote-11174-23","type":"annotation-ref"},{"text":"，朝济而夕设版焉","type":"text"},{"label":"[24]","noteId":"footnote-11174-24","type":"annotation-ref"},{"text":"，君之所知也。夫晋，何厌之有？既东封郑","type":"text"},{"label":"[25]","noteId":"footnote-11174-25","type":"annotation-ref"},{"text":"，又欲肆其西封","type":"text"},{"label":"[26]","noteId":"footnote-11174-26","type":"annotation-ref"},{"text":"，若不阙秦","type":"text"},{"label":"[27]","noteId":"footnote-11174-27","type":"annotation-ref"},{"text":"，将焉取之","type":"text"},{"label":"[28]","noteId":"footnote-11174-28","type":"annotation-ref"},{"text":"？阙秦以利晋，唯君图之","type":"text"},{"label":"[29]","noteId":"footnote-11174-29","type":"annotation-ref"},{"text":"。”秦伯说，与郑人盟。使杞子、逢孙、杨孙","type":"text"},{"label":"[30]","noteId":"footnote-11174-30","type":"annotation-ref"},{"text":"戍之，乃还。\n\n子犯","type":"text"},{"label":"[31]","noteId":"footnote-11174-31","type":"annotation-ref"},{"text":"请击之。公","type":"text"},{"label":"[32]","noteId":"footnote-11174-32","type":"annotation-ref"},{"text":"曰：“不可。微夫人之力不及此","type":"text"},{"label":"[33]","noteId":"footnote-11174-33","type":"annotation-ref"},{"text":"。因人之力而敝之，不仁","type":"text"},{"label":"[34]","noteId":"footnote-11174-34","type":"annotation-ref"},{"text":"；失其所与，不知","type":"text"},{"label":"[35]","noteId":"footnote-11174-35","type":"annotation-ref"},{"text":"；以乱易整，不武","type":"text"},{"label":"[36]","noteId":"footnote-11174-36","type":"annotation-ref"},{"text":"。吾其还也","type":"text"},{"label":"[37]","noteId":"footnote-11174-37","type":"annotation-ref"},{"text":"。”亦去之。","type":"text"}],"type":"paragraph"},{"blocks":[{"runs":[{"text":"春秋时期，诸侯争霸，一度形成分别以晋、楚为首的两大阵营。“千乘之国”郑国遭遇秦、晋两强夹攻，看一看历史地图，了解郑国当时的处境。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"本文的核心部分是烛之武游说秦穆公的外交辞令。烛之武以一己之力，成功说服秦国撤军，瓦解了秦、晋对郑国的围困。前人说“烛之武一言，贤于十万师”（谢有辉《古文赏音》），并非过誉。要反复诵读，理清思路，揣摩人物情态，体会对话语气，把握烛之武说辞的语言艺术和其中蕴含的智慧。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"此外，还要注意郑文公、晋文公的话，领会其中体现出来的人物特点。《左传》是编年体史书，以时为经，以事为纬。学习本文时，可关注在烛之武退秦师前后发生的事，更全面、准确地把握文章的内容。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"史书以记事为本，在历史叙述中也常透露出一些思想、观念。《左传》重视“礼”。秦、晋围郑是因为其“无礼”，晋文公认为进攻秦军是“不仁”“不知”“不武”的，因而被古人赞为“有礼”。该如何理解这里说的“礼”？秦先与晋联合围郑，后又“与郑人盟”，秦的行为合乎“礼”吗？","type":"text"}],"type":"paragraph"},{"runs":[{"text":"思考这类问题，对春秋时期军事、外交活动中的行为准则会有更深入的认识。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"frontMatter":[],"guidance":[],"links":[],"media":[{"alt":"","bytes":125632,"finalUrl":"https://files.rdfzer.com/original/2X/b/b1e7fe6606bd7369b7cd3c43c0e49c520fc6f0b7.jpeg","height":811,"id":"media-74fa3fe3177d51642f2d","mediaType":"image/jpeg","nativeDisposition":"verified-in-app","receiptCollectedAt":"2026-07-30T01:10:43.464Z","receiptRequired":true,"rightsBasis":"user-authorized-course-source-use-2026-07-29","sha256":"1e863545baca0895b360fbb69610f464af93154019df90d3cb7efe396406b4ac","sourceUrl":"https://files.rdfzer.com/original/2X/b/b1e7fe6606bd7369b7cd3c43c0e49c520fc6f0b7.jpeg","webDisposition":"source-url","width":968}],"sourceOnlyBlocks":[],"sourcePostId":11174,"sourcePostNumber":1},"mediaReceiptLedgerSha256":"0319bd9f7623eb57ee396cafc0343cb6c4dc51dce258109a19edbdddd91be71c","mediaReceiptLedgerVersion":"2026-08-09.1","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11174-1","postId":11174,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11174-1","text":"[1]","title":null},{"disposition":"system-browser","href":"https://files.rdfzer.com/original/2X/b/b1e7fe6606bd7369b7cd3c43c0e49c520fc6f0b7.jpeg","postId":11174,"postNumber":1,"postRole":"primary","sourceUrl":"https://files.rdfzer.com/original/2X/b/b1e7fe6606bd7369b7cd3c43c0e49c520fc6f0b7.jpeg","text":"https://files.rdfzer.com/original/2X/b/b1e7fe6606bd7369b7cd3c43c0e49c520fc6f0b7.jpeg","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11174-2","postId":11174,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11174-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11174-3","postId":11174,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11174-3","text":"[3]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11174-4","postId":11174,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11174-4","text":"[4]","title":null},{"disposition":"internal","href":"https://forum.