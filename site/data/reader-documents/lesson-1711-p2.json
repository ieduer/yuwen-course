{"curationManifestSha256":"98e90b3603b34b437bc554810c21f01c4db44d10364211af114d30fde3d67bad","curationVersion":"2026-07-30.2","lessonId":"lesson-1711-p2","main":{"annotations":[{"blocks":[{"runs":[{"text":"选自《韩昌黎文集校注》卷一（上海古籍出版社1986 年版）。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-1"},{"blocks":[{"runs":[{"text":"学者：求学的人。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-2"},{"blocks":[{"runs":[{"text":"师者，所以传道受业解惑也：老师，是依靠他来传授道、教授学业、解除疑惑的人。所以，用来……的、凭它（他）来……的。受，同“授”，传授。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-3"},{"blocks":[{"runs":[{"text":"生而知之：生下来就懂得知识和道理。之，指知识和道理。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-4"},{"blocks":[{"runs":[{"text":"其为惑也：它们作为疑惑。其，它们，指不跟从老师学习而遗留下的问题。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-5"},{"blocks":[{"runs":[{"text":"闻：知道，懂得。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-6"},{"blocks":[{"runs":[{"text":"从而师之：跟随他学习，即以他为老师。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-7"},{"blocks":[{"runs":[{"text":"吾师道也：我学习的是道。师，学习。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-8"},{"blocks":[{"runs":[{"text":"夫庸知其年之先后生于吾乎：哪管他是生在我之前还是生在我之后呢？庸，表示反问语气。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-9"},{"blocks":[{"runs":[{"text":"无贵无贱：意思是就从师问道来说，没有贵和贱的区分。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-10"},{"blocks":[{"runs":[{"text":"道之所存，师之所存也：道存在的地方，就是老师在的地方。意思是谁懂得道，谁就是自己的老师。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-11"},{"blocks":[{"runs":[{"text":"师道：尊师学习的风尚。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-12"},{"blocks":[{"runs":[{"text":"出人：超出一般人。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-13"},{"blocks":[{"runs":[{"text":"犹且：尚且，还。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-14"},{"blocks":[{"runs":[{"text":"众人：一般人。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-15"},{"blocks":[{"runs":[{"text":"圣益圣，愚益愚：圣人更加圣明，愚人更加愚昧。益，更加、越发。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-16"},{"blocks":[{"runs":[{"text":"身：自己。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-17"},{"blocks":[{"runs":[{"text":"耻师：以从师学习为耻。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-18"},{"blocks":[{"runs":[{"text":"惑：糊涂。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-19"},{"blocks":[{"runs":[{"text":"童子：未成年的男子。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-20"},{"blocks":[{"runs":[{"text":"授之书而习其句读：教给他书本的文字，（帮助他）学习句读。句读，指断开句子的知识。一句话后面的停顿为句，一句话中间短暂的停顿为读。古书没有标点，所以要学习句读。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-21"},{"blocks":[{"runs":[{"text":"句读之不知：不明句读。下文“惑之不解”结构同此。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-22"},{"blocks":[{"runs":[{"text":"或师焉，或不焉：有的向老师学习，有的不向老师学习。前一个“或”指代“句读之不知”，后一个“或”指代“惑之不解”。不，同“否”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-23"},{"blocks":[{"runs":[{"text":"小学而大遗：小的方面要学习，大的方面却放弃了。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-24"},{"blocks":[{"runs":[{"text":"巫医：古代巫和医不分，故并举。巫主要以祝祷、占卜等为业，也为人治病。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-25"},{"blocks":[{"runs":[{"text":"乐师：以演奏音乐为职业的人。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-26"},{"blocks":[{"runs":[{"text":"百工：泛指各种工匠。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-27"},{"blocks":[{"runs":[{"text":"不耻相师：不以拜别人为师为耻。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-28"},{"blocks":[{"runs":[{"text":"族：类。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-29"},{"blocks":[{"runs":[{"text":"曰师曰弟子云者：说谁是谁的老师、谁是谁的学生之类的话。云者，如此之类。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-30"},{"blocks":[{"runs":[{"text":"年相若：年龄差不多。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-31"},{"blocks":[{"runs":[{"text":"位卑则足羞，官盛则近谀：以地位低者为师，就感到十分耻辱；以官职高者为师，就觉得是近乎谄媚。谀，谄媚奉承。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-32"},{"blocks":[{"runs":[{"text":"不齿：不与同列，意思是看不起。齿，并列、排列。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-33"},{"blocks":[{"runs":[{"text":"乃：竟。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-34"},{"blocks":[{"runs":[{"text":"欤（yú）：语气助词，表示感叹。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-35"},{"blocks":[{"runs":[{"text":"常师：固定的老师。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-36"},{"blocks":[{"runs":[{"text":"郯（tán）子（生卒年不详）：春秋时郯国（今山东郯城一带）的国君，孔子曾向他请教官职的名称。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-37"},{"blocks":[{"runs":[{"text":"苌（cháng）弘（生卒年不详）：周敬王时的大夫，孔子曾向他请教过音乐方面的事情。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-38"},{"blocks":[{"runs":[{"text":"师襄（生卒年不详）：春秋时鲁国的乐官，孔子曾跟他学过琴。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-39"},{"blocks":[{"runs":[{"text":"老聃（dān）：即老子，孔子曾向他问过礼。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-40"},{"blocks":[{"runs":[{"text":"郯子之徒：郯子那些人（指上面说的四个人）。徒，同类的人。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-41"},{"blocks":[{"runs":[{"text":"贤：才德优秀。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-42"},{"blocks":[{"runs":[{"text":"三人行，则必有我师：语出《论语·述而》。原句是：“三人行，必有我师焉。”","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-43"},{"blocks":[{"runs":[{"text":"不必：不一定。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-44"},{"blocks":[{"runs":[{"text":"贤：超过。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-45"},{"blocks":[{"runs":[{"text":"术业：学术技艺。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-46"},{"blocks":[{"runs":[{"text":"专攻：专门学习或研究。攻，学习、研究。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-47"},{"blocks":[{"runs":[{"text":"李氏子蟠：李家的孩子叫蟠的。即李蟠，唐德宗贞元十九年（803）进士。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-48"},{"blocks":[{"runs":[{"text":"古文：指先秦两汉时期的散文，与骈文相对。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-49"},{"blocks":[{"runs":[{"text":"六艺经传（zhuàn）：六经的经文和传文。六艺，指《诗》《书》《礼》《乐》《易》《春秋》六种经书，其中《乐》久已失传。传，古代解释经书的著作。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-50"},{"blocks":[{"runs":[{"text":"通：全面。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-51"},{"blocks":[{"runs":[{"text":"不拘于时：不受时俗的限制。时，时俗，指当时士大夫中耻于从师的不良风气。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-52"},{"blocks":[{"runs":[{"text":"嘉：赞许。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-53"},{"blocks":[{"runs":[{"text":"古道：指古人从师之道。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-54"},{"blocks":[{"runs":[{"text":"贻（yí）：赠送。。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11144-55"}],"blocks":[{"runs":[{"text":"师 说","type":"text"},{"label":"[1]","noteId":"footnote-11144-1","type":"annotation-ref"},{"text":"\n\n韩 愈\n\n古之学者","type":"text"},{"label":"[2]","noteId":"footnote-11144-2","type":"annotation-ref"},{"text":" 必有师。师者，所以传道受业解惑也","type":"text"},{"label":"[3]","noteId":"footnote-11144-3","type":"annotation-ref"},{"text":"。人非生而知之","type":"text"},{"label":"[4]","noteId":"footnote-11144-4","type":"annotation-ref"},{"text":"者，孰能无惑？惑而不从师，其为惑也","type":"text"},{"label":"[5]","noteId":"footnote-11144-5","type":"annotation-ref"},{"text":"，终不解矣。生乎吾前，其闻","type":"text"},{"label":"[6]","noteId":"footnote-11144-6","type":"annotation-ref"},{"text":"道也固先乎吾，吾从而师之","type":"text"},{"label":"[7]","noteId":"footnote-11144-7","type":"annotation-ref"},{"text":"；生乎吾后，其闻道也亦先乎吾，吾从而师之。吾师道也","type":"text"},{"label":"[8]","noteId":"footnote-11144-8","type":"annotation-ref"},{"text":"，夫庸知其年之先后生于吾乎","type":"text"},{"label":"[9]","noteId":"footnote-11144-9","type":"annotation-ref"},{"text":"？是故无贵无贱","type":"text"},{"label":"[10]","noteId":"footnote-11144-10","type":"annotation-ref"},{"text":"，无长无少，道之所存，师之所存也","type":"text"},{"label":"[11]","noteId":"footnote-11144-11","type":"annotation-ref"},{"text":"。\n\n嗟乎！师道","type":"text"},{"label":"[12]","noteId":"footnote-11144-12","type":"annotation-ref"},{"text":"之不传也久矣！欲人之无惑也难矣！古之圣人，其出人","type":"text"},{"label":"[13]","noteId":"footnote-11144-13","type":"annotation-ref"},{"text":"也远矣，犹且","type":"text"},{"label":"[14]","noteId":"footnote-11144-14","type":"annotation-ref"},{"text":"从师而问焉；今之众人","type":"text"},{"label":"[15]","noteId":"footnote-11144-15","type":"annotation-ref"},{"text":"，其下圣人也亦远矣，而耻学于师。是故圣益圣，愚益愚","type":"text"},{"label":"[16]","noteId":"footnote-11144-16","type":"annotation-ref"},{"text":"。圣人之所以为圣，愚人之所以为愚，其皆出于此乎？爱其子，择师而教之；于其身","type":"text"},{"label":"[17]","noteId":"footnote-11144-17","type":"annotation-ref"},{"text":"也，则耻师","type":"text"},{"label":"[18]","noteId":"footnote-11144-18","type":"annotation-ref"},{"text":"焉，惑","type":"text"},{"label":"[19]","noteId":"footnote-11144-19","type":"annotation-ref"},{"text":"矣。彼童子","type":"text"},{"label":"[20]","noteId":"footnote-11144-20","type":"annotation-ref"},{"text":"之师，授之书而习其句读","type":"text"},{"label":"[21]","noteId":"footnote-11144-21","type":"annotation-ref"},{"text":"者，非吾所谓传其道解其惑者也。句读之不知","type":"text"},{"label":"[22]","noteId":"footnote-11144-22","type":"annotation-ref"},{"text":"，惑之不解，或师焉，或不焉","type":"text"},{"label":"[23]","noteId":"footnote-11144-23","type":"annotation-ref"},{"text":"，小学而大遗","type":"text"},{"label":"[24]","noteId":"footnote-11144-24","type":"annotation-ref"},{"text":"，吾未见其明也。巫医","type":"text"},{"label":"[25]","noteId":"footnote-11144-25","type":"annotation-ref"},{"text":"乐师","type":"text"},{"label":"[26]","noteId":"footnote-11144-26","type":"annotation-ref"},{"text":"百工","type":"text"},{"label":"[27]","noteId":"footnote-11144-27","type":"annotation-ref"},{"text":"之人，不耻相师","type":"text"},{"label":"[28]","noteId":"footnote-11144-28","type":"annotation-ref"},{"text":"。士大夫之族","type":"text"},{"label":"[29]","noteId":"footnote-11144-29","type":"annotation-ref"},{"text":"，曰师曰弟子云者","type":"text"},{"label":"[30]","noteId":"footnote-11144-30","type":"annotation-ref"},{"text":"，则群聚而笑之。问之，则曰：“彼与彼年相若","type":"text"},{"label":"[31]","noteId":"footnote-11144-31","type":"annotation-ref"},{"text":"也，道相似也，位卑则足羞，官盛则近谀","type":"text"},{"label":"[32]","noteId":"footnote-11144-32","type":"annotation-ref"},{"text":"。”呜呼！师道之不复，可知矣。巫医乐师百工之人，君子不齿","type":"text"},{"label":"[33]","noteId":"footnote-11144-33","type":"annotation-ref"},{"text":"，今其智乃","type":"text"},{"label":"[34]","noteId":"footnote-11144-34","type":"annotation-ref"},{"text":"反不能及，其可怪也欤","type":"text"},{"label":"[35]","noteId":"footnote-11144-35","type":"annotation-ref"},{"text":"！\n\n圣人无常师","type":"text"},{"label":"[36]","noteId":"footnote-11144-36","type":"annotation-ref"},{"text":"。孔子师郯子","type":"text"},{"label":"[37]","noteId":"footnote-11144-37","type":"annotation-ref"},{"text":"、苌弘","type":"text"},{"label":"[38]","noteId":"footnote-11144-38","type":"annotation-ref"},{"text":"、师襄","type":"text"},{"label":"[39]","noteId":"footnote-11144-39","type":"annotation-ref"},{"text":"、老聃","type":"text"},{"label":"[40]","noteId":"footnote-11144-40","type":"annotation-ref"},{"text":"。郯子之徒","type":"text"},{"label":"[41]","noteId":"footnote-11144-41","type":"annotation-ref"},{"text":"，其贤","type":"text"},{"label":"[42]","noteId":"footnote-11144-42","type":"annotation-ref"},{"text":" 不及孔子。孔子曰：三人行，则必有我师","type":"text"},{"label":"[43]","noteId":"footnote-11144-43","type":"annotation-ref"},{"text":"。是故弟子不必","type":"text"},{"label":"[44]","noteId":"footnote-11144-44","type":"annotation-ref"},{"text":" 不如师，师不必贤","type":"text"},{"label":"[45]","noteId":"footnote-11144-45","type":"annotation-ref"},{"text":" 于弟子，闻道有先后，术业","type":"text"},{"label":"[46]","noteId":"footnote-11144-46","type":"annotation-ref"},{"text":" 有专攻","type":"text"},{"label":"[47]","noteId":"footnote-11144-47","type":"annotation-ref"},{"text":"，如是而已。\n\n李氏子蟠","type":"text"},{"label":"[48]","noteId":"footnote-11144-48","type":"annotation-ref"},{"text":"，年十七，好古文","type":"text"},{"label":"[49]","noteId":"footnote-11144-49","type":"annotation-ref"},{"text":"，六艺经传","type":"text"},{"label":"[50]","noteId":"footnote-11144-50","type":"annotation-ref"},{"text":"皆通","type":"text"},{"label":"[51]","noteId":"footnote-11144-51","type":"annotation-ref"},{"text":"习之，不拘于时","type":"text"},{"label":"[52]","noteId":"footnote-11144-52","type":"annotation-ref"},{"text":"，学于余。余嘉","type":"text"},{"label":"[53]","noteId":"footnote-11144-53","type":"annotation-ref"},{"text":"其能行古道","type":"text"},{"label":"[54]","noteId":"footnote-11144-54","type":"annotation-ref"},{"text":"，作《师说》以贻","type":"text"},{"label":"[55]","noteId":"footnote-11144-55","type":"annotation-ref"},{"text":"之。","type":"text"}],"type":"paragraph"}],"frontMatter":[],"guidance":[],"links":[],"media":[],"sourceOnlyBlocks":[],"sourcePostId":"11144-2","sourcePostNumber":1},"mediaReceiptLedgerSha256":"5487243dd8d14d65dfadc20ed544a999aaa318fc20c291462ea62c69e1eff320","mediaReceiptLedgerVersion":"2026-07-30.2","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11144-1","postId":"11144-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11144-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11144-2","postId":"11144-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11144-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11144-3","postId":"11144-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11144-3","text":"[3]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11144-4","postId":"11144-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11144-4","text":"[4]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11144-5","postId":"11144-2","postNumber":1,"postRo