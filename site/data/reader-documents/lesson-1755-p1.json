:"https://forum.rdfzer.com/#footnote-ref-11208-4","postId":"11208-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11208-4","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11208-5","postId":"11208-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11208-5","text":"↩︎","title":null}],"media":[],"posts":[{"cookedSha256":"c760e31327af4beb07dda8a4296256b524904508cf698c222950b1eaf715b6ad","createdAt":"2024-08-22T14:36:38Z","plainTextSha256":"95e5d4986ef4383a96239c23a73495e4e6ab7810a509ee2b211a3c9b7999bca3","postId":"11208-1","postNumber":1,"replyToPostNumber":null,"role":"primary","updatedAt":"2024-08-22T14:36:38Z"}],"roleAuditDecisions":[],"sourceLessonPath":"data/lessons/lesson-1755-p1.json","sourceLessonUpdatedAt":"2024-08-22T14:46:04Z","sourcePostCount":1},"resources":[],"roleAuditSha256":"65654ae8bd58de3c8040438da7fc213c00b7175d6dc82802a995f46c4cdfd4a7","roleAuditVersion":"2026-07-30.2","schemaVersion":"yw-reader-document-v1","supplementary":[],"title":"登岳阳楼"}
