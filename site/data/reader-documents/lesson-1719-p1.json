{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1719-p1","main":{"annotations":[{"blocks":[{"runs":[{"text":"选自《苏轼文集》卷一（中华书局1986年版）。宋神宗元丰二年（1079），苏轼被贬为黄州（今湖北黄冈）团练副使。元丰五年（1082）秋冬，苏轼先后两次游览了黄州附近的赤壁，写下两篇赋。本文是第一篇，又称《前赤壁赋》。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-1"},{"blocks":[{"runs":[{"text":"〔壬（rén）戌〕宋神宗元丰五年（1082）。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-2"},{"blocks":[{"runs":[{"text":"〔既望〕过了望日后的第一天，通常指农历每月十六日。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-3"},{"blocks":[{"runs":[{"text":"〔举酒属（zhǔ）客〕举起酒杯，劝客人饮酒。属，劝请。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-4"},{"blocks":[{"runs":[{"text":"〔明月之诗〕和下文的“窈窕之章”分指《诗经·陈风·月出》及其诗句。这首诗的第一章有“舒窈纠（jiǎo）兮”的句子，所以称为“窈窕之章”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-5"},{"blocks":[{"runs":[{"text":"〔少焉〕一会儿。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-6"},{"blocks":[{"runs":[{"text":"〔斗（dǒu）牛〕斗宿和牛宿，都是星宿名。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-7"},{"blocks":[{"runs":[{"text":"〔白露〕指白茫茫的水汽。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-8"},{"blocks":[{"runs":[{"text":"〔纵一苇之所如〕任凭小船漂去。纵，放任。一苇，指小船（比喻船很小，像一片苇叶）。语出《诗经·卫风·河广》：“谁谓河广，一苇杭（航）之。”如，往。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-9"},{"blocks":[{"runs":[{"text":"〔凌万顷之茫然〕越过那茫茫的江面。凌，越过。万顷，指广阔的江面。茫然，旷远的样子。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-10"},{"blocks":[{"runs":[{"text":"〔冯（píng）虚御风〕凌空驾风而行。冯，同“凭”，乘。虚，太空。御，驾。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-11"},{"blocks":[{"runs":[{"text":"〔遗世独立，羽化而登仙〕脱离人世，升入仙境。羽化，指飞升成仙。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-12"},{"blocks":[{"runs":[{"text":"〔扣舷〕敲着船边，指打着节拍。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-13"},{"blocks":[{"runs":[{"text":"〔桂棹兮兰桨〕桂木做的棹，木兰做的桨。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-14"},{"blocks":[{"runs":[{"text":"〔击空明兮溯流光〕（桨）划破月光下的清波，（船）在月光浮动的水面上逆流而上。空明，指月光下的清波。流光，江面浮动的月光。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-15"},{"blocks":[{"runs":[{"text":"〔渺渺兮予怀〕我心里想得很远。渺渺，悠远的样子。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-16"},{"blocks":[{"runs":[{"text":"〔望美人兮天一方〕眺望美人，（美人）却在天的那一边。美人，指所思慕的人。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-17"},{"blocks":[{"runs":[{"text":"〔客〕指与苏轼同游的人。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-18"},{"blocks":[{"runs":[{"text":"〔洞箫〕管乐器的一种。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-19"},{"blocks":[{"runs":[{"text":"〔倚歌〕依照歌曲的声调和节拍。倚，循、依。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-20"},{"blocks":[{"runs":[{"text":"〔和（hè）之〕（用箫）随着歌声伴奏。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-21"},{"blocks":[{"runs":[{"text":"〔余音袅袅，不绝如缕〕尾声细弱而婉转悠长，如同不断的细丝。袅袅，形容声音婉转悠长。缕，细丝。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-22"},{"blocks":[{"runs":[{"text":"〔舞幽壑之潜蛟，泣孤舟之嫠（lí）妇〕意思是，箫声使深谷中的蛟龙听了起舞，使独坐孤舟的寡妇听了落泪。幽壑，深谷。嫠妇，寡妇。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-23"},{"blocks":[{"runs":[{"text":"〔愀（qiǎo）然〕容色改变的样子。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-24"},{"blocks":[{"runs":[{"text":"〔危坐〕端坐。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-25"},{"blocks":[{"runs":[{"text":"〔何为其然也〕（曲调）为什么这样（悲凉）呢？","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-26"},{"blocks":[{"runs":[{"text":"〔夏口〕古镇名，在今湖北武昌的西面。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-27"},{"blocks":[{"runs":[{"text":"〔武昌〕今湖北鄂州。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-28"},{"blocks":[{"runs":[{"text":"〔山川相缪（liáo），郁乎苍苍〕山水环绕，一片苍翠。缪，同“缭”，盘绕、围绕。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-29"},{"blocks":[{"runs":[{"text":"〔此〕这地方。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-30"},{"blocks":[{"runs":[{"text":"〔困〕受困。指曹操败于赤壁。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-31"},{"blocks":[{"runs":[{"text":"〔周郎〕周瑜。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-32"},{"blocks":[{"runs":[{"text":"〔方〕当。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-33"},{"blocks":[{"runs":[{"text":"〔破荆州〕建安十三年（208），曹操南击荆州，当时荆州刺史刘表已死，刘表的儿子刘琮（cóng）投降曹操。荆州，在今湖北、湖南一带。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-34"},{"blocks":[{"runs":[{"text":"〔下江陵〕刘琮投降曹操以后，曹操又在当阳的长坂击败刘备，进兵江陵。下，攻占。江陵，当时为荆州重镇，今属湖北。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-35"},{"blocks":[{"runs":[{"text":"〔舳舻（zhúlú）〕船头和船尾的并称，泛指首尾相接的船只。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-36"},{"blocks":[{"runs":[{"text":"〔酾（shī）酒临江，横槊（shuò）赋诗〕面对大江斟酒，横执长矛吟诗（曹操所吟的诗就是《短歌行》）。酾酒，斟酒。槊，长矛。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-37"},{"blocks":[{"runs":[{"text":"〔渔樵于江渚之上〕在江边捕鱼砍柴。渔樵，捕鱼砍柴。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-38"},{"blocks":[{"runs":[{"text":"〔匏（páo）樽〕用葫芦做成的酒器。匏，葫芦的一种。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-39"},{"blocks":[{"runs":[{"text":"〔蜉蝣（fúyóu）〕一种小飞虫，夏秋之交生在水边，生存期很短，古人说它朝生暮死。这里用来比喻人生短促。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-40"},{"blocks":[{"runs":[{"text":"〔一粟〕一粒米。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-41"},{"blocks":[{"runs":[{"text":"〔骤〕一下子，很轻易地。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-42"},{"blocks":[{"runs":[{"text":"〔遗响〕余音，指箫声。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-43"},{"blocks":[{"runs":[{"text":"〔逝者如斯，而未尝往也；盈虚者如彼，而卒莫消长也〕流去的（水）像这样（不断地流去永不复返），而并没有流去；（月亮）像那样时圆时缺，却终究没有增减的变化。未尝往，意思是江水虽然在不断地奔流，但前者去后者来，始终滔滔不绝，如同没有流去。盈，满。虚，缺。卒，终究。消长，消减和增长。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-44"},{"blocks":[{"runs":[{"text":"〔盖将自其变者而观之，则天地曾不能以一瞬〕如果从那变化的一面看，那么天地间万事万物（时刻在变动），连一眨眼的工夫都不停止。将，这里表示假设。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-45"},{"blocks":[{"runs":[{"text":"〔物与我皆无尽〕意思是，万物同我们一样都是永恒的。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-46"},{"blocks":[{"runs":[{"text":"〔是造物者之无尽藏（zàng）也，而吾与子之所共适〕这是自然界无穷无尽的宝藏，我和你可以共同享受。造物者，原指“天”，就是现在所说的“自然”。无尽藏，出自佛家语的“无尽藏海”（像海之能包罗万物）。适，这里有“享有”的意思。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-47"},{"blocks":[{"runs":[{"text":"〔更〕再。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-48"},{"blocks":[{"runs":[{"text":"〔肴核〕菜肴和果品。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-49"},{"blocks":[{"runs":[{"text":"〔狼籍〕即“狼藉”，凌乱。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-50"},{"blocks":[{"runs":[{"text":"〔相与枕藉（jiè）〕互相枕着垫着。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-51"},{"blocks":[{"runs":[{"text":"〔既白〕天明。白，明亮。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11155-52"}],"blocks":[{"runs":[{"text":"赤壁图 ［金］武元直 作","type":"text"}],"type":"paragraph"},{"runs":[{"text":"赤壁赋","type":"text"},{"label":"[1]","noteId":"footnote-11155-1","type":"annotation-ref"},{"text":"苏 轼壬戌","type":"text"},{"label":"[2]","noteId":"footnote-11155-2","type":"annotation-ref"},{"text":"之秋，七月既望","type":"text"},{"label":"[3]","noteId":"footnote-11155-3","type":"annotation-ref"},{"text":"，苏子与客泛舟游于赤壁之下。清风徐来，水波不兴。举酒属","type":"text"},{"label":"[4]","noteId":"footnote-11155-4","type":"annotation-ref"},{"text":"客，诵明月之诗","type":"text"},{"label":"[5]","noteId":"footnote-11155-5","type":"annotation-ref"},{"text":"，歌窈窕之章。少焉","type":"text"},{"label":"[6]","noteId":"footnote-11155-6","type":"annotation-ref"},{"text":"，月出于东山之上，徘徊于斗牛","type":"text"},{"label":"[7]","noteId":"footnote-11155-7","type":"annotation-ref"},{"text":"之间。白露","type":"text"},{"label":"[8]","noteId":"footnote-11155-8","type":"annotation-ref"},{"text":"横江，水光接天。纵一苇之所如","type":"text"},{"label":"[9]","noteId":"footnote-11155-9","type":"annotation-ref"},{"text":"，凌万顷之茫然","type":"text"},{"label":"[10]","noteId":"footnote-11155-10","type":"annotation-ref"},{"text":"。浩浩乎如冯虚御风","type":"text"},{"label":"[11]","noteId":"footnote-11155-11","type":"annotation-ref"},{"text":"，而不知其所止；飘飘乎如遗世独立，羽化而登仙","type":"text"},{"label":"[12]","noteId":"footnote-11155-12","type":"annotation-ref"},{"text":"。\n\n于是饮酒乐甚，扣舷","type":"text"},{"label":"[13]","noteId":"footnote-11155-13","type":"annotation-ref"},{"text":"而歌之。歌曰：“桂棹兮兰桨","type":"text"},{"label":"[14]","noteId":"footnote-11155-14","type":"annotation-ref"},{"text":"，击空明兮溯流光","type":"text"},{"label":"[15]","noteId":"footnote-11155-15","type":"annotation-ref"},{"text":"。渺渺兮予怀","type":"text"},{"label":"[16]","noteId":"footnote-11155-16","type":"annotation-ref"},{"text":"，望美人兮天一方","type":"text"},{"label":"[17]","noteId":"footnote-11155-17","type":"annotation-ref"},{"text":"。”客","type":"text"},{"label":"[18]","noteId":"footnote-11155-18","type":"annotation-ref"},{"text":"有吹洞箫","type":"text"},{"label":"[19]","noteId":"footnote-11155-19","type":"annotation-ref"},{"text":"者，倚歌","type":"text"},{"label":"[20]","noteId":"footnote-11155-20","type":"annotation-ref"},{"text":"而和之","type":"text"},{"label":"[21]","noteId":"footnote-11155-21","type":"annotation-ref"},{"text":"。其声呜呜然，如怨如慕，如泣如诉，余音袅袅，不绝如缕","type":"text"},{"label":"[22]","noteId":"footnote-11155-22","type":"annotation-ref"},{"text":"。舞幽壑之潜蛟，泣孤舟之嫠妇","type":"text"},{"label":"[23]","noteId":"footnote-11155-23","type":"annotation-ref"},{"text":"。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"苏子愀然","type":"text"},{"label":"[24]","noteId":"footnote-11155-24","type":"annotation-ref"},{"text":"，正襟危坐","type":"text"},{"label":"[25]","noteId":"footnote-11155-25","type":"annotation-ref"},{"text":"而问客曰：“何为其然也","type":"text"},{"label":"[26]","noteId":"footnote-11155-26","type":"annotation-ref"},{"text":"？”客曰：“‘月明星稀，乌鹊南飞’，此非曹孟德之诗乎？西望夏口","type":"text"},{"label":"[27]","noteId":"footnote-11155-27","type":"annotation-ref"},{"text":"，东望武昌","type":"text"},{"label":"[28]","noteId":"footnote-11155-28","type":"annotation-ref"},{"text":"，山川相缪，郁乎苍苍","type":"text"},{"label":"[29]","noteId":"footnote-11155-29","type":"annotation-ref"},{"text":"，此","type":"text"},{"label":"[30]","noteId":"footnote-11155-30","type":"annotation-ref"},{"text":"非孟德之困","type":"text"},{"label":"[31]","noteId":"footnote-11155-31","type":"annotation-ref"},{"text":"于周郎","type":"text"},{"label":"[32]","noteId":"footnote-11155-32","type":"annotation-ref"},{"text":"者乎？方","type":"text"},{"label":"[33]","noteId":"footnote-11155-33","type":"annotation-ref"},{"text":"其破荆州","type":"text"},{"label":"[34]","noteId":"footnote-11155-34","type":"annotation-ref"},{"text":"，下江陵","type":"text"},{"label":"[35]","noteId":"footnote-11155-35","type":"annotation-ref"},{"text":"，顺流而东也，舳舻","type":"text"},{"label":"[36]","noteId":"footnote-11155-36","type":"annotation-ref"},{"text":"千里，旌旗蔽空，酾酒临江，横槊赋诗","type":"text"},{"label":"[37]","noteId":"footnote-11155-37","type":"annotation-ref"},{"text":"，固一世之雄也，而今安在哉？况吾与子渔樵于江渚之上","type":"text"},{"label":"[38]","noteId":"footnote-11155-38","type":"annotation-ref"},{"text":"，侣鱼虾而友麋鹿，驾一叶之扁舟，举匏樽","type":"text"},{"label":"[39]","noteId":"footnote-11155-39","type":"annotation-ref"},{"text":"以相属。寄蜉蝣","type":"text"},{"label":"[40]","noteId":"footnote-11155-40","type":"annotation-ref"},{"text":"于天地，渺沧海之一粟","type":"text"},{"label":"[41]","noteId":"footnote-11155-41","type":"annotation-ref"},{"text":"。哀吾生之须臾，羡长江之无穷。挟飞仙以遨游，抱明月而长终。知不可乎骤","type":"text"},{"label":"[42]","noteId":"footnote-11155-42","type":"annotation-ref"},{"text":"得，托遗响","type":"text"},{"label":"[43]","noteId":"footnote-11155-43","type":"annotation-ref"},{"text":"于悲风。”\n\n苏子曰：“客亦知夫水与月乎？逝者如斯，而未尝往也；盈虚者如彼，而卒莫消长也","type":"text"},{"label":"[44]","noteId":"footnote-11155-44","type":"annotation-ref"},{"text":"。盖将自其变者而观之，则天地曾不能以一瞬","type":"text"},{"label":"[45]","noteId":"footnote-11155-45","type":"annotation-ref"},{"text":"；自其不变者而观之，则物与我皆无尽","type":"text"},{"label":"[46]","noteId":"footnote-11155-46","type":"annotation-ref"},{"text":"也，而又何羡乎！且夫天地之间，物各有主，苟非吾之所有，虽一毫而莫取。惟江上之清风，与山间之明月，耳得之而为声，目遇之而成色，取之无禁，用之不竭，是造物者之无尽藏","type":"text"},{"label":"[47]","noteId":"footnote-11155-47","type":"annotation-ref"},{"text":"也，而吾与子之所共适。”\n\n客喜而笑，洗盏更","type":"text"},{"label":"[48]","noteId":"footnote-11155-48","type":"annotation-ref"},{"text":"酌。肴核","type":"text"},{"label":"[49]","noteId":"footnote-11155-49","type":"annotation-ref"},{"text":"既尽，杯盘狼籍","type":"text"},{"label":"[50]","noteId":"footnote-11155-50","type":"annotation-ref"},{"text":"。相与枕藉","type":"text"},{"label":"[51]","noteId":"footnote-11155-51","type":"annotation-ref"},{"text":"乎舟中，不知东方之既白","type":"text"},{"label":"[52]","noteId":"footnote-11155-52","type":"annotation-ref"},{"text":"。","type":"text"}],"type":"paragraph"}],"frontMatter":[],"guidance":[],"links":[],"media":[{"alt":"","bytes":61952,"finalUrl":"https://files.rdfzer.com/original/2X/0/01569f077e453eeb8c38fc45d32c3789a5aaf5a7.jpeg","height":224,"id":"media-c9e210c4d554e9431ee1","mediaType":"image/jpeg","nativeDisposition":"verified-in-app","receiptCollectedAt":"2026-07-30T01:10:43.464Z","receiptRequired":true,"rightsBasis":"user-authorized-course-source-use-2026-07-29","sha256":"c484b8b3f27db80e10f3b1cbf53bec282dd68f36854acdae9f5b38ae9afdf467","sourceUrl":"https://files.rdfzer.com/original/2X/0/01569f077e453eeb8c38fc45d32c3789a5aaf5a7.jpeg","webDisposition":"source-url","width":624}],"sourceOnlyBlocks":[],"sourcePostId":"11155-1","sourcePostNumber":1},"mediaReceiptLedgerSha256":"0319bd9f7623eb57ee396cafc0343cb6c4dc51dce258109a19edbdddd91be71c","mediaReceiptLedgerVersion":"2026-08-09.1","provenance":{"links":[{"disposition":"system-browser","href":"https://files.rdfzer.com/original/2X/0/01569f077e453eeb8c38fc45d32c3789a5aaf5a7.jpeg","postId":"11155-1","postNumber":1,"postRole":"primary","sourceUrl":"https://files.rdfzer.com/original/2X/0/01569f077e453eeb8c38fc45d32c3789a5aaf5a7.jpeg","text":"https://files.rdfzer.com/original/2X/0/01569f077e453eeb8c38fc45d