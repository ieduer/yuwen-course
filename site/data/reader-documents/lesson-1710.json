{"curationManifestSha256":"98e90b3603b34b437bc554810c21f01c4db44d10364211af114d30fde3d67bad","curationVersion":"2026-07-30.2","lessonId":"lesson-1710","main":{"annotations":[],"blocks":[{"runs":[{"text":"学习是永恒的话题。从《礼记·学记》中的“玉","type":"text"}],"type":"paragraph"},{"runs":[{"text":"不琢，不成器”，到当今社会倡导的终身学习和个性","type":"text"}],"type":"paragraph"},{"runs":[{"text":"化学习，数千年来，人们一直在不懈地探索学习之道，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"以更好地获取知识，提升能力和自身修养。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"本单元的文章从不同角度论述有关学习的问题，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"或阐述学习的意义，或讨论学习的态度与方法，或描","type":"text"}],"type":"paragraph"},{"runs":[{"text":"述读书的经历与感受，使我们获得不同的启迪。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"学习本单元，以“学习之道”为核心，通过梳理、","type":"text"}],"type":"paragraph"},{"runs":[{"text":"探究和反思，形成正确的学习观，改进学习方法，提","type":"text"}],"type":"paragraph"},{"runs":[{"text":"高学习能力。要准确把握作者的观点和态度，关注作","type":"text"}],"type":"paragraph"},{"runs":[{"text":"者思考问题的角度，学习他们有针对性地表达观点的","type":"text"}],"type":"paragraph"},{"runs":[{"text":"方法；学会发现问题，从合适的角度以恰当的方式阐","type":"text"}],"type":"paragraph"},{"runs":[{"text":"述自己的看法。","type":"text"}],"type":"paragraph"}],"frontMatter":[],"guidance":[],"links":[],"media":[{"alt":"","bytes":69339,"finalUrl":"https://files.rdfzer.com/original/2X/d/d384a9e09d431f388d213b0e8eb894c00d4b43aa.jpeg","height":1146,"id":"media-d8e186631ca612f2f313","mediaType":"image/jpeg","nativeDisposition":"verified-in-app","receiptCollectedAt":"2026-07-30T01:10:43.464Z","receiptRequired":true,"rightsBasis":"user-authorized-course-source-use-2026-07-29","sha256":"eedc3dc83287d4e3085bc9a73d270c0209590836165b5b83a6cc5465015e496d","sourceUrl":"https://files.rdfzer.com/original/2X/d/d384a9e09d431f388d213b0e8eb894c00d4b43aa.jpeg","webDisposition":"source-url","width":807}],"sourceOnlyBlocks":[],"sourcePostId":11142,"sourcePostNumber":1},"mediaReceiptLedgerSha256":"5487243dd8d14d65dfadc20ed544a999aaa318fc20c291462ea62c69e1eff320","mediaReceiptLedge