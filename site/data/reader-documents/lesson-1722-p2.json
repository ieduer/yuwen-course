{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1722-p2","main":{"annotations":[{"blocks":[{"runs":[{"text":"涉江采芙蓉：芙蓉，荷花。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11164-1"},{"blocks":[{"runs":[{"text":"兰泽：长着兰草的低湿之地。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11164-2"},{"blocks":[{"runs":[{"text":"遗（wèi）：赠送。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11164-3"},{"blocks":[{"runs":[{"text":"以：连词，表示结果。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11164-4"}],"blocks":[{"type":"divider"},{"runs":[{"text":"《古诗十九首》","type":"text"}],"type":"paragraph"},{"runs":[{"text":"涉江采芙蓉","type":"text"},{"label":"[1]","noteId":"footnote-11164-1","type":"annotation-ref"},{"text":"，兰泽","type":"text"},{"label":"[2]","noteId":"footnote-11164-2","type":"annotation-ref"},{"text":"多芳草。\n\n采之欲遗","type":"text"},{"label":"[3]","noteId":"footnote-11164-3","type":"annotation-ref"},{"text":"谁？所思在远道。\n\n还顾望旧乡，长路漫浩浩。\n\n同心而离居，忧伤以","type":"text"},{"label":"[4]","noteId":"footnote-11164-4","type":"annotation-ref"},{"text":"终老。","type":"text"}],"type":"paragraph"},{"type":"divider"},{"blocks":[{"runs":[{"text":"东汉中后期，游宦、游学之风盛行，大批士子远离故乡。作为文人五言诗滥觞的《古诗十九首》反映的就是这一现实，诗中充满了羁旅怀乡的思绪。这首诗的主人公采撷美草香花要送给“同心”的人，但他思念的人还在“旧乡”，长路漫漫，欲赠不能，只能让忧伤陪伴自己终老。全诗字里行间流露着漂泊他乡\n\n和分隔两地的无奈。诵读这首诗，体会其“浅而能深、近而能远”（胡应麟《诗薮·内编》卷一）的特色。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"frontMatter":[{"blocks":[{"runs":[{"text":"选自《文选》卷二十九（上海古籍出版社1986年版）。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"guidance":[],"links":[],"media":[],"sourceOnlyBlocks":[],"sourcePostId":"11164-2","sourcePostNumber":1},"mediaReceiptLedgerSha256":"0319bd9f7623eb57ee396cafc0343cb6c4dc51dce258109a19edbdddd91be71c","mediaReceiptLedgerVersion":"2026-08-09.1","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11164-1","postId":"11164-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11164-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11164-2","postId":"11164-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11164-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11164-3","postId":"11164-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11164-3","text":"[3]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11164-4","postId":"11164-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11164-4","text":"[4]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11164-1","postId":"11164-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11164-1","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11164-2","postId":"11164-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11164-2","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11164-3","postId":"11164-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11164-3","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11164-4","postId":"11164-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11164-4","text":"↩︎","title":null}],"media":[],"posts":[{"cookedSha256":"1eaaa07501ca6dcd5fe9d606be6d09f46406f1fe3696abc4094f13eebf72e4f5","createdAt":"2024-08-21T15:59:15Z","plainTextSha256":"55a5bc4f9c2f0158bf8867bfc6057b5fabaf75668d4719733c01a3b6a93f471c","postId":"11164-2","postNumber":1,"replyToPostNumber":null,"role":"primary","updatedAt":"2024-08-21T15:59:15Z"}],"roleAuditDecisions":[