{"curationManifestSha256":"98e90b3603b34b437bc554810c21f01c4db44d10364211af114d30fde3d67bad","curationVersion":"2026-07-30.2","lessonId":"lesson-1567","main":{"annotations":[],"blocks":[{"runs":[{"text":"大堰河，是我的保姆。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"她的名字就是生她的村庄的名字，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"她是童养媳，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大堰河，是我的保姆。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我是地主的儿子，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"也是吃了大堰河的奶而长大了的","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大堰河的儿子。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大堰河以养育我而养育她的家，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"而我，是吃了你的奶而被养育了的，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大堰河啊，我的保姆。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大堰河，今天我看到雪使我想起了你：","type":"text"}],"type":"paragraph"},{"runs":[{"text":"你的被雪压着的草盖的坟墓，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"你的关闭了的故居檐头的枯死的瓦菲，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"你的被典押了的一丈平方的园地，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"你的门前的长了青苔的石椅，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大堰河，今天我看到雪使我想起了你。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"你用你厚大的手掌把我抱在怀里，抚摸我；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在你搭好了灶火之后，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在你拍去了围裙上的炭灰之后，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在你尝到饭已煮熟了之后，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在你把乌黑的酱碗放到乌黑的桌子上之后，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在你补好了儿子们的为山腰的荆棘扯破的衣服之后，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在你把小儿被柴刀砍伤了的手包好之后，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在你把夫儿们的衬衣上的虱子一颗颗地掐死之后，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在你拿起了今天的第一颗鸡蛋之后，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"你用你厚大的手掌把我抱在怀里，抚摸我。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我是地主的儿子，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在我吃光了你大堰河的奶之后，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我被生我的父母领回到自己的家里。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"啊，大堰河，你为什么要哭？","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我做了生我的父母家里的新客了!","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我摸着红漆雕花的家具，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我摸着父母的睡床上金色的花纹，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我呆呆地看着檐头的我不认得的“天伦叙乐”的匾，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我摸着新换上的衣服的丝的和贝壳的纽扣，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我看着母亲怀里的不熟识的妹妹，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我坐着油漆过的安了火钵的炕凳，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我吃着碾了三番的白米的饭，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"但，我是这般忸怩不安！因为我","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我做了生我的父母家里的新客了。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大堰河，为了生活，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在她流尽了她的乳液之后，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"她就开始用抱过我的两臂劳动了；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"她含着笑，洗着我们的衣服，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"她含着笑，提着菜篮到村边的结冰的池塘去，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"她含着笑，切着冰屑悉索的萝卜，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"她含着笑，用手掏着猪吃的麦糟，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"她含着笑，扇着炖肉的炉子的火，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"她含着笑，背了团箕到广场上去","type":"text"}],"type":"paragraph"},{"runs":[{"text":"晒好那些大豆和小麦，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大堰河，为了生活，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在她流尽了她的乳液之后，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"她就用抱过我的两臂，劳动了。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大堰河，深爱着她的乳儿；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在年节里，为了他，忙着切那冬米的糖，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"为了他，常悄悄地走到村边的她的家里去，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"为了他，走到她的身边叫一声“妈”，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大堰河，把他画的大红大绿的关云长","type":"text"}],"type":"paragraph"},{"runs":[{"text":"贴在灶边的墙上，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大堰河，会对她的邻居夸口赞美她的乳儿；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大堰河曾做了一个不能对人说的梦：","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在梦里，她吃着她的乳儿的婚酒，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"坐在辉煌的结彩的堂上，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"而她的娇美的媳妇亲切地叫她“婆婆”","type":"text"}],"type":"paragraph"},{"runs":[{"text":"……","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大堰河，深爱她的乳儿!","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大堰河，在她的梦没有做醒的时候已死了。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"她死时，乳儿不在她的旁侧，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"她死时，平时打骂她的丈夫也为她流泪，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"五个儿子，个个哭得很悲，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"她死时，轻轻地呼着她的乳儿的名字，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大堰河，已死了，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"她死时，乳儿不在她的旁侧。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大堰河，含泪地去了!","type":"text"}],"type":"paragraph"},{"runs":[{"text":"同着四十几年的人世生活的凌侮，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"同着数不尽的奴隶的凄苦，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"同着四块钱的棺材和几束稻草，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"同着几尺长方的埋棺材的土地，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"同着一手把的纸钱的灰，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大堰河，她含泪地去了。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"这是大堰河所不知道的：","type":"text"}],"type":"paragraph"},{"runs":[{"text":"她的醉酒的丈夫已死去，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大儿做了土匪，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"第二个死在炮火的烟里，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"第三，第四，第五","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在师傅和地主的叱骂声里过着日子。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"而我，我是在写着给予这不公道的世界的咒语。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"当我经了长长的漂泊回到故土时，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在山腰里，田野上，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"兄弟们碰见时，是比六七年前更要亲密!","type":"text"}],"type":"paragraph"},{"runs":[{"text":"这，这是为你，静静地睡着的大堰河","type":"text"}],"type":"paragraph"},{"runs":[{"text":"所不知道的啊!","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大堰河，今天，你的乳儿是在狱里，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"写着一首呈给你的赞美诗，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"呈给你黄土下紫色的灵魂，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"呈给你拥抱过我的直伸着的手，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"呈给你吻过我的唇，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"呈给你泥黑的温柔的脸颜，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"呈给你养育了我的乳房，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"呈给你的儿子们，我的兄弟们，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"呈给大地上一切的，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我的大堰河般的保姆和她们的儿子，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"呈给爱我如爱她自己的儿子般的大堰河。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大堰河，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我是吃了你的奶而长大了的","type":"text"}],"type":"paragraph"},{"runs":[{"text":"你的儿子，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我敬你","type":"text"}],"type":"paragraph"},{"runs":[{"text":"爱你!","type":"text"}],"type":"paragraph"},{"runs":[{"text":"1933 年1 月14 日，雪","type":"text"}],"type":"paragraph"},{"blocks":[{"runs":[{"text":"〔瓦菲〕这里指生长在瓦缝中的野草。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"〔火钵（bō）〕用来盛火取暖的瓦盆。钵，陶制的器具，形状像盆而小。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"〔团箕〕一种用竹篾或柳条编成的圆形器具，用来盛晒粮食等。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"〔冬米〕即糯米，也叫“江米”。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"frontMatter":[{"blocks":[{"runs":[{"text":"选自《艾青诗选》（人民文学出版社1997 年版）。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大堰河，即浙江金华方言中“大叶荷”的谐音。艾青的奶妈是大叶荷村人，她是童养媳，没有自己的名字，当地人因此就叫她“大叶荷”。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"guidance":[],"links":[{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%ba%8c%e5%8d%95%e5%85%83/6-%e5%a4%a7%e5%a0%b0%e6%b2%b3-%e6%88%91%e7%9a%84%e4%bf%9d%e5%a7%86-%e8%89%be%e9%9d%92","sourceUrl":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%ba%8c%e5%8d%95%e5%85%83/6-%e5%a4%a7%e5%a0%b0%e6%b2%b3-%e6%88%91%e7%9a%84%e4%bf%9d%e5%a7%86-%e8%89%be%e9%9d%92","text":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%ba%8c%e5%8d%95%e5%85%83/6-%e5%a4%a7%e5%a0%b0%e6%b2%b3-%e6%88%91%e7%9a%84%e4%bf%9d%e5%a7%86-%e8%89%be%e9%9d%92","title":null}],"media":[],"sourceOnlyBlocks":[],"sourcePostId":10468,"sourcePostNumber":1},"mediaReceiptLedgerSha256":"5487243dd8d14d65dfadc20ed544a999aaa318fc20c291462ea62c69e1eff320","mediaReceiptLedgerVersion":"2026-07-30.2","provenance":{"links":[{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%ba%8c%e5%8d%95%e5%85%83/6-%e5%a4%a7%e5%a0%b0%e6%b2%b3-%e6%88%91%e7%9a%84%e4%bf%9d%e5%a7%86-%e8%89%be%e9%9d%92","postId":10468,"postNumber":1,"postRole":"primary","sourceUrl":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%ba%8c%e5%8d%95%e5%85%83/6-%e5%a4%a7%e5%a0%b0%e6%b2%b3-%e6%88%91%e7%9a%84%e4%bf%9d%e5%a7%86-%e8%89%be%e9%9d%92","text":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%ba%8c%e5%8d%95%e5%85%83/6-%e5%a4%a7%e5%a0%b0%e6%b2%b3-%e6%88%91%e7%9a%84%e4%bf%9d%e5%a7%86-%e8%89%be%e9%9d%92","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#p-10471-h-1","postId":10471,"postNumber":4,"postRole":"discussion","sourceUrl":"https://forum.rdfzer.com/#p-10471-h-1","text":"#p-10471-h-1","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/uploads/short-url/5vqSBisM1psXAUrJ6KIVf8gRtGu.pdf","postId":49853,"postNumber":5,"postRole":"resource-only","sourceUrl":"https://forum.rdfzer.com/uploads/short-url/5vqSBisM1psXAUrJ6KIVf8gRtGu.pdf","text":"32补-艾青诗选-艾青着,人民文学出版社1997年版.pdf","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/uploads/short-url/eG3plc4FdYkagPtkaarrYaV5H7I.pdf","postId":50421,"postNumber":6,"postRole":"resource-only","sourceUrl":"https://forum.rdfzer.com/uploads/short-url/eG3plc4FdYkagPtkaarrYaV5H7I.pdf","text":"NCL-004100974.pdf","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/uploads/short-url/bFBdv63qjqg5Lpj2NrXS5nC2Q1p.pdf","postId":50421,"postNumber":6,"postRole":"resource-only","sourceUrl":"https://forum.rdfzer.com/uploads/short-url/bFBdv63qjqg5Lpj2NrXS5nC2Q1p.pdf","text":"NCL-003907032.pdf","title":null}],"media":[],"posts":[{"cookedSha256":"c40ebe3c72fe32f8c1717d02fd98b8b152a3cfc629368d640690e5173027ba8d","createdAt":"2024-08-10T03:07:29Z","plainTextSha256":"088d970a163846d03e3aa99d9a0e97c246312be4d7b74c01e13bafb649d670f3","postId":10468,"postNumber":1,"replyToPostNumber":null,"role":"primary","updatedAt":"2025-02-15T02:52:56Z"},{"cookedSha256":"dc0500eb82f5fc121d91fcc257332e18c21800dd2bd2e35fed8bcd3d34284fa1","createdAt":"2024-08-10T03:08:38Z","plainTextSha256":"8822c36e3cefb7be6cc6c947868d8a394b69017a44bf9649221b00f3ca8ddf40","postId":10469,"postNumber":2,"replyToPostNumber":null,"role":"discussion","updatedAt":"2024-08-10T03:08:38Z"},{"cookedSha256":"d8206024611963d2209fd159096c71aa091ed7a18b5354dbb6d114412d6e8536","createdAt":"2024-08-10T03:08:49Z","plainTextSha256":"3dc2b1b52f8ae83aec01edd1264d4588cced7a6eb1ef1093925d4d523fe4b582","postId":10471,"postNumber":4,"replyToPostNumber":null,"role":"discussion","updatedAt":"2024-08-10T03:08:49Z"},{"cookedSha256":"1f60d885334bc70558854b26564235693518adde6f89cfbd0098526bf64527e3","createdAt":"2025-03-17T04:33:54Z","plainTextSha256":"2d43dbd27df45ee8301f569347d3eedb3825deb6637b3014d6afc29b392f1123","postId":49853,"postNumber":5,"replyToPostNumber":null,"role":"resource-only","updatedAt":"2025-03-17T04:33:54Z"},{"cookedSha256":"4fb4b62531200b4054275a62e71c6ddd4ef57cc03e1e4c14ff1533cbca0d6296","createdAt":"2025-03-18T15:09:30Z","plainTextSha256":"8d8647020282dc1f3fc2da92020de637dbdabebee9cd661e6ab176708cbe2aa5","postId":50421,"postNumber":6,"replyToPostNumber":null,"role":"resource-only","updatedAt":"2025-03-18T15:09:30Z"}],"roleAuditDecisions":[],"sourceLessonPath":"data/lessons/lesson-1567.json","sourceLessonUpdatedAt":"2025-03-18T15:09:30Z","sourcePostCount":5},"resources":[{"disposition":"internal","href":"https://forum.rdfzer.com/uploads/short-url/5vqSBisM1psXAUrJ6KIVf8gRtGu.pdf","kind":"link","label":"32补-艾青诗选-艾青着,人民文学出版社1997年版.pdf","postId":49853,"postNumber":null,"sourceUrl":"https://forum.rdfzer.com/uploads/short-url/5vqSBisM1psXAUrJ6KIVf8gRtGu.pdf"},{"disposition":"internal","href":"https://forum.rdfzer.com/uploads/short-url/bFBdv63qjqg5Lpj2NrXS5nC2Q1p.pdf","kind":"link","label":"NCL-003907032.pdf","postId":50421,"postNumber":null,"sourceUrl":"https://forum.rdfzer.com/uploads/short-url/bFBdv63qjqg5Lpj2NrXS5nC2Q1p.pdf"},{"disposition":"internal","href":"https://forum.rdfzer.com/uploads/short-url/eG3plc4FdYkagPtkaarrYaV5H7I.pdf","kind":"link","label":"NCL-004100974.pdf","postId":50421,"postNumber":null,"sourceUrl":"https://forum.rdfzer.com/uploads/short-url/eG3plc4FdYkagPtkaarrYaV5H7I.pdf"},{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%ba%8c%e5%8d%95%e5%85%83/6-%e5%a4%a7%e5%a0%b0%e6%b2%b3-%e6%88%91%e7%9a%84%e4%bf%9d%e5%a7%86-%e8%89%be%e9%9d%92","kind":"link","label":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%ba%8c%e5%8d%95%e5%85%83/6-%e5%a4%a7%e5%a0%b0%e6%b2%b3-%e6%88%91%e7%9a%84%e4%bf%","postId":null,"postNumber":1,"sourceUrl":"https://sites.google.com/view/pkuschool/%e9%81%b8%e5%bf%85%e4%b8%8b/%e7%ac%ac%e4%ba%8c%e5%8d%95%e5%85%83/6-%e5%a4%a7%e5%a0%b0%e6%b2%b3-%e6%88%91%e7%9a%84%e4%bf%9d%e5%a7%86-%e8%89%be%e9%9d%92"}],"roleAuditSha256":"65654ae8bd58de3c8040438da7fc213c00b7175d6dc82802a995f46c4cdfd4a7","roleAuditVersion":"2026-07-30.2","schemaVersion":"yw-reader-document-v1","supplementary":[],"title":"6 大堰河——我的保姆/ 艾青"}
