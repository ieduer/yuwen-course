{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1692-p1","main":{"annotations":[{"blocks":[{"runs":[{"text":"选自《郭沫若全集·文学编》第一卷（人民文学出版社1982 年版）。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11124-1"},{"blocks":[{"runs":[{"text":"律吕：古代用竹管或金属管制成的校正乐律的器具，以管的长短来确定音的不同高度。后来用“律吕”作为音律的统称。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11124-2"}],"blocks":[{"runs":[{"text":"立在地球边上放号","type":"text"},{"label":"[1]","noteId":"footnote-11124-1","type":"annotation-ref"},{"text":"\n\n郭沫若","type":"text"}],"type":"paragraph"},{"runs":[{"text":"无数的白云正在空中怒涌，\n\n啊啊！好幅壮丽的北冰洋的晴景哟！\n\n无限的太平洋提起他全身的力量来要把地球推倒。\n\n啊啊！我眼前来了的滚滚的洪涛哟！\n\n啊啊！不断的毁坏，不断的创造，不断的努力哟！\n\n啊啊！力哟！力哟！\n\n力的绘画，力的舞蹈，力的音乐，力的诗歌，力的律吕","type":"text"},{"label":"[2]","noteId":"footnote-11124-2","type":"annotation-ref"},{"text":"哟！\n\n1919 年9、10 月间作","type":"text"}],"type":"paragraph"}],"frontMatter":[],"guidance":[],"links":[],"media":[],"sourceOnlyBlocks":[],"sourcePostId":"11124-1","sourcePostNumber":1},"mediaReceiptLedgerSha256":"0319bd9f7623eb57ee396cafc0343cb6c4dc51dce258109a19edbdddd91be71c","mediaReceiptLedgerVersion":"2026-08-09.1","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11124-1","postId":"11124-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11124-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11124-2","postId":"11124-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11124-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11124-3","postId":"11124-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11124-3","text":"[3]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11124-4","postId":"11124-1","postNumber":1,"postR