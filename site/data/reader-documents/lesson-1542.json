{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1542","main":{"annotations":[],"blocks":[{"runs":[{"text":"普希金向大海告别 ［俄］艾瓦佐夫斯基、列宾 合作","type":"text"}],"type":"paragraph"},{"blocks":[{"runs":[{"text":"再见吧，自由的元素！","type":"text"}],"type":"paragraph"},{"runs":[{"text":"最后一次了，在我眼前","type":"text"}],"type":"paragraph"},{"runs":[{"text":"你的蓝色的浪头翻滚起伏，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"你的骄傲的美闪烁壮观。","type":"text"}],"type":"paragraph"}],"type":"quote"},{"blocks":[{"runs":[{"text":"仿佛友人的忧郁的絮语，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"仿佛他别离一刻的招呼，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"最后一次了，我听着你的","type":"text"}],"type":"paragraph"},{"runs":[{"text":"喧声呼唤，你的沉郁的吐诉。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我全心渴望的国度啊，大海！","type":"text"}],"type":"paragraph"},{"runs":[{"text":"多么常常地，在你的岸上","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我静静地，迷惘地徘徊，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"苦思着我那珍爱的愿望。","type":"text"}],"type":"paragraph"}],"type":"quote"},{"blocks":[{"runs":[{"text":"啊，我多么爱听你的回声，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"那喑哑的声音，那深渊之歌，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我爱听你黄昏时分的幽静，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"和你任性的脾气的发作！","type":"text"}],"type":"paragraph"}],"type":"quote"},{"blocks":[{"runs":[{"text":"渔人的渺小的帆凭着","type":"text"}],"type":"paragraph"},{"runs":[{"text":"你的喜怒无常的保护","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在两齿之间大胆地滑过，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"但你若汹涌起来，无法克服，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"成群的渔船就会覆没。","type":"text"}],"type":"paragraph"}],"type":"quote"},{"blocks":[{"runs":[{"text":"直到现在，我还不能离开","type":"text"}],"type":"paragraph"},{"runs":[{"text":"这令我厌烦的凝固的石岸，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我还没有热烈地拥抱你，大海！","type":"text"}],"type":"paragraph"},{"runs":[{"text":"也没有让我的诗情的波澜","type":"text"}],"type":"paragraph"},{"runs":[{"text":"随着你的山脊跑开！","type":"text"}],"type":"paragraph"}],"type":"quote"},{"blocks":[{"runs":[{"text":"你在期待，呼唤……我却被缚住，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我的心徒然想要挣脱开，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"是更强烈的感情把我迷住，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"于是我在岸边留下来……","type":"text"}],"type":"paragraph"}],"type":"quote"},{"blocks":[{"runs":[{"text":"有什么可顾惜的？而今哪里","type":"text"}],"type":"paragraph"},{"runs":[{"text":"能使我奔上坦荡的途径？","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在你的荒凉中，只有一件东西","type":"text"}],"type":"paragraph"},{"runs":[{"text":"也许还激动我的心灵。","type":"text"}],"type":"paragraph"}],"type":"quote"},{"blocks":[{"runs":[{"text":"一面峭壁，一座光荣的坟墓……","type":"text"}],"type":"paragraph"},{"runs":[{"text":"那里，种种伟大的回忆","type":"text"}],"type":"paragraph"},{"runs":[{"text":"已在寒冷的梦里沉没，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"啊，是拿破仑熄灭在那里。","type":"text"}],"type":"paragraph"}],"type":"quote"},{"blocks":[{"runs":[{"text":"他已经在苦恼里长眠。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"紧随着他，另一个天才","type":"text"}],"type":"paragraph"},{"runs":[{"text":"像风暴之声驰过我们面前，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"啊，我们心灵的另一个主宰。","type":"text"}],"type":"paragraph"}],"type":"quote"},{"blocks":[{"runs":[{"text":"他去了，使自由在悲泣中！","type":"text"}],"type":"paragraph"},{"runs":[{"text":"他把自己的桂冠留给世上。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"喧腾吧，为险恶的天时而汹涌，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"噢，大海！他曾经为你歌唱。","type":"text"}],"type":"paragraph"}],"type":"quote"},{"blocks":[{"runs":[{"text":"他是由你的精气塑成的，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"海啊，他是你的形象的反映；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"他像你似的深沉，有力，阴郁，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"他也倔强得和你一样。","type":"text"}],"type":"paragraph"}],"type":"quote"},{"blocks":[{"runs":[{"text":"世界空虚了……哦，海洋，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"现在你还能把我带到哪里？","type":"text"}],"type":"paragraph"},{"runs":[{"text":"到处，人们的命运都是一样：","type":"text"}],"type":"paragraph"},{"runs":[{"text":"哪里有幸福，必有教育","type":"text"}],"type":"paragraph"},{"runs":[{"text":"或暴君看守得非常严密。","type":"text"}],"type":"paragraph"}],"type":"quote"},{"blocks":[{"runs":[{"text":"再见吧，大海！你壮观的美色","type":"text"}],"type":"paragraph"},{"runs":[{"text":"将永远不会被我遗忘；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我将久久地，久久地听着","type":"text"}],"type":"paragraph"},{"runs":[{"text":"你在黄昏时分的轰响。","type":"text"}],"type":"paragraph"}],"type":"quote"},{"blocks":[{"runs":[{"text":"心里充满了你，我将要把","type":"text"}],"type":"paragraph"},{"runs":[{"text":"你的山岩，你的海湾，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"你的光和影，你的浪花的喋喋，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"带到森林，带到寂静的荒原。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"frontMatter":[{"blocks":[{"runs":[{"text":"选自《普希金抒情诗选集》（江苏人民出版社1982年版）。查良铮译。略有改动。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"guidance":[],"links":[{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/xbz000/%e7%ac%ac%e5%9b%9b%e5%8d%95%e5%85%83/%e8%87%b4%e5%a4%a7%e6%b5%b7-%e6%99%ae%e5%b8%8c%e9%87%91","sourceUrl":"https://sites.google.com/view/pkuschool/xbz000/%e7%ac%ac%e5%9b%9b%e5%8d%95%e5%85%83/%e8%87%b4%e5%a4%a7%e6%b5%b7-%e6%99%ae%e5%b8%8c%e9%87%91","text":"https://sites.google.com/view/pkuschool/xbz000/%e7%ac%ac%e5%9b%9b%e5%8d%95%e5%85%83/%e8%87%b4%e5%a4%a7%e6%b5%b7-%e6%99%ae%e5%b8%8c%e9%87%91","title":null}],"media":[{"alt":"","bytes":79705,"finalUrl":"https://files.rdfzer.com/original/2X/a/aa0d895e01664d4ddaa41309d2f401352966ef0e.jpeg","height":569,"id":"media-21003ed923cf17f65eb9","mediaType":"image/jpeg","nativeDisposition":"verified-in-app","receiptCollectedAt":"2026-07-30T01:10:43.464Z","receiptRequired":true,"rightsBasis":"user-authorized-course-source-use-2026-07-29","sha256":"b8b8bc0421c2b3d1266e3ce00fda9a7535325e19aec