{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1691","main":{"annotations":[{"blocks":[{"runs":[{"text":"橘子洲：又名水陆洲，在长沙城西的湘江中。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11123-1"},{"blocks":[{"runs":[{"text":"层林尽染：山上一层层的树林全都经霜变红，像染过一样。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11123-2"},{"blocks":[{"runs":[{"text":"漫江：满江。漫，遍布。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11123-3"},{"blocks":[{"runs":[{"text":"舸（ɡě）：大船。这里泛指船只。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11123-4"},{"blocks":[{"runs":[{"text":"鹰击长空，鱼翔浅底：鹰在广阔的天上飞，鱼在清澈的水里游。击，搏击，这里形容飞得矫健有力。翔，本指鸟盘旋飞翔，这里形容鱼游得轻快自由。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11123-5"},{"blocks":[{"runs":[{"text":"万类霜天竞自由：万物都在深秋竞相自由地活动。霜天，深秋天气。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11123-6"},{"blocks":[{"runs":[{"text":"怅（chàng）：失意，不畅快。这里用来表达由深思而引发的激昂慷慨的心绪。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11123-7"},{"blocks":[{"runs":[{"text":"寥廓：指宇宙高远辽阔。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11123-8"},{"blocks":[{"runs":[{"text":"苍茫：旷远迷茫。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11123-9"},{"blocks":[{"runs":[{"text":"主：主宰。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11123-10"},{"blocks":[{"runs":[{"text":"沉浮：这里指盛衰。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11123-11"},{"blocks":[{"runs":[{"text":"百侣：众多同伴。侣，这里指同学。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11123-12"},{"blocks":[{"runs":[{"text":"峥嵘岁月稠：不寻常的日子很多。峥嵘，不平凡、不寻常。稠，多。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11123-13"},{"blocks":[{"runs":[{"text":"风华正茂：风采才华正盛。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11123-14"},{"blocks":[{"runs":[{"text":"书生意气，挥斥方遒（qiú）：同学们意气奔放，正强劲有力。挥斥，纵放、奔放。遒，强劲有力。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11123-15"},{"blocks":[{"runs":[{"text":"指点江山，激扬文字：评论国家大事，写出激浊扬清的文章。指点，评论。江山，指国家。激扬，激浊扬清，抨击恶浊，褒扬清明。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11123-16"},{"blocks":[{"runs":[{"text":"粪土当年万户侯：意思是把当时的军阀官僚看得同粪土一样。粪土，视……如粪土，表鄙视。万户侯，本指食邑万户的封侯者，这里借指大军阀、大官僚。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11123-17"},{"blocks":[{"runs":[{"text":"中流：江河水流中央。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11123-18"},{"blocks":[{"runs":[{"text":"击水：指游泳。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11123-19"},{"blocks":[{"runs":[{"text":"遏（è）：阻止。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11123-20"}],"blocks":[{"runs":[{"text":"沁园春·长沙\n\n毛泽东","type":"text"}],"type":"paragraph"},{"runs":[{"text":"独立寒秋，\n\n湘江北去，\n\n橘子洲","type":"text"},{"label":"[1]","noteId":"footnote-11123-1","type":"annotation-ref"},{"text":"头。\n\n看万山红遍，\n\n层林尽染","type":"text"},{"label":"[2]","noteId":"footnote-11123-2","type":"annotation-ref"},{"text":"；\n\n漫江","type":"text"},{"label":"[3]","noteId":"footnote-11123-3","type":"annotation-ref"},{"text":"碧透，\n\n百舸","type":"text"},{"label":"[4]","noteId":"footnote-11123-4","type":"annotation-ref"},{"text":"争流。\n\n鹰击长空，\n\n鱼翔浅底","type":"text"},{"label":"[5]","noteId":"footnote-11123-5","type":"annotation-ref"},{"text":"，\n\n万类霜天竞自由","type":"text"},{"label":"[6]","noteId":"footnote-11123-6","type":"annotation-ref"},{"text":"。\n\n怅","type":"text"},{"label":"[7]","noteId":"footnote-11123-7","type":"annotation-ref"},{"text":"寥廓","type":"text"},{"label":"[8]","noteId":"footnote-11123-8","type":"annotation-ref"},{"text":"，\n\n问苍茫","type":"text"},{"label":"[9]","noteId":"footnote-11123-9","type":"annotation-ref"},{"text":"大地，\n\n谁主","type":"text"},{"label":"[10]","noteId":"footnote-11123-10","type":"annotation-ref"},{"text":"沉浮","type":"text"},{"label":"[11]","noteId":"footnote-11123-11","type":"annotation-ref"},{"text":"？","type":"text"}],"type":"paragraph"},{"runs":[{"text":"携来百侣","type":"text"},{"label":"[12]","noteId":"footnote-11123-12","type":"annotation-ref"},{"text":"曾游。\n\n忆往昔峥嵘岁月稠","type":"text"},{"label":"[13]","noteId":"footnote-11123-13","type":"annotation-ref"},{"text":"。\n\n恰同学少年，\n\n风华正茂","type":"text"},{"label":"[14]","noteId":"footnote-11123-14","type":"annotation-ref"},{"text":"；\n\n书生意气，\n\n挥斥方遒","type":"text"},{"label":"[15]","noteId":"footnote-11123-15","type":"annotation-ref"},{"text":"。\n\n指点江山，\n\n激扬文字","type":"text"},{"label":"[16]","noteId":"footnote-11123-16","type":"annotation-ref"},{"text":"，\n\n粪土当年万户侯","type":"text"},{"label":"[17]","noteId":"footnote-11123-17","type":"annotation-ref"},{"text":"。\n\n曾记否，\n\n到中流","type":"text"},{"label":"[18]","noteId":"footnote-11123-18","type":"annotation-ref"},{"text":"击水","type":"text"},{"label":"[19]","noteId":"footnote-11123-19","type":"annotation-ref"},{"text":"，\n\n浪遏","type":"text"},{"label":"[20]","noteId":"footnote-11123-20","type":"annotation-ref"},{"text":"飞舟？\n\n1925 年","type":"text"}],"type":"paragraph"},{"type":"divider"},{"blocks":[{"runs":[{"text":"学习提示\n\n面对“万类霜天竞自由”的壮丽秋景，毛泽东填写了这首词，抒发昂扬向上的青春激情，表达雄视天下的凌云壮志。阅读时注意领略毛泽东以天下为己任的胸怀，品味其中意象的活泼灵动、意境的丰盈深邃。要反复诵读，仔细揣摩，体会这首词炼字选词的精妙之处。老一辈无产阶级革命家的很多诗词都能引发我们对青春的思考，可以课外阅读毛泽东《水调歌头·游泳》、周恩来《赤光的宣言》、朱德《太行春感》、陈毅《赣南游击词》等，感受他们的情怀。\n\n背诵课文。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"frontMatter":[{"blocks":[{"runs":[{"text":"选自《毛泽东诗词集》（中央文献出版社1996年版）。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"guidance":[],"links":[],"media":[],"sourceOnlyBlocks":[],"sourcePostId":11123,"sourcePostNumber":1},"mediaReceiptLedgerSha256":"0319bd9f7623eb57ee396cafc0343cb6c4dc51dce258109a19edbdddd91be71c","mediaReceiptLedgerVersion":"2026-08-09.1","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11123-1","postId":11123,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11123-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11123-2","postId":11123,"postNumber":1,"postRole":"pri