1","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11190-2","postId":11190,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11190-2","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11190-3","postId":11190,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11190-3","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11190-4","postId":11190,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11190-4","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11190-5","postId":11190,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11190-5","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11190-6","postId":11190,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11190-6","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11190-7","postId":11190,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11190-7","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11190-8","postId":11190,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11190-8","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11190-9","postId":11190,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11190-9","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11190-10","postId":11190,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11190-10","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11190-11","postId":11190,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11190-11","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11190-12","postId":11190,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11190-12","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11190-13","postId":11190,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11190-13","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11190-14","postId":11190,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11190-14","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11190-15","postId":11190,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11190-15","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11190-16","postId":11190,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11190-16","text":"↩︎","title":null}],"media":[{"alt":"","bytes":257610,"finalUrl":"https://files.rdfzer.com/original/2X/5/594ceca9001383b4da614148a0cdb7e47348d91c.jpeg","height":595,"id":"media-6685dbe97e83cad7f376","mediaType":"image/jpeg","nativeDisposition":"verified-in-app","postId":11190,"postNumber":1,"postRole":"primary","receiptCollectedAt":"2026-07-30T01:10:43.464Z","receiptRequired":true,"rightsBasis":"user-authorized-course-source-use-2026-07-29","sha256":"3a8b1b93ca96505e0ca35002beaac33ba3912d206a1c8d080b5acff431df1695","sourceUrl":"https://files.rdfzer.com/original/2X/5/594ceca9001383b4da614148a0cdb7e47348d91c.jpeg","webDisposition":"source-url","width":835}],"posts":[{"cookedSha256":"e761c138ed39246d5e262638fb84d8aae0b19f2a3c887364f7b158f829d34980","createdAt":"2024-08-22T10:19:23Z","plainTextSha256":"2844fc83a27fb007a9987e422d5f85000c82d74c4eb7b16a8b282874fc9b5fb9","postId":11190,"postNumber":1,"replyToPostNumber":null,"role":"primary","updatedAt":"2024-08-22T10:19:23Z"}],"roleAuditDecisions":[],"sourceLessonPath":"data/lessons/lesson-1742.json","sourceLessonUpdatedAt":"2024-08-22T10:19:23Z","sourcePostCount":1},"resources":[],"roleAuditSha256":"65654ae8bd58de3c8040438da7fc213c00b7175d6dc82802a995f46c4cdfd4a7","roleAuditVersion":"2026-07-30.2","schemaVersion":"yw-reader-document-v1","supplementary":[],"title":"10 在《人民报》创刊纪念会上的演说"}
