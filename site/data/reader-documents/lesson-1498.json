{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1498","main":{"annotations":[{"blocks":[{"runs":[{"text":"滟滟：形容波光荡漾。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10076-1"},{"blocks":[{"runs":[{"text":"月明：月光。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10076-2"},{"blocks":[{"runs":[{"text":"芳甸：花草茂盛的原野。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10076-3"},{"blocks":[{"runs":[{"text":"霰（xiàn）：白色不透明的小冰粒。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10076-4"},{"blocks":[{"runs":[{"text":"流霜：飞霜，比喻从空中洒落的月光。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10076-5"},{"blocks":[{"runs":[{"text":"青枫浦：即双枫浦，在湖南浏阳南。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10076-6"},{"blocks":[{"runs":[{"text":"扁舟子：指飘荡江湖的游子。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10076-7"},{"blocks":[{"runs":[{"text":"明月楼：明月映照下的楼阁。这里指楼上的思妇。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10076-8"},{"blocks":[{"runs":[{"text":"裴回：同“徘徊”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10076-9"},{"blocks":[{"runs":[{"text":"离人：指守候在家的思妇。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10076-10"},{"blocks":[{"runs":[{"text":"玉户帘中卷不去：意思是，月光洒在玉门帘上，欲卷而去之而不得。玉户，用玉装饰的门，也用作门的美称。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10076-11"},{"blocks":[{"runs":[{"text":"月华：月光。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10076-12"},{"blocks":[{"runs":[{"text":"流照：照射。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10076-13"},{"blocks":[{"runs":[{"text":"鸿雁长飞光不度：大雁远飞却不能飞出月光。暗示鸿雁不能传书。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10076-14"},{"blocks":[{"runs":[{"text":"鱼龙潜跃水成文：鱼儿出没只能使水面泛出波纹。暗示鱼儿不能传书。古人有鱼儿传书一说。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10076-15"},{"blocks":[{"runs":[{"text":"潇湘：潇水和湘江，均流入洞庭湖。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10076-16"},{"blocks":[{"runs":[{"text":"落月摇情满江树：意思是，落月牵动着离人的别愁，将光辉洒满江畔的林木。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10076-17"}],"blocks":[{"runs":[{"text":"春江潮水连海平，海上明月共潮生。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"滟滟","type":"text"},{"label":"[1]","noteId":"footnote-10076-1","type":"annotation-ref"},{"text":"随波千万里，何处春江无月明","type":"text"},{"label":"[2]","noteId":"footnote-10076-2","type":"annotation-ref"},{"text":"。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"江流宛转绕芳甸","type":"text"},{"label":"[3]","noteId":"footnote-10076-3","type":"annotation-ref"},{"text":"，月照花林皆似霰","type":"text"},{"label":"[4]","noteId":"footnote-10076-4","type":"annotation-ref"},{"text":"。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"空里流霜","type":"text"},{"label":"[5]","noteId":"footnote-10076-5","type":"annotation-ref"},{"text":"不觉飞，汀上白沙看不见。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"江天一色无纤尘，皎皎空中孤月轮。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"江畔何人初见月？江月何年初照人？","type":"text"}],"type":"paragraph"},{"runs":[{"text":"人生代代无穷已，江月年年望相似。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"不知江月待何人，但见长江送流水。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"白云一片去悠悠，青枫浦","type":"text"},{"label":"[6]","noteId":"footnote-10076-6","type":"annotation-ref"},{"text":"上不胜愁。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"谁家今夜扁舟子","type":"text"},{"label":"[7]","noteId":"footnote-10076-7","type":"annotation-ref"},{"text":"？何处相思明月楼","type":"text"},{"label":"[8]","noteId":"footnote-10076-8","type":"annotation-ref"},{"text":"？","type":"text"}],"type":"paragraph"},{"runs":[{"text":"可怜楼上月裴回","type":"text"},{"label":"[9]","noteId":"footnote-10076-9","type":"annotation-ref"},{"text":"，应照离人","type":"text"},{"label":"[10]","noteId":"footnote-10076-10","type":"annotation-ref"},{"text":"妆镜台。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"玉户帘中卷不去","type":"text"},{"label":"[11]","noteId":"footnote-10076-11","type":"annotation-ref"},{"text":"，捣衣砧上拂还来。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"此时相望不相闻，愿逐月华","type":"text"},{"label":"[12]","noteId":"footnote-10076-12","type":"annotation-ref"},{"text":"流照","type":"text"},{"label":"[13]","noteId":"footnote-10076-13","type":"annotation-ref"},{"text":"君。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"鸿雁长飞光不度","type":"text"},{"label":"[14]","noteId":"footnote-10076-14","type":"annotation-ref"},{"text":"，鱼龙潜跃水成文","type":"text"},{"label":"[15]","noteId":"footnote-10076-15","type":"annotation-ref"},{"text":"。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"昨夜闲潭梦落花，可怜春半不还家。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"江水流春去欲尽，江潭落月复西斜。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"斜月沉沉藏海雾，碣石潇湘","type":"text"},{"label":"[16]","noteId":"footnote-10076-16","type":"annotation-ref"},{"text":"无限路。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"不知乘月几人归，落月摇情满江树","type":"text"},{"label":"[17]","noteId":"footnote-10076-17","type":"annotation-ref"},{"text":"。","type":"text"}],"type":"paragraph"},{"blocks":[{"runs":[{"text":"这首诗以月升、月悬、月斜、月落为线索，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"贯串叙事、写景、议论、抒情，把春、江、花、月、夜的景色和情理融为一体，空灵而美妙；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"而所有场景的转换都有内在的连续性，自然而流畅。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"毫无疑问，这一切是因为人的观照：","type":"text"}],"type":"paragraph"},{"runs":[{"text":"人对美景的赏鉴和美景对人的情思的启发，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"自然的恒久与个体生命的短暂，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"游子的离情别绪和亲人的相思之苦，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"交互感发，让人心旌摇荡。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"诵读这首诗，感受诗人以月为核心意象营造出的空灵曼妙的意境，体会其中寄寓的情怀和哲思。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"春江花月夜 ［清］袁江 作","type":"text"}],"type":"paragraph"}],"type":"quote"},{"runs":[{"text":"drive.google.com","type":"text"}],"type":"paragraph"},{"level":3,"runs":[{"disposition":"system-browser","href":"https://drive.google.com/file/d/1QsXuntTYR9ltdcZ0xGd_mSDL_UCJ6hCO/view?usp=sharing","sourceUrl":"https://drive.google.com/file/d/1QsXuntTYR9ltdcZ0xGd_mSDL_UCJ6hCO/view?usp=sharing","text":"闻一多全集 06 唐诗编 上（湖北人民出版社1993）.pdf","type":"link"}],"type":"heading"},{"runs":[{"text":"Google Drive file.","type":"text"}],"type":"paragraph"}],"frontMatter":[{"blocks":[{"runs":[{"text":"选自《全唐诗》卷二十一（中华书局1999 年版）。\n\n春江花月夜，乐府旧题。张若虚（约660—约720），扬州（今属江苏）人，唐代诗人。与贺知章、张旭、包融并称“吴中四士”。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"guidance":[],"links":[{"disposition":"system-browser","href":"https://drive.google.com/file/d/1QsXuntTYR9ltdcZ0xGd_mSDL_UCJ6hCO/view?usp=sharing","sourceUrl":"https://drive.google.com/file/d/1QsXuntTYR9ltdcZ0xGd_mSDL_UCJ6hCO/view?usp=sharing","text":"闻一多全集 06 唐诗编 上（湖北人民出版社1993）.pdf","title":null},{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/cover3/%e4%b8%ad%e5%9b%bd%e5%8f%a4%e5%85%b8%e8%af%97%e6%ad%8c%e7%9a%84%e6%84%8f%e8%b1%a1/%e6%98%a5%e6%b1%9f%e8%8a%b1%e6%9c%88%e5%a4%9c%e5%bc%a0%e8%8b%a5%e8%99%9a","sourceUrl":"https://sites.google.com/view/pkuschool/cover3/%e4%b8%ad%e5%9b%bd%e5%8f%a4%e5%85%b8%e8%af%97%e6%ad%8c%e7%9a%84%e6%84%8f%e8%b1%a1/%e6%98%a5%e6%b1%9f%e8%8a%b1%e6%9c%88%e5%a4%9c%e5%bc%a0%e8%8b%a5%e8%99%9a","text":"https://sites.google.com/view/pkuschool/cover3/%e4%b8%ad%e5%9b%bd%e5%8f%a4%e5%85%b8%e8%af%97%e6%ad%8c%e7%9a%84%e6%84%8f%e8%b1%a1/%e6%98%a5%e6%b1%9f%e8%8a%b1%e6%9c%88%e5%a4%9c%e5%bc%a0%e8%8b%a5%e8%99%9a","title":null}],"media":[{"alt":"","bytes":62397,"finalUrl":"https://files.rdfzer.com/original/2X/3/34acd1dcd582979755fe61bbbf898ddd6c0924d4.jpeg","height":572,"id":"media-cf0931367453d577a8ed","mediaType":"image/jpeg","nativeDisposition":"verified-in-app","receiptCollectedAt":"2026-07-30T01:10:43.464Z","receiptRequired":true,"rightsBasis":"user-authorized-course-source-use-2026-07-29","sha256":"a7ee075cad0e8361cfc547162a15450f39cfc221f7dd65434605d06fe853315d","sourceUrl":"https://files.rdfzer.com/original/