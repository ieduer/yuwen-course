Number":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10076-15","text":"[15]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10076-16","postId":10076,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10076-16","text":"[16]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10076-17","postId":10076,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10076-17","text":"[17]","title":null},{"disposition":"system-browser","href":"https://files.rdfzer.com/original/2X/3/34acd1dcd582979755fe61bbbf898ddd6c0924d4.jpeg","postId":10076,"postNumber":1,"postRole":"primary","sourceUrl":"https://files.rdfzer.com/original/2X/3/34acd1dcd582979755fe61bbbf898ddd6c0924d4.jpeg","text":"https://files.rdfzer.com/original/2X/3/34acd1dcd582979755fe61bbbf898ddd6c0924d4.jpeg","title":null},{"disposition":"system-browser","href":"https://files.rdfzer.com/original/2X/3/3a7bd7702a97970cc3c961e829d7088b8c10f42c.jpeg","postId":10076,"postNumber":1,"postRole":"primary","sourceUrl":"https://files.rdfzer.com/original/2X/3/3a7bd7702a97970cc3c961e829d7088b8c10f42c.jpeg","text":"https://files.rdfzer.com/original/2X/3/3a7bd7702a97970cc3c961e829d7088b8c10f42c.jpeg","title":null},{"disposition":"system-browser","href":"https://drive.google.com/file/d/1QsXuntTYR9ltdcZ0xGd_mSDL_UCJ6hCO/view?usp=sharing","postId":10076,"postNumber":1,"postRole":"primary","sourceUrl":"https://drive.google.com/file/d/1QsXuntTYR9ltdcZ0xGd_mSDL_UCJ6hCO/view?usp=sharing","text":"drive.google.com","title":null},{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/cover3/%e4%b8%ad%e5%9b%bd%e5%8f%a4%e5%85%b8%e8%af%97%e6%ad%8c%e7%9a%84%e6%84%8f%e8%b1%a1/%e6%98%a5%e6%b1%9f%e8%8a%b1%e6%9c%88%e5%a4%9c%e5%bc%a0%e8%8b%a5%e8%99%9a","postId":10076,"postNumber":1,"postRole":"primary","sourceUrl":"https://sites.google.com/view/pkuschool/cover3/%e4%b8%ad%e5%9b%b