{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1716","main":{"annotations":[],"blocks":[{"runs":[{"text":"人们生活在自然之中，而大自然也已深深融入人","type":"text"}],"type":"paragraph"},{"runs":[{"text":"类的精神世界，成为人类心灵的寄托。通过文学作品","type":"text"}],"type":"paragraph"},{"runs":[{"text":"对自然的描写反观自然，可以提升对自然美的感悟力，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"激发对自然和生活的热爱之情。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"本单元选取的五篇散文，都是写景抒情的名篇，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"有对故都“秋味”的吟唱，对荷塘月色的描写；有北京","type":"text"}],"type":"paragraph"},{"runs":[{"text":"地坛牵出的人生故事；有夜游赤壁的吊古伤今，登临","type":"text"}],"type":"paragraph"},{"runs":[{"text":"东岳的畅想。在对大地山川、风物美景的描写中徜徉，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"既可以受到美的熏陶，又能够领会深厚的人文内涵。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"学习本单元的写景抒情散文，体会民族审美心理，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"提升文学欣赏品位，培养对自然的热爱之情。要关注作","type":"text"}],"type":"paragraph"},{"runs":[{"text":"品中的自然景物描写和人生思考，体会作者观察、欣赏","type":"text"}],"type":"paragraph"},{"runs":[{"text":"和表现自然景物的角度，分析情景交融、情理结合的手","type":"text"}],"type":"paragraph"},{"runs":[{"text":"法；还要反复涵泳咀嚼，感受作品的文辞之美。","type":"text"}],"type":"paragraph"}],"frontMatter":[],"guidance":[],"links":[],"media":[{"alt":"","bytes":99498,"finalUrl":"https://files.rdfzer.com/original/2X/c/cc2d9ade7e4678bebd5a368b1214fd7a28676229.jpeg","height":1146,"id":"media-9a5273eb18bb7a2df575","mediaType":"image/jpeg","nativeDisposition":"verified-in-app","receiptCollectedAt":"2026-07-30T01:10:43.464Z","receiptRequired":true,"rightsBasis":"user-authorized-course-source-use-2026-07-29","sha256":"4c95cfd066978067b8681cd14f2cf2cde7af41497fefa3fe685155d8680b3238","sourceUrl":"https://files.rdfzer.com/original/2X/c/cc2d9ade7e4678bebd5a368b1214fd7a28676229.jpeg","webDisposition":"source-url","width":807}],"sourceOnlyBlocks":[],"sourcePostId":11150,"sourcePostNumber":1},"mediaReceiptLedg