{"curationManifestSha256":"98e90b3603b34b437bc554810c21f01c4db44d10364211af114d30fde3d67bad","curationVersion":"2026-07-30.2","lessonId":"lesson-1692-p2","main":{"annotations":[{"blocks":[{"runs":[{"text":"选自《红烛》（人民文学出版社1981 年版）。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11124-3"},{"blocks":[{"runs":[{"text":"蜡炬成灰泪始干：语出唐李商隐《无题》（相见时难别亦难）。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11124-4"}],"blocks":[{"runs":[{"text":"红 烛","type":"text"},{"label":"[1]","noteId":"footnote-11124-3","type":"annotation-ref"},{"text":"\n\n闻一多\n\n蜡炬成灰泪始干","type":"text"},{"label":"[2]","noteId":"footnote-11124-4","type":"annotation-ref"},{"text":"\n\n——李商隐\n\n红烛啊！\n\n这样红的烛！\n\n诗人啊！\n\n吐出你的心来比比，\n\n可是一般颜色？","type":"text"}],"type":"paragraph"},{"runs":[{"text":"红烛啊！\n\n是谁制的蜡——给你躯体？\n\n是谁点的火——点着灵魂？\n\n为何更须烧蜡成灰，\n\n然后才放光出？\n\n一误再误；\n\n矛盾！冲突！","type":"text"}],"type":"paragraph"},{"runs":[{"text":"红烛啊！\n\n不误，不误！\n\n原是要“烧”出你的光来——\n\n这正是自然的方法。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"红烛啊！\n\n既制了，便烧着！\n\n烧吧！烧吧！\n\n烧破世人的梦，\n\n烧沸世人的血——\n\n也救出他们的灵魂，\n\n也捣破他们的监狱！","type":"text"}],"type":"paragraph"},{"runs":[{"text":"红烛啊！\n\n你心火发光之期，\n\n正是泪流开始之日。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"红烛啊！\n\n匠人造了你，\n\n原是为烧的。\n\n既已烧着，\n\n又何苦伤心流泪？\n\n哦！我知道了！\n\n是残风来侵你的光芒，\n\n你烧得不稳时，\n\n才着急得流泪！","type":"text"}],"type":"paragraph"},{"runs":[{"text":"红烛啊！\n\n流吧！你怎能不流呢？\n\n请将你的脂膏，\n\n不息地流向人间，\n\n培出慰藉的花儿，\n\n结成快乐的果子！","type":"text"}],"type":"paragraph"},{"runs":[{"text":"红烛啊！\n\n你流一滴泪，灰一分心。\n\n灰心流泪你的果，\n\n创造光明你的因。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"红烛啊！\n\n“莫问收获，但问耕耘。”","type":"text"}],"type":"paragraph"}],"frontMatter":[],"guidance":[],"links":[],"media":[],"sourceOnlyBlocks":[],"sourcePostId":"11124-2","sourcePostNumber":1},"mediaReceiptLedgerSha256":"5487243dd8d14d65dfadc20ed544a999aaa318fc20c291462ea62c69e1eff320","mediaReceiptLedgerVersion":"2026-07-30.2","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11124-1","postId":"11124-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11124-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11124-2","postId":"11124-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11124-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11124-3","postId":"11124-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11124-3","text":"[3]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11124-4","postId":"11124-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11124-4","text":"[4]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11124-5","postId":"11124-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11124-5","text":"[5]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11124-6","postId":"11124-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11124-6","text":"[6]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11124-7","postId":"11124-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11124-7","text":"[7]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11124-8","postId":"11124-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11124-8","text":"[8]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11124-1","postId":"11124-2","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-11124-1","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-11124-2","postId":"11124-2","pos