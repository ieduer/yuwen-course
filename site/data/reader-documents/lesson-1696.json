{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1696","main":{"annotations":[],"blocks":[{"runs":[{"text":"劳动改造世界，劳动创造文明。崇尚劳动，尊","type":"text"}],"type":"paragraph"},{"runs":[{"text":"重劳动，热爱劳动，是中华民族世代相传的美德；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"无私奉献，锐意进取，勇于创造，是新时代青年应","type":"text"}],"type":"paragraph"},{"runs":[{"text":"该树立的劳动观念。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"本单元作品，或报道优秀劳动者的杰出事迹，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"或倡导践行工匠精神，或歌咏劳动的美好与欢乐，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"从不同角度彰显劳动的伟大意义，体现劳动精神的","type":"text"}],"type":"paragraph"},{"runs":[{"text":"传承和发展。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"学习本单元，通过专题研讨等活动，深入体会","type":"text"}],"type":"paragraph"},{"runs":[{"text":"“劳动最光荣、劳动最崇高、劳动最伟大、劳动最","type":"text"}],"type":"paragraph"},{"runs":[{"text":"美丽”的思想，形成正确的劳动观念。学会分析通","type":"text"}],"type":"paragraph"},{"runs":[{"text":"讯的报道角度，理解事实与观点的关系，抓住典型","type":"text"}],"type":"paragraph"},{"runs":[{"text":"事件，把握人物精神；了解新闻评论的观点，学习","type":"text"}],"type":"paragraph"},{"runs":[{"text":"阐述观点的方法；辨析和把握新闻的报道立场，提","type":"text"}],"type":"paragraph"},{"runs":[{"text":"升媒介素养。","type":"text"}],"type":"paragraph"}],"frontMatter":[],"guidance":[],"links":[],"media":[{"alt":"","bytes":123876,"finalUrl":"https://files.rdfzer.com/original/2X/f/f1771cb4514a95cda05e450198c7c88cec105698.jpeg","height":1146,"id":"media-e26fcd85a30ae5491b2d","mediaType":"image/jpeg","nativeDisposition":"verified-in-app","receiptCollectedAt":"2026-07-30T01:10:43.464Z","receiptRequired":true,"rightsBasis":"user-authorized-course-source-use-2026-07-29","sha256":"d4547c8c3d6cc13aa8b07977457491a42231cd9d96a440c6a54069b7987a385c","sourceUrl":"https://files.rdfzer.com/original/2X/f/f1771cb4514a95cda05e450198c7c88cec105698.jpeg","webDisposition":"source-url","width":817}],"sourceOnlyBlocks":[],"sourcePostId":11128,"sourcePostNumb