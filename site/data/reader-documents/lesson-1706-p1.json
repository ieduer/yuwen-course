{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1706-p1","main":{"annotations":[{"blocks":[{"runs":[{"text":"选自《东坡乐府笺》卷二（上海古籍出版社2009年版）。念奴娇，词牌名。这首词作于宋神宗元丰五年（1082）。苏轼所游的是黄州（今湖北黄冈）的赤鼻矶，并非东汉末期赤壁大战处。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-1"},{"blocks":[{"runs":[{"text":"〔大江〕指长江。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-2"},{"blocks":[{"runs":[{"text":"〔故垒〕旧时军队营垒的遗迹。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-3"},{"blocks":[{"runs":[{"text":"〔周郎〕即周瑜（175—210），字公瑾，孙权军中指挥赤壁大战的将领。二十四岁时即出任要职，军中皆呼为“周郎”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-4"},{"blocks":[{"runs":[{"text":"〔雄姿英发〕姿容雄伟，英气勃发。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-5"},{"blocks":[{"runs":[{"text":"〔羽扇纶（guān）巾〕（手持）羽扇，（头戴）纶巾。这是儒者的装束，形容周瑜有儒将风度。纶巾，配有青丝带的头巾。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-6"},{"blocks":[{"runs":[{"text":"〔樯（qiáng）橹〕代指曹操的战船。樯，挂帆的桅杆。橹，一种摇船的桨。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-7"},{"blocks":[{"runs":[{"text":"〔故国〕指赤壁古战场。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-8"},{"blocks":[{"runs":[{"text":"〔多情应笑我，早生华发〕应笑我多愁善感，过早地长出花白的头发。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-9"},{"blocks":[{"runs":[{"text":"〔尊〕同“樽”，一种盛酒器。这里指酒杯。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-10"},{"blocks":[{"runs":[{"text":"〔酹（lèi）〕将酒洒在地上，表示凭吊。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11138-11"}],"blocks":[{"runs":[{"text":"念奴娇·赤壁怀古","type":"text"},{"label":"[1]","noteId":"footnote-11138-1","type":"annotation-ref"},{"text":"\n\n苏 轼\n\n大江","type":"text"},{"label":"[2]","noteId":"footnote-11138-2","type":"annotation-ref"},{"text":"东去，浪淘尽，千古风流人物。故垒","type":"text"},{"label":"[3]","noteId":"footnote-11138-3","type":"annotation-ref"},{"text":"西边，人道是，三国周郎","type":"text"},{"label":"[4]","noteId":"footnote-11138-4","type":"annotation-ref"},{"text":"赤壁。乱石穿空，惊涛拍岸，卷起千堆雪。江山如画，一时多少豪杰。\n\n遥想公瑾当年，小乔初嫁了，雄姿英发","type":"text"},{"label":"[5]","noteId":"footnote-11138-5","type":"annotation-ref"},{"text":"。羽扇纶巾","type":"text"},{"label":"[6]","noteId":"footnote-11138-6","type":"annotation-ref"},{"text":"，谈笑间，樯橹","type":"text"},{"label":"[7]","noteId":"footnote-11138-7","type":"annotation-ref"},{"text":"灰飞烟灭。故国","type":"text"},{"label":"[8]","noteId":"footnote-11138-8","type":"annotation-ref"},{"text":"神游，多情应笑我，早生华发","type":"text"},{"label":"[9]","noteId":"footnote-11138-9","type":"annotation-ref"},{"text":"。人生如梦，一尊","type":"text"},{"label":"[10]","noteId":"footnote-11138-10","type":"annotation-ref"},{"text":"还酹","type":"text"},{"label":"[11]","noteId":"footnote-11138-11","type":"annotation-ref"},{"text":"江月。","type":"text"}],"type":"paragraph"}],"frontMatter":[],"guidance":[],"links":[],"media":[],"sourceOnlyBlocks":[],"sourcePostId":"11138-1","sourcePostNumber":1},"mediaReceiptLedgerSha256":"0319bd9f7623eb57ee396cafc0343cb6c4dc51dce258109a19edbdddd91be71c","mediaReceiptLedgerVersion":"2026-08-09.1","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11138-1","postId":"11138-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11138-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11138-2","postId":"11138-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11138-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11138-3","postId":"11138-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11138-3","text":"[3]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11138-4","postId":"11138-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11138-4","text":"[4]","title":null}