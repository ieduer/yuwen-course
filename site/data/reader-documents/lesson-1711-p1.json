{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1711-p1","main":{"annotations":[{"blocks":[{"runs":[{"text":"选自《荀子集解》卷一（中华书局1988 年版）。有删节。劝，鼓励。《荀子》全书现存32 篇，大部分为荀子自著，其余为荀子弟子记录的荀子言论和思想观点。荀子（约前313—前238），名况，字卿，赵国人，战国末期思想家。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-1"},{"blocks":[{"runs":[{"text":"君子：这里指有学问、有修养的人。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-2"},{"blocks":[{"runs":[{"text":"青，取之于蓝：靛（diàn）青从蓝草中取得。青，靛青，一种染料。蓝，草名，叶子可提取靛青。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-3"},{"blocks":[{"runs":[{"text":"青于蓝：比蓝草颜色深。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-4"},{"blocks":[{"runs":[{"text":"中（zhòng）绳：合乎木匠用来取直的墨线。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-5"},{"blocks":[{"runs":[{"text":"𫐓（róu）：同“煣”，用火烘烤木材使之弯曲。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-6"},{"blocks":[{"runs":[{"text":"规：圆规。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-7"},{"blocks":[{"runs":[{"text":"虽有槁暴（gǎopù）：即使又晒干了。有，同“又”。槁暴，晒干。槁，枯。暴，晒。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-8"},{"blocks":[{"runs":[{"text":"挺：直。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-9"},{"blocks":[{"runs":[{"text":"受绳：经过墨线比量。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-10"},{"blocks":[{"runs":[{"text":"金：指金属制的刀斧等。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-11"},{"blocks":[{"runs":[{"text":"就砺：拿到磨刀石上去磨。就，接近、靠近。砺，磨刀石。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-12"},{"blocks":[{"runs":[{"text":"参（cān）省（xǐng）乎己：对自己检查、省察。参，检验。省，省察。乎，相当于“于”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-13"},{"blocks":[{"runs":[{"text":"知：同“智”，见识。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-14"},{"blocks":[{"runs":[{"text":"跂（qǐ）：踮起脚后跟。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-15"},{"blocks":[{"runs":[{"text":"见者远：意思是远处的人也能看见。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-16"},{"blocks":[{"runs":[{"text":"疾：劲疾。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-17"},{"blocks":[{"runs":[{"text":"彰：清楚。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-18"},{"blocks":[{"runs":[{"text":"假：借助。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-19"},{"blocks":[{"runs":[{"text":"舆马：车马。这里指车子。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-20"},{"blocks":[{"runs":[{"text":"利足：善于奔走。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-21"},{"blocks":[{"runs":[{"text":"致：到达。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-22"},{"blocks":[{"runs":[{"text":"能水：善于游水。水，游泳。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-23"},{"blocks":[{"runs":[{"text":"绝：横渡。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-24"},{"blocks":[{"runs":[{"text":"生（xìng）非异：天性（同一般人）没有差别。生，同“性”，天性。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-25"},{"blocks":[{"runs":[{"text":"物：外物，包括各种客观条件。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-26"},{"blocks":[{"runs":[{"text":"兴焉：在这里兴起。兴，起。焉，兼词，相当于“于此”。下文“生焉”的“焉”同此。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-27"},{"blocks":[{"runs":[{"text":"神明：非凡的智慧。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-28"},{"blocks":[{"runs":[{"text":"圣心：圣人的心怀。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-29"},{"blocks":[{"runs":[{"text":"跬（kuǐ）步：古代称跨出一脚为“跬”，跨出两脚为“步”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-30"},{"blocks":[{"runs":[{"text":"无以：没有用来……的，无从。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-31"},{"blocks":[{"runs":[{"text":"骐骥（qíjì）：骏马。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-32"},{"blocks":[{"runs":[{"text":"驽马十驾：劣马拉车走十天。驾，一天的行程。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-33"},{"blocks":[{"runs":[{"text":"功在不舍：功效来源于走个不停。舍，停止、止息。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-34"},{"blocks":[{"runs":[{"text":"锲（qiè）：刻。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-35"},{"blocks":[{"runs":[{"text":"镂：雕刻。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-36"},{"blocks":[{"runs":[{"text":"埃土：泥土，尘土。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-37"},{"blocks":[{"runs":[{"text":"黄泉：地下的泉水。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-38"},{"blocks":[{"runs":[{"text":"一：专一。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-39"},{"blocks":[{"runs":[{"text":"六跪：蟹的六条腿。“六”应是“八”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-40"},{"blocks":[{"runs":[{"text":"螯：蟹钳。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-41"},{"blocks":[{"runs":[{"text":"躁：浮躁，不专心。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11143-42"}],"blocks":[{"runs":[{"text":"劝 学","type":"text"},{"label":"[1]","noteId":"footnote-11143-1","type":"annotation-ref"},{"text":"\n\n《荀子》\n\n君子","type":"text"},{"label":"[2]","noteId":"footnote-11143-2","type":"annotation-ref"},{"text":"曰：学不可以已。青，取之于蓝","type":"text"},{"label":"[3]","noteId":"footnote-11143-3","type":"annotation-ref"},{"text":"，而青于蓝","type":"text"},{"label":"[4]","noteId":"footnote-11143-4","type":"annotation-ref"},{"text":"；冰，水为之，而寒于水。木直中绳","type":"text"},{"label":"[5]","noteId":"footnote-11143-5","type":"annotation-ref"},{"text":"，𫐓以","type":"text"},{"label":"[6]","noteId":"footnote-11143-6","type":"annotation-ref"},{"text":"为轮，其曲中规","type":"text"},{"label":"[7]","noteId":"footnote-11143-7","type":"annotation-ref"},{"text":"。虽有槁暴","type":"text"},{"label":"[8]","noteId":"footnote-11143-8","type":"annotation-ref"},{"text":"，不复挺","type":"text"},{"label":"[9]","noteId":"footnote-11143-9","type":"annotation-ref"},{"text":"者，𫐓使之然也。故木受绳","type":"text"},{"label":"[10]","noteId":"footnote-11143-10","type":"annotation-ref"},{"text":"则直，金","type":"text"},{"label":"[11]","noteId":"footnote-11143-11","type":"annotation-ref"},{"text":"就砺","type":"text"},{"label":"[12]","noteId":"footnote-11143-12","type":"annotation-ref"},{"text":"则利，君子博学而日参省乎己","type":"text"},{"label":"[13]","noteId":"footnote-11143-13","type":"annotation-ref"},{"text":"，则知","type":"text"},{"label":"[14]","noteId":"footnote-11143-14","type":"annotation-ref"},{"text":"明而行无过矣。\n\n吾尝终日而思矣，不如须臾之所学也；吾尝跂","type":"text"},{"label":"[15]","noteId":"footnote-11143-15","type":"annotation-ref"},{"text":"而望矣，不如登高之博见也。登高而招，臂非加长也，而见者远","type":"text"},{"label":"[16]","noteId":"footnote-11143-16","type":"annotation-ref"},{"text":"；顺风而呼，声非加疾","type":"text"},{"label":"[17]","noteId":"footnote-11143-17","type":"annotation-ref"},{"text":"也，而闻者彰","type":"text"},{"label":"[18]","noteId":"footnote-11143-18","type":"annotation-ref"},{"text":"。假","type":"text"},{"label":"[19]","noteId":"footnote-11143-19","type":"annotation-ref"},{"text":"舆马","type":"text"},{"label":"[20]","noteId":"footnote-11143-20","type":"annotation-ref"},{"text":"者，非利足","type":"text"},{"label":"[21]","noteId":"footnote-11143-21","type":"annotation-ref"},{"text":"也，而致","type":"text"},{"label":"[22]","noteId":"footnote-11143-22","type":"annotation-ref"},{"text":"千里；假舟楫者，非能水","type":"text"},{"label":"[23]","noteId":"footnote-11143-23","type":"annotation-ref"},{"text":"也，而绝","type":"text"},{"label":"[24]","noteId":"footnote-11143-24","type":"annotation-ref"},{"text":"江河。君子生非异","type":"text"},{"label":"[25]","noteId":"footnote-11143-25","type":"annotation-ref"},{"text":"也，善假于物","type":"text"},{"label":"[26]","noteId":"footnote-11143-26","type":"annotation-ref"},{"text":"也。\n\n积土成山，风雨兴焉","type":"text"},{"label":"[27]","noteId":"footnote-11143-27","type":"annotation-ref"},{"text":"；积水成渊，蛟龙生焉；积善成德，而神明","type":"text"},{"label":"[28]","noteId":"footnote-11143-28","type":"annotation-ref"},{"text":"自得，圣心","type":"text"},{"label":"[29]","noteId":"footnote-11143-29","type":"annotation-ref"},{"text":"备焉。故不积跬步","type":"text"},{"label":"[30]","noteId":"footnote-11143-30","type":"annotation-ref"},{"text":"，无以","type":"text"},{"label":"[31]","noteId":"footnote-11143-31","type":"annotation-ref"},{"text":"至千里；不积小流，无以成江海。骐骥","type":"text"},{"label":"[32]","noteId":"footnote-11143-32","type":"annotation-ref"},{"text":"一跃，不能十步；驽马十驾","type":"text"},{"label":"[33]","noteId":"footnote-11143-33","type":"annotation-ref"},{"text":"，功在不舍","type":"text"},{"label":"[34]","noteId":"footnote-11143-34","type":"annotation-ref"},{"text":"。锲","type":"text"},{"label":"[35]","noteId":"footnote-11143-35","type":"annotation-ref"},{"text":"而舍之，朽木不折；锲而不舍，金石可镂","type":"text"},{"label":"[36]","noteId":"footnote-11143-36","type":"annotation-ref"},{"text":"。蚓无爪牙之利，筋骨之强，上食埃土","type":"text"},{"label":"[37]","noteId":"footnote-11143-37","type":"annotation-ref"},{"text":"，下饮黄泉","type":"text"},{"label":"[38]","noteId":"footnote-11143-38","type":"annotation-ref"},{"text":"，用心一","type":"text"},{"label":"[39]","noteId":"footnote-11143-39","type":"annotation-ref"},{"text":"也。蟹六跪","type":"text"},{"label":"[40]","noteId":"footnote-11143-40","type":"annotation-ref"},{"text":"而二螯","type":"text"},{"label":"[41]","noteId":"footnote-11143-41","type":"annotation-ref"},{"text":"，非蛇鳝之穴无可寄托者，用心躁","type":"text"},{"label":"[42]","noteId":"footnote-11143-42","type":"annotation-ref"},{"text":"也。","type":"text"}],"type":"paragraph"},{"type":"divider"},{"runs":[{"text":"《劝学》和《师说》都是我国古代探讨学习问题的名篇。熟读这两篇文章，找出文中谈学习的名句，推敲句子的含义，以此为基础把握两篇文章关于学习的主要观点。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"阅读时，要注意联系作者的思想主张和写作背景来理解文章的观点，分析作者提出观点的依据。例如，荀子为何如此强调后天学习的重要性？韩愈是针对怎样的现状倡导师道回归的？这需要分别结合荀子的“性恶论”、韩愈所处时代士大夫“耻学于师”的风气来理解。还可以结合今天的社会生活，说说荀子和韩愈的学习观中，哪些仍然值得借鉴，哪些需要更新并赋予其新的内涵。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"“而”是古代汉语中常见的连词，可用于表示并列、承接、递进、转折、修饰等多种语义关系。这两篇文章中的许多语句用了“而”，诵读时注意体会这些“而”字表现的语义关系。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"*背诵课文《劝学》全篇和《师说》的第1 段。","type":"text"}],"type":"paragraph"}],"frontMatter":[],"guidance":[],"links":[],"media":[],"sourceOnlyBlocks":[],"sourcePostId":"11143-1","sourcePostNumber":1},"mediaReceiptLedgerSha256":"0319bd9f7623eb57ee396cafc0343cb6c4dc51dce258109a19edbdddd91be71c","mediaReceiptLedgerVersion":"2026-08-09.1","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11143-1","postId":"11143-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11143-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11143-2","postId":"11143-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11143-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11143-3","postId":"11143-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11143-3","text":"[3]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11143-4","postId":"11143-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11143-4","text":"[4]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11143-5","postId":"11143-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11143-5","text":"[5]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11143-6","postId":"11143-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11143-6","text":"[6]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11143-7","postId":"11143-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11143-7","text":"[7]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11143-8","postId":"11143-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11143-8","text":"[8]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11143-9","postId":"11143-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11143-9","text":"[9]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11143-10","postId":"11143-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11143-10","text":"[10]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11143-11","postId":"11143-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11143-11","text":"[11]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11143-12","postId":"11143-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11143-12","text":"[12]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11143-13","postId":"11143-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11143-13","text":"[13]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11143-14","postId":"11143-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11143-14","text":"[14]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11143-15","postId":"11143-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11143-15","text":"[15]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11143-16","postId":"11143-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11143-16","text":"[16]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11143-17","postId":"11143-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rd