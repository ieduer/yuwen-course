{"curationManifestSha256":"98e90b3603b34b437bc554810c21f01c4db44d10364211af114d30fde3d67bad","curationVersion":"2026-07-30.2","lessonId":"lesson-1541","main":{"annotations":[],"blocks":[{"runs":[{"text":"你知道吗，那柠檬花开的地方，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"茂密的绿叶中，橙子金黄，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"蓝天上送来宜人的和风，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"桃金娘静立，月桂梢头高昂，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"你可知道那地方？","type":"text"}],"type":"paragraph"},{"runs":[{"text":"前往，前往，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我愿跟随你，爱人啊，随你前往！","type":"text"}],"type":"paragraph"},{"runs":[{"text":"歌唱的迷娘和威廉·迈斯特","type":"text"}],"type":"paragraph"},{"runs":[{"text":"你可知道那所房子，圆柱成行，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"厅堂辉煌，居室宽敞明亮，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"大理石立像凝望着我：","type":"text"}],"type":"paragraph"},{"runs":[{"text":"人们把你怎么了，可怜的姑娘？","type":"text"}],"type":"paragraph"},{"runs":[{"text":"你可知道那所房子？","type":"text"}],"type":"paragraph"},{"runs":[{"text":"前往，前往，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我愿跟随你，恩人啊，随你前往！","type":"text"}],"type":"paragraph"},{"runs":[{"text":"你知道吗，那云径和山岗？","type":"text"}],"type":"paragraph"},{"runs":[{"text":"驴儿在雾中觅路前进，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"岩洞里有古老龙种的行藏，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"危崖欲坠，瀑布奔忙，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"你可知道那座山岗？","type":"text"}],"type":"paragraph"},{"runs":[{"text":"前往，前往，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"我愿跟随你，父亲啊，随你前往！","type":"text"}],"type":"paragraph"},{"runs":[{"text":"歌唱的迷娘和威廉·迈斯特","type":"text"}],"type":"paragraph"}],"frontMatter":[{"blocks":[{"runs":[{"text":"选自《迷娘曲》（河北教育出版社2015 年版）。杨武能译。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"迷娘，人名Mignon 的音译，歌德长篇小说《威廉·迈斯特的学习时代》中的人物。这首诗是迷娘为小说主人公威廉·迈斯特唱的一首歌。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"歌德（1749—1832），德国诗人、剧作家文学家、思想家。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"guidance":[],"links":[{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/xbz000/%e7%ac%ac%e5%9b%9b%e5%8d%95%e5%85%83/13-%e8%bf%b7%e5%a8%98%e4%b9%8b%e4%b8%80-%e6%ad%8c%e5%be%b7","sourceUrl":"https://sites.google.com/view/pkuschool/xbz000/%e7%ac%ac%e5%9b%9b%e5%8d%95%e5%85%83/13-%e8%bf%b7%e5%a8%98%e4%b9%8b%e4%b8%80-%e6%ad%8c%e5%be%b7","text":"https://sites.google.com/view/pkuschool/xbz000/%e7%ac%ac%e5%9b%9b%e5%8d%95%e5%85%83/13-%e8%bf%b7%e5%a8%98%e4%b9%8b%e4%b8%80-%e6%ad%8c%e5%be%b7","title":null}],"media":[{"alt":"","bytes":75310,"finalUrl":"https://files.rdfzer.com/original/2X/4/434246e686552900c98f372b24a43183b03e7997.jpeg","height":425,"id":"media-2b753c690cb81b8e5dcf","mediaType":"image/jpeg","nativeDisposition":"verified-in-app","receiptCollectedAt":"2026-07-30T01:10:43.464Z","receiptRequired":true,"rightsBasis":"user-authorized-course-source-use-2026-07-29","sha256":"2c8076757a3a66a6d94a9e472e758e335bbc07ef4760be64622e221c52c12360","sourceUrl":"https://files.rdfzer.com/original/2X/4/434246e686552900c98f372b24a43183b03e7997.jpeg","webDisposition":"source-url","width":320}],"sourceOnlyBlocks":[],"sourcePostId":10294,"sourcePostNumber":1},"mediaReceiptLedgerSha256":"5487243dd8d14d65dfadc20ed544a999aaa318fc20c291462ea62c69e1eff320","mediaReceiptLedgerVersion":"2026-07-30.2","provenance":{"links":[{"disposition":"system-browser","href":"https://files.rdfzer.com/original/2X/4/434246e686552900c98f372b24a43183b03e7997.jpeg","postId":10294,"postNumber":1,"postRole":"primary","sourceUrl":"https://files.rdfzer.com/original/2X/4/434246e686552900c98f372b24a43183b03e7997.jpeg","text":"https://files.rdfzer.com/original/2X/4/434246e686552900c98f372b24a43183b03e7997.jpeg","title":null},{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/xbz000/%e7%ac%ac%e5%9b%9b%e5%8d%95%e5%85%83/13-%e8%bf%b7%e5%a8%98%e4%b9%8b%e4%b8%80-%e6%ad%8c%e5%be%b7","postId":10294,"p