{"curationManifestSha256":"8deda35e2cb9b2aae68a6d4e2614684605ec85d50bf2ff9dddd19f7e4588283b","curationVersion":"2026-07-30.2","lessonId":"lesson-1704-p1","main":{"annotations":[{"blocks":[{"runs":[{"text":"面对着酒与歌，即饮酒听歌。当，也 是“对”的意思。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-1"},{"blocks":[{"runs":[{"text":"多少。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-2"},{"blocks":[{"runs":[{"text":"可悲的是逝去的日子太多了。这是慨 叹人生短暂。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-3"},{"blocks":[{"runs":[{"text":"即“慷慨”。这里指宴会上的歌声激越 不平。当以，没有实义。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-4"},{"blocks":[{"runs":[{"text":"相传是最早造酒的人。这里代指酒。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-5"},{"blocks":[{"runs":[{"text":"语出《诗经·郑风·子 衿》，原写姑娘思念情人，这里用来形容渴望得到 贤才。子，对对方的尊称。青衿，指代周代读书人 青色交领的服装。衿，衣服的交领。悠悠，长远的 样子，形容思虑连绵不断。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-6"},{"blocks":[{"runs":[{"text":"沉思吟味。这里指思念和倾慕贤人。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-7"},{"blocks":[{"runs":[{"text":"语 出《诗经·小雅·鹿鸣》。苹，艾蒿。《鹿鸣》是宴 客的诗，这里用来表达招纳贤才的热情。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-8"},{"blocks":[{"runs":[{"text":"拾取，摘取。一说同“辍”，停止。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-9"},{"blocks":[{"runs":[{"text":"穿过纵横交错的小路。陌，东西向的 田间小路。阡，南北向的田间小路。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-10"},{"blocks":[{"runs":[{"text":"屈驾来访。枉，这里是枉驾的意思。 用，以。存，问候、探望。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-11"},{"blocks":[{"runs":[{"text":"久别重逢，欢饮畅谈。契阔， 聚散，这里指久别重逢。讌，同“宴”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-12"},{"blocks":[{"runs":[{"text":"三周。匝，周、圈。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-13"},{"blocks":[{"runs":[{"text":"这里是仿用《管子·形势 解》中的话：“海不辞水，故能成其大；山不辞土 石，故能成其高；明主不厌人，故能成其众。”意思 是表示希望尽可能多地接纳人才。厌，满足。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-14"},{"blocks":[{"runs":[{"text":"《史记·鲁周公世家》记载，周 公广纳贤才，正吃饭时，听到门外有士子求见，来 不及咽下嘴里的食物，把食物一吐就赶紧去接见。 这里借用这个典故，表示自己像周公一样热切殷勤 地接待贤才。吐哺，吐出嘴里的食物。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-15"}],"blocks":[{"runs":[{"text":"短歌行\n\n曹 操\n\n对酒当歌","type":"text"},{"label":"[1]","noteId":"footnote-11136-1","type":"annotation-ref"},{"text":"，人生几何","type":"text"},{"label":"[2]","noteId":"footnote-11136-2","type":"annotation-ref"},{"text":"！\n\n譬如朝露，去日苦多","type":"text"},{"label":"[3]","noteId":"footnote-11136-3","type":"annotation-ref"},{"text":"。\n\n慨当以慷","type":"text"},{"label":"[4]","noteId":"footnote-11136-4","type":"annotation-ref"},{"text":"，忧思难忘。\n\n何以解忧？唯有杜康","type":"text"},{"label":"[5]","noteId":"footnote-11136-5","type":"annotation-ref"},{"text":"。\n\n青青子衿，悠悠我心","type":"text"},{"label":"[6]","noteId":"footnote-11136-6","type":"annotation-ref"},{"text":"。\n\n但为君故，沉吟","type":"text"},{"label":"[7]","noteId":"footnote-11136-7","type":"annotation-ref"},{"text":"至今。\n\n呦呦鹿鸣，食野之苹。\n\n我有嘉宾，鼓瑟吹笙","type":"text"},{"label":"[8]","noteId":"footnote-11136-8","type":"annotation-ref"},{"text":"。\n\n明明如月，何时可掇","type":"text"},{"label":"[9]","noteId":"footnote-11136-9","type":"annotation-ref"},{"text":"？\n\n忧从中来，不可断绝。\n\n越陌度阡","type":"text"},{"label":"[10]","noteId":"footnote-11136-10","type":"annotation-ref"},{"text":"，枉用相存","type":"text"},{"label":"[11]","noteId":"footnote-11136-11","type":"annotation-ref"},{"text":"。\n\n契阔谈讌","type":"text"},{"label":"[12]","noteId":"footnote-11136-12","type":"annotation-ref"},{"text":"，心念旧恩。\n\n月明星稀，乌鹊南飞。\n\n绕树三匝","type":"text"},{"label":"[13]","noteId":"footnote-11136-13","type":"annotation-ref"},{"text":"，何枝可依？\n\n山不厌高，海不厌深","type":"text"},{"label":"[14]","noteId":"footnote-11136-14","type":"annotation-ref"},{"text":"。\n\n周公吐哺","type":"text"},{"label":"[15]","noteId":"footnote-11136-15","type":"annotation-ref"},{"text":"，天下归心。","type":"text"}],"type":"paragraph"}],"frontMatter":[],"guidance":[],"links":[],"media":[],"sourceOnlyBlocks":[],"sourcePostId":"11136-1","sourcePostNumber":1},"mediaReceiptLedgerSha256":"0319bd9f7623eb57ee396cafc0343cb6c4dc51dce258109a19edbdddd91be71c","mediaReceiptLedgerVersion":"2026-08-09.1","provenance":{"links":[{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11136-1","postId":"11136-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11136-1","text":"[1]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11136-2","postId":"11136-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11136-2","text":"[2]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11136-3","postId":"11136-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11136-3","text":"[3]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11136-4","postId":"11136-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11136-4","text":"[4]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11136-5","postId":"11136-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11136-5","text":"[5]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11136-6","postId":"11136-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11136-6","text":"[6]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11136-7","postId":"11136-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11136-7","text":"[7]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-11136-8","postId":"11136-1","postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-11136-8","text":"[8]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-1113