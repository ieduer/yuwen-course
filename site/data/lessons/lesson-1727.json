174-9","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-10","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-11","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-12","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-13","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-14","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-15","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-16","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-17","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-18","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-19","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-20","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-21","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-22","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-23","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-24","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-25","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-26","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-27","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-28","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-29","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-30","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-31","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-32","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-33","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-34","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-35","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-36","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11174-37","text":"↩︎","title":"","classes":"footnote-backref","has_image":false}],"attachments":[{"href":"https://files.rdfzer.com/original/2X/b/b1e7fe6606bd7369b7cd3c43c0e49c520fc6f0b7.jpeg","text":"image968×811 123 KB","title":"image","classes":"lightbox","has_image":true}]}]}