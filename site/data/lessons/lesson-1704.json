age":false},{"href":"#footnote-ref-11136-8","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-9","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-10","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-11","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-12","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-13","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-14","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-15","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-16","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-17","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-18","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-19","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-20","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-21","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-22","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-23","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-24","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-25","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-26","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-27","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-28","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-29","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-30","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-31","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-32","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11136-33","text":"↩︎","title":"","classes":"footnote-backref","has_image":false}],"attachments":[]}]}