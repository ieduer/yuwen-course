"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-3","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-4","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-5","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-6","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-7","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-8","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-9","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-10","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-11","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-12","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-13","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-14","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-15","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-16","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-17","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-18","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-19","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-20","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-21","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-22","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-23","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-24","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-25","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-26","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-27","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-28","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-29","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-30","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-31","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-32","text":"↩︎","title":"","classes":"footnote-backref","has_image":false},{"href":"#footnote-ref-11138-33","text":"↩︎","title":"","classes":"footnote-backref","has_image":false}],"attachments":[]}]}