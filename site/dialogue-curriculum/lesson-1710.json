  "passages": [
    {
      "id": "lesson-1710:p1",
      "text": "学习是永恒的话题。从《礼记·学记》中的“玉",
      "block": {
        "runs": [
          {
            "text": "学习是永恒的话题。从《礼记·学记》中的“玉",
            "type": "text"
          }
        ],
        "type": "paragraph"
      }
    },
    {
      "id": "lesson-1710:p2",
      "text": "不琢，不成器”，到当今社会倡导的终身学习和个性",
      "block": {
        "runs": [
          {
            "text": "不琢，不成器”，到当今社会倡导的终身学习和个性",
            "type": "text"
          }
        ],
        "type": "paragraph"
      }
    },
    {
      "id": "lesson-1710:p3",
      "text": "化学习，数千年来，人们一直在不懈地探索学习之道，",
      "block": {
        "runs": [
          {
            "text": "化学习，数千年来，人们一直在不懈地探索学习之道，",
            "type": "text"
          }
        ],
        "type": "paragraph"
      }
    },
    {
      "id": "lesson-1710:p4",
      "text": "以更好地获取知识，提升能力和自身修养。",
      "block": {
        "runs": [
          {
            "text": "以更好地获取知识，提升能力和自身修养。",
            "type": "text"
          }
        ],
        "type": "paragraph"
      }
    },
    {
      "id": "lesson-1710:p5",
      "text": "本单元的文章从不同角度论述有关学习的问题，",
      "block": {
        "runs": [
          {
            "text": "本单元的文章从不同角度论述有关学习的问题，",
            "type": "text"
          }
        ],
        "type": "paragraph"
      }
    },
    {
      "id": "lesson-1710:p6",
      "text": "或阐述学习的意义，或讨论学习的态度与方法，或描",
      "block": {
        "runs": [
          {
            "text": "或阐述学习的意义，或讨论学习的态度与方法，或描",
            "type": "text"
          }
        ],
        "type": "paragraph"
      }
    },
    {
      "id": "lesson-1710:p7",
      "text": "述读书的经历与感受，使我们获得不同的启迪。",
      "block": {
        "runs": [
          {
            "text": "述读书的经历与感受，使我们获得不同的启迪。",
            "type": "text"
          }
        ],
        "type": "paragraph"
      }
    },
    {
      "id": "lesson-1710:p8",
      "text": "学习本单元，以“学习之道”为核心，通过梳理、",
      "block": {
        "runs": [
          {
            "text": "学习本单元，以“学习之道”为核心，通过梳理、",
            "type": "text"
          }
        ],
        "type": "paragraph"
      }
    },
    {
      "id": "lesson-1710:p9",
      "text": "探究和反思，形成正确的学习观，改进学习方法，提",
      "block": {
        "runs": [
          {
            "text": "探究和反思，形成正确的学习观，改进学习方法，提",
            "type": "text"
          }
        ],
        "type": "paragraph"
      }
    },
    {
      "id": "lesson-1710:p10",
      "text": "高学习能力。要准确把握作者的观点和态度，关注作",
      "block": {
        "runs": [
          {
            "text": "高学习能力。要准确把握作者的观点和态度，关注作",
            "type": "text"
          }
        ],
        "type": "paragraph"
      }
    },
    {
      "id": "lesson-1710:p11",
      "text": "者思考问题的角度，学习他们有针对性地表达观点的",
      "block": {
        "runs": [
          {
            "text": "者思考问题的角度，学习他们有针对性地表达观点的",
            "type": "text"
          }
        ],
        "type": "paragraph"
      }
    },
    {
      "id": "lesson-1710:p12",
      "text": "方法；学会发现问题，从合适的角度以恰当的方式阐",
      "block": {
        "runs": [
          {
            "text": "方法；学会发现问题，从合适的角度以恰当的方式阐",
            "type": "text"
          }
        ],
        "type": "paragraph"
      }
    },
    {
      "id": "lesson-1710:p13",
      "text": "述自己的看法。",
      "block": {
        "runs": [
          {
            "text": "述自己的看法。",
            "type": "text"
          }
        ],
        "type": "paragraph"
      }
    }
  ],
