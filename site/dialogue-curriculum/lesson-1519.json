  "lessonId": "lesson-1519",
  "title": "人的正确思想是从哪里来的? / 毛泽东",
  "mode": "argument",
  "author": "毛泽东",
  "persona": {
    "kind": "author-simulation",
    "notice": "AI 教學模擬，依據作品；並非作者本人。",
    "narratorIsAuthor": false,
