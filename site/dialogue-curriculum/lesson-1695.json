    {
      "id": "lesson-1695:p24",
      "text": "同学的诗作，全班合作编辑一本诗集作为青春的纪念。",
      "block": {
        "runs": [
          {
            "text": "同学的诗作，全班合作编辑一本诗集作为青春的纪念。",
