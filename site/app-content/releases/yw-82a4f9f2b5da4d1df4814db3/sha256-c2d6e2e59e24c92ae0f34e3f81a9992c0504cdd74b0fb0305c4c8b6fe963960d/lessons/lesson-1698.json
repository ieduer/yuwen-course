bfb4a71a/p28.webp"},{"bytes":96266,"href":"https://img.rdfzer.com/pages/1082bfb4a71a/p29.webp","label":"p29","matched":false,"mediaType":"image/webp","page":29,"rightsBasis":"user-authorized-for-bdfz-yw-app-2026-07-29","sha256":"d0f7d4200b9e66f7db036a408488169d7376490053ac65847075cc082a71ba8a","sourceLocalRef":"textbook_ai_migration/platform/frontend/assets/pages/1082bfb4a71a/p29.webp","sourceUrl":"https://img.rdfzer.com/pages/1082bfb4a71a/p29.webp"},{"bytes":142984,"href":"https://img.rdfzer.com/pages/1082bfb4a71a/p30.webp","label":"p30","matched":false,"mediaType":"image/webp","page":30,"rightsBasis":"user-authorized-for-bdfz-yw-app-2026-07-29","sha256":"dfc1ecc8b0a9d47cac3bb45597cba9340e9e9693f58e39fc4a85237eae903055","sourceLocalRef":"textbook_ai_migration/platform/frontend/assets/pages/1082bfb4a71a/p30.webp","sourceUrl":"https://img.rdfzer.com/pages/1082bfb4a71a/p30.webp"},{"bytes":152848,"href":"https://img.rdfzer.com/pages/1082bfb4a71a/p31.webp","label":"p31","matched":false,"mediaType":"image/webp","page":31,"rightsBasis":"user-authorized-for-bdfz-yw-app-2026-07-29","sha256":"11ba461571d0744ae8b121912a64a3e202c48173f3fa3481a88004e4145604a9","sourceLocalRef":"textbook_ai_migration/platform/frontend/assets/pages/1082bfb4a71a/p31.webp","sourceUrl":"https://img.rdfzer.com/pages/1082bfb4a71a/p31.webp"},{"bytes":152552,"href":"https://img.rdfzer.com/pages/1082bfb4a71a/p32.webp","label":"p32","matched":false,"mediaType":"image/webp","page":32,"rightsBasis":"user-authorized-for-bdfz-yw-app-2026-07-29","sha256":"5c9d6669bf524da22e20a532122801cb77fc759ee1c6f5b545c324c8b3bcd91a","sourceLocalRef":"textbook_ai_migration/platform/frontend/assets/pages/1082bfb4a71a/p32.webp","sourceUrl":"https://img.rdfzer.com/pages/1082bfb4a71a/p32.webp"},{"bytes":146214,"href":"https://img.rdfzer.com/pages/1082bfb4a71a/p33.webp","label":"p33","matched":false,"mediaType":"image/webp","page":33,"rightsBasis":"user-authorized-for-bdfz-yw-app-2026-07-29","sha256":"b414b28fdb927e6bb13096ea451