l/xbz000/%e7%ac%ac%e5%9b%9b%e5%8d%95%e5%85%83/%e8%87%aa%e5%b7%b1%e4%b9%8b%e6%ad%8c%e8%8a%82%e9%80%89-%e6%83%a0%e7%89%b9%e6"},{"href":"https://forum.rdfzer.com/u/creative","kind":"link","postNumber":14,"text":"@Creative"}],"schemaVersion":"yw-native-lesson-v1","sourceTitle":"高中語文 - * 自己之歌（节选）/ 惠特曼","textbook":{"bookId":"高中_语文_普通高中教科书_语文选择性必修_中册","bookTitle":"普通高中教科书·语文选择性必修 中册（人教版）","contextPageImages":[{"bytes":85696,"href":"https://img.rdfzer.com/pages/0433798ca156/p106.webp","label":"p106","matched":false,"mediaType":"image/webp","page":106,"rightsBasis":"user-authorized-for-bdfz-yw-app-2026-07-29","sha256":"86f141cfc2e44dac1fab62f025021f698f0003fc5657e5ec2d825504ceb314de","sourceLocalRef":"textbook_ai_migration/platform/frontend/assets/pages/0433798ca156/p106.webp","sourceUrl":"https://img.rdfzer.com/pages/0433798ca156/p106.webp"},{"bytes":119938,"href":"https://img.rdfzer.com/pages/0433798ca156/p107.webp","label":"p107","matched":false,"mediaType":"image/webp","page":107,"rightsBasis":"user-authorized-for-bdfz-yw-app-2026-07-29","sha256":"49463f0dd8057b27e50059a9b3ad6ab1c7cd4d532aa9f5549252dbabc5459be9","sourceLocalRef":"textbook_ai_migration/platform/frontend/assets/pages/0433798ca156/p107.webp","sourceUrl":"https://img.rdfzer.com/pages/0433798ca156/p107.webp"},{"bytes":89728,"href":"https://img.rdfzer.com/pages/0433798ca156/p108.webp","label":"p108","matched":false,"mediaType":"image/webp","page":108,"rightsBasis":"user-authorized-for-bdfz-yw-app-2026-07-29","sha256":"6386eb4be9c7a51a76cc6db6a797f584b4527d388193c70b312eb0d877c31f4e","sourceLocalRef":"textbook_ai_migration/platform/frontend/assets/pages/0433798ca156/p108.webp","sourceUrl":"https://img.rdfzer.com/pages/0433798ca156/p108.webp"},{"bytes":88320,"href":"https://img.rdfzer.com/pages/0433798ca156/p109.webp","label":"p109","matched":false,"mediaType":"image/webp","page":109,"rightsBasis":"user-authorized-for-bdfz-yw-app-2026-07-29","sha256":"f66f201e350ea623fda83d4375083ebb1edcadb580fe18c44aba7329f6fd3