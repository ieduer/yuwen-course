p","sourceUrl":"https://img.rdfzer.com/pages/9535dacc9628/p36.webp"},{"bytes":96784,"href":"https://img.rdfzer.com/pages/9535dacc9628/p37.webp","label":"p37","matched":false,"mediaType":"image/webp","page":37,"rightsBasis":"user-authorized-for-bdfz-yw-app-2026-07-29","sha256":"f4b0a71a01dd6062138a4e45131b314f658a162a595b572d286eaedab7f3cd13","sourceLocalRef":"textbook_ai_migration/platform/frontend/assets/pages/9535dacc9628/p37.webp","sourceUrl":"https://img.rdfzer.com/pages/9535dacc9628/p37.webp"},{"bytes":92756,"href":"https://img.rdfzer.com/pages/9535dacc9628/p38.webp","label":"p38","matched":false,"mediaType":"image/webp","page":38,"rightsBasis":"user-authorized-for-bdfz-yw-app-2026-07-29","sha256":"025383e41b92df1bdd9b53431b647e355f852c9c92dc15b76cf416ee1fd6358a","sourceLocalRef":"textbook_ai_migration/platform/frontend/assets/pages/9535dacc9628/p38.webp","sourceUrl":"https://img.rdfzer.com/pages/9535dacc9628/p38.webp"},{"bytes":87318,"href":"https://img.rdfzer.com/pages/9535dacc9628/p39.webp","label":"p39","matched":false,"mediaType":"image/webp","page":39,"rightsBasis":"user-authorized-for-bdfz-yw-app-2026-07-29","sha256":"3d288b451e2ed095c13c9057702c55e276ead47966f956dc6ae544b61cb6890d","sourceLocalRef":"textbook_ai_migration/platform/frontend/assets/pages/9535dacc9628/p39.webp","sourceUrl":"https://img.rdfzer.com/pages/9535dacc9628/p39.webp"},{"bytes":87802,"href":"https://img.rdfzer.com/pages/9535dacc9628/p40.webp","label":"p40","matched":false,"mediaType":"image/webp","page":40,"rightsBasis":"user-authorized-for-bdfz-yw-app-2026-07-29","sha256":"54bdfee6f9b0bb174c7ff7597c74a72ba0f8fe83ea4f00cd6028139bdc5bfc7e","sourceLocalRef":"textbook_ai_migration/platform/frontend/assets/pages/9535dacc9628/p40.webp","sourceUrl":"https://img.rdfzer.com/pages/9535dacc9628/p40.webp"},{"bytes":87262,"href":"https://img.rdfzer.com/pages/9535dacc9628/p41.webp","label":"p41","matched":false,"mediaType":"image/webp","page":41,"rightsBasis":"user-authorized-for-bdfz-yw-app-2026