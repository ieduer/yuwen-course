,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10359-14","text":"[14]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10359-15","postId":10359,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10359-15","text":"[15]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10359-16","postId":10359,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10359-16","text":"[16]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10359-17","postId":10359,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10359-17","text":"[17]","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-10359-18","postId":10359,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-10359-18","text":"[18]","title":null},{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/xbz000/%e5%8f%a4%e8%af%97%e8%af%8d%e8%af%b5%e8%af%bb/%e6%9d%8e%e5%87%ad%e7%ae%9c%e7%af%8c%e5%bc%95-%e6%9d%8e%e8%b4%ba","postId":10359,"postNumber":1,"postRole":"primary","sourceUrl":"https://sites.google.com/view/pkuschool/xbz000/%e5%8f%a4%e8%af%97%e8%af%8d%e8%af%b5%e8%af%bb/%e6%9d%8e%e5%87%ad%e7%ae%9c%e7%af%8c%e5%bc%95-%e6%9d%8e%e8%b4%ba","text":"https://sites.google.com/view/pkuschool/xbz000/%e5%8f%a4%e8%af%97%e8%af%8d%e8%af%b5%e8%af%bb/%e6%9d%8e%e5%87%ad%e7%ae%9c%e7%af%8c%e5%bc%95-%e6%9d%8e%e8%b4%ba","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-10359-1","postId":10359,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-10359-1","text":"↩︎","title":null},{"disposition":"internal","href":"https://forum.rdfzer.com/#footnote-ref-10359-2","postId":10359,"postNumber":1,"postRole":"primary","sourceUrl":"https://forum.rdfzer.com/#footnote-ref-10359-2","text":"↩︎"