ref-11136-26","text":"↩︎","title":""},{"classes":"footnote-backref","has_image":false,"href":"#footnote-ref-11136-27","text":"↩︎","title":""},{"classes":"footnote-backref","has_image":false,"href":"#footnote-ref-11136-28","text":"↩︎","title":""},{"classes":"footnote-backref","has_image":false,"href":"#footnote-ref-11136-29","text":"↩︎","title":""},{"classes":"footnote-backref","has_image":false,"href":"#footnote-ref-11136-30","text":"↩︎","title":""},{"classes":"footnote-backref","has_image":false,"href":"#footnote-ref-11136-31","text":"↩︎","title":""},{"classes":"footnote-backref","has_image":false,"href":"#footnote-ref-11136-32","text":"↩︎","title":""},{"classes":"footnote-backref","has_image":false,"href":"#footnote-ref-11136-33","text":"↩︎","title":""}],"plainText":"归园田居（其一）\n陶渊明\n少无适俗 [16] 韵 [17] ，性本爱丘山 [18] 。\n误落尘网 [19] 中，一去三十年 [20] 。\n羁鸟 [21] 恋旧林，池鱼思故渊。\n开荒南野 [22] 际，守拙 [23] 归园田。\n方宅十余亩 [24] ，草屋八九间。\n榆柳荫后檐，桃李罗堂前。\n暧暧 [25] 远人村，依依 [26] 墟里 [27] 烟。\n狗吠深巷中，鸡鸣桑树颠 [28] 。\n户庭 [29] 无尘杂 [30] ，虚室 [31] 有余闲 [32] 。\n久在樊笼 [33] 里，复得返自然。","post_number":1,"reply_to_post_number":null,"updated_at":"2024-08-21T11:42:06Z"}],"readerDocument":{"curationManifestSha256":"98e90b3603b34b437bc554810c21f01c4db44d10364211af114d30fde3d67bad","curationVersion":"2026-07-30.2","lessonId":"lesson-1704-p2","main":{"annotations":[{"blocks":[{"runs":[{"text":"适应世俗。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-16"},{"blocks":[{"runs":[{"text":"气质，情致。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-17"},{"blocks":[{"runs":[{"text":"指山林。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-18"},{"blocks":[{"runs":[{"text":"指世俗的种种束缚。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-19"},{"blocks":[{"runs":[{"text":"陶渊明大约二十五岁离开少时居所， 直到五十五岁辞去彭泽令方归，所以说“一去三十 年”。或疑当作“十三年”。自开始做官至辞去彭泽 令，前后为十三年。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-20"},{"blocks":[{"runs":[{"text":"被关在笼中的鸟。羁，约束。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-21"},{"blocks":[{"runs":[{"text":"南面的田野。一作“南亩”，指农田。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-22"},{"blocks":[{"runs":[{"text":"持守愚拙的本性，即不学巧伪，不争名利。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-23"},{"blocks":[{"runs":[{"text":"宅子四周有十几亩地。方，四周围绕。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-24"},{"blocks":[{"runs":[{"text":"迷蒙隐约的样子。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-25"},{"blocks":[{"runs":[{"text":"隐约的样子。一说“轻柔的样子”。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-26"},{"blocks":[{"runs":[{"text":"指村落。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-27"},{"blocks":[{"runs":[{"text":"顶端。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-28"},{"blocks":[{"runs":[{"text":"门户庭院。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-29"},{"blocks":[{"runs":[{"text":"指世俗的繁杂琐事。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-30"},{"blocks":[{"runs":[{"text":"静室。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-31"},{"blocks":[{"runs":[{"text":"余暇，空闲。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-32"},{"blocks":[{"runs":[{"text":"关鸟兽的笼子。这里指束缚本性的俗世。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-11136-33"}],"blocks":[{"runs":[{"text":"归园田居（其一）\n\n陶渊明\n\n少无适俗","type":"text"},{"label":"[1]","noteId":"footnote-11136-16","type":"annotation-ref"},{"text":"韵","type":"text"},{"label":"[2]","noteId":"footnote-11136-17","type":"annotation-ref"},{"text":"，性本爱丘山","type":"text"},{"label":"[3]","noteId":"footnote-11136-18","type":"annotation-ref"},{"text":"。\n\n误落尘网","type":"text"},{"label":"[4]","noteId":"footnote-11136-19","type":"annotation-ref"},{"text":"中，一去三十年","type":"text"},{"label":"[5]","noteId":"footnote-11136-20","type":"annotation-ref"},{"text":"。\n\n羁鸟","type":"text"},{"label":"[6]","noteId":"footnote-11136-21","type":"annotation-ref"},{"text":"恋旧林，池鱼思故渊。\n\n开荒南野","type":"te