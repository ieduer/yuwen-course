cy_button.png?v=15","width":20}],"like_count":0,"links":[{"has_image":false,"href":"https://forum.rdfzer.com/t/topic/3055","text":"不生不死不茫茫","title":""},{"classes":"badge-category__wrapper ","has_image":true,"href":"https://forum.rdfzer.com/c/general/4","text":"卮言","title":""},{"classes":"mention","has_image":false,"href":"https://forum.rdfzer.com/u/gggggg","text":"@gggggg","title":""}],"plainText":"不生不死不茫茫 卮言 如题,谁来接? 我不会写了... Last edited by @gggggg 2024-11-01T07:11:07Z (UTC)","post_number":9,"reply_to_post_number":null,"updated_at":"2024-11-01T08:42:01Z"},{"attachments":[],"created_at":"2024-11-01T08:57:38Z","id":20730,"images":[],"like_count":0,"links":[],"plainText":"","post_number":10,"reply_to_post_number":null,"updated_at":"2025-02-22T04:26:09Z"},{"attachments":[],"created_at":"2025-11-21T03:00:56Z","id":91130,"images":[],"like_count":0,"links":[{"classes":"inline-onebox","has_image":false,"href":"https://bdfz.yuque.com/org-wiki-bdfz-oz9uor/yrhg03/aqo192?singleDoc#","text":"江城子·乙卯正月二十日夜记梦/苏轼 · BDFZ","title":""}],"plainText":"江城子·乙卯正月二十日夜记梦/苏轼 · BDFZ 《江城子·乙卯正月二十日夜记梦/苏轼》","post_number":11,"reply_to_post_number":null,"updated_at":"2025-11-21T03:00:56Z"},{"attachments":[{"classes":"attachment","has_image":false,"href":"https://forum.rdfzer.com/uploads/short-url/ykWTCYPnpF44GHcHsVeN2R8dnH5.pdf","text":"Pages from 钦定词谱.40卷.清.陈廷敬.王奕清等奉敕纂修.清康熙54年内府刊朱墨套印本.1715年.pdf","title":""}],"created_at":"2025-11-24T05:04:58Z","id":92293,"images":[],"like_count":0,"links":[{"classes":"attachment","has_image":false,"href":"https://forum.rdfzer.com/uploads/short-url/ykWTCYPnpF44GHcHsVeN2R8dnH5.pdf","text":"Pages from 钦定词谱.40卷.清.陈廷敬.王奕清等奉敕纂修.清康熙54年内府刊朱墨套印本.1715年.pdf","title":""}],"plainText":"Pages from 钦定词谱.40卷.清.陈廷敬.王奕清等奉敕纂修.清康熙54年内府刊朱墨套印本.1715年.pdf (16.2 MB)","post_number":12,"reply_to_post_number":null,"updated_at":"2025-11-24T05:04:58Z"}],"readerDocument":{"curationManifestSha256":"98e90b3603b34b437bc554810c21f01c4db44d10364211af114d30fde3d67bad","curationVersion":"2026-07-30.2","lessonId":"lesson-1500","main":{"annotations":[{"blocks":[{"runs":[{"text":"两茫茫：指双方茫然不相知。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10084-1"},{"blocks":[{"runs":[{"text":"千里孤坟：王弗葬地在四川眉山，与苏轼任职的山东密州相距遥远，故称亡妻的坟为“千里孤坟”，有感伤自己不能与她同穴相伴之意。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10084-2"},{"blocks":[{"runs":[{"text":"幽梦：隐约迷离的梦。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10084-3"},{"blocks":[{"runs":[{"text":"轩窗：窗户。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10084-4"},{"blocks":[{"runs":[{"text":"短松冈：长着矮小松树的山冈，指王弗坟茔所在地。","type":"text"}],"type":"paragraph"}],"noteId":"footnote-10084-5"}],"blocks":[{"runs":[{"text":"十年生死两茫茫","type":"text"},{"label":"[1]","noteId":"footnote-10084-1","type":"annotation-ref"},{"text":"。不思量，自难忘。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"千里孤坟","type":"text"},{"label":"[2]","noteId":"footnote-10084-2","type":"annotation-ref"},{"text":"，无处话凄凉。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"纵使相逢应不识，尘满面，鬓如霜。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"夜来幽梦","type":"text"},{"label":"[3]","noteId":"footnote-10084-3","type":"annotation-ref"},{"text":"忽还乡。小轩窗","type":"text"},{"label":"[4]","noteId":"footnote-10084-4","type":"annotation-ref"},{"text":"，正梳妆。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"相顾无言，惟有泪千行。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"料得年年肠断处，明月夜，短松冈","type":"text"},{"label":"[5]","noteId":"footnote-10084-5","type":"annotation-ref"},{"text":"。","type":"text"}],"type":"paragraph"},{"blocks":[{"runs":[{"text":"生死相隔，深情难忘。这首悼亡词一开篇便抒发作者对妻子诚笃的感情。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"生死，是一种隔；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"妻子葬于千里外的故乡，是一种隔；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"岁月沧桑，即使相逢也认不出，又是一种隔；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"梦中还乡，四目相对，千言万语无从谈起，还是一种隔。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"在对梦境的淡淡追述中，将死别之悲、独处之苦、世路之艰写得极为沉痛。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"诵读这首词，留意细节描写，体会作者是如何把梦境的记述、对亡妻的思念和落拓的身世之感融合在一起的。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"生死相念，茫茫的是岁月时光，横亘的，是无变相思。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"生死，有念；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"千里孤坟，一话或无话，是念；","type":"text"}],"type":"paragraph"},{"runs":[{"text":"相守未终老，阴阳隔断，使尘鬓不识，但，我念。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"梦还乡，目相对，无言是念，泪行是念。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"明月是念，短松是念，肠断不断，我所念，皆是你。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"死生，无论，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"独偶，无计，","type":"text"}],"type":"paragraph"},{"runs":[{"text":"世路利艰，无关。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"诵读这首词，留意细节描写，体会作者是如何把梦境的记述、对亡妻的思念和落拓的身世之感融合在一起的。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"frontMatter":[{"blocks":[{"runs":[{"text":"选自《东坡乐府笺》卷一（上海古籍出版社2009年版）。","type":"text"}],"type":"paragraph"},{"runs":[{"text":"这首词作于宋神宗熙宁八年（1075），是苏轼在密州（今山东诸城）做知州时悼念妻子王弗的作品。王弗去世于宋英宗治平二年（1065）。","type":"text"}],"type":"paragraph"}],"type":"quote"}],"guidance":[],"links":[{"disposition":"system-browser","href":"https://sites.google.com/view/pkuschool/cover3/%e4%b8%ad%e5%9b%bd%e5%8f%a4%e5%85%b8%e8%af%97%e6%ad%8c%e7%9a%84%e6%84%8f%e8%b1%a1/%e6%b1%9f%e5%9f%8e%e5%ad%90%e4%b9%99%e5%8d%af%e6%ad%a3%e6%9c%88%e4%ba%8c%e5%8d%81%e6%97%a5%e5%a4%9c%e8%ae%b0%e6%a2%a6%e8%8b%8f%e8%bd%bc","sourceUrl":"https://sites.google.com/view/pkuschool/cover3/%e4%b8%ad%e5%9b%bd%e5%8f%a4%e5%85%b8%e8%af%97%e6%ad%8c%e7%9a%84%e6%84%8f%e8%b1%a1/%e6%b1%9f%e5%9f%8e%e5%ad%90%e4%b9%99%e5%8d%af%e6%ad%a3%e6%9c%88%e4%ba%8c%e5%8d%81%e6%97%a5%e5%a4%9c%e8%ae%b0%e6%a2%a6%e8%8b%8f%e8%bd%bc","text":"https://sites.google.com/view/pkuschool/cover3/%e4%b8%ad%e5%9b%bd%e5%8f%a4%e5%85%b8%e8%af%97%e6%ad%8c%e7%9a%84%e6%84%8f%e8%b1%a1/%e6%b1%9f%e5%9f%8e%e5%ad%90%e4%b9%99%e5%8d%af%e6%ad%a3%e6%9c%88%e4%ba%8c%e5%8d%81%e6%97%a5%e5%a4%9c%e8%ae%b0%e6%a2%a6%e8%8