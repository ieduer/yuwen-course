,"href":"https://img.rdfzer.com/pages/0433798ca156/p1.webp","label":"p1","matched":false,"mediaType":"image/webp","page":1,"rightsBasis":"user-authorized-for-bdfz-yw-app-2026-07-29","sha256":"4bcaad17090b64abc97ad7160bdfecee0f0600cceab54c2ad57a2a4bffb9c3e1","sourceLocalRef":"textbook_ai_migration/platform/frontend/assets/pages/0433798ca156/p1.webp","sourceUrl":"https://img.rdfzer.com/pages/0433798ca156/p1.webp"},{"bytes":33072,"href":"https://img.rdfzer.com/pages/0433798ca156/p2.webp","label":"p2","matched":false,"mediaType":"image/webp","page":2,"rightsBasis":"user-authorized-for-bdfz-yw-app-2026-07-29","sha256":"b93ec3859a131893b17633c0ae069a35568c2bcb9d8232c5b1ab60abb915b800","sourceLocalRef":"textbook_ai_migration/platform/frontend/assets/pages/0433798ca156/p2.webp","sourceUrl":"https://img.rdfzer.com/pages/0433798ca156/p2.webp"},{"bytes":40790,"href":"https://img.rdfzer.com/pages/0433798ca156/p3.webp","label":"p3","matched":false,"mediaType":"image/webp","page":3,"rightsBasis":"user-authorized-for-bdfz-yw-app-2026-07-29","sha256":"b3d025cf476dbc8356455b902d5f7efbc9a9e755b83d8f9fd7d38903ed937e9e","sourceLocalRef":"textbook_ai_migration/platform/frontend/assets/pages/0433798ca156/p3.webp","sourceUrl":"https://img.rdfzer.com/pages/0433798ca156/p3.webp"},{"bytes":22560,"href":"https://img.rdfzer.com/pages/0433798ca156/p4.webp","label":"p4","matched":false,"mediaType":"image/webp","page":4,"rightsBasis":"user-authorized-for-bdfz-yw-app-2026-07-29","sha256":"5e04419eb1583ca8d8dcfa4a0685cf79ec6283a3d76fdcd1fa9d89c1783233e7","sourceLocalRef":"textbook_ai_migration/platform/frontend/assets/pages/0433798ca156/p4.webp","sourceUrl":"https://img.rdfzer.com/pages/0433798ca156/p4.webp"},{"bytes":76784,"href":"https://img.rdfzer.com/pages/0433798ca156/p5.webp","label":"p5","matched":true,"mediaType":"image/webp","page":5,"rightsBasis":"user-authorized-for-bdfz-yw-app-2026-07-29","sha256":"6acc6b1e60db7b49ad2eaab782adcc95da92638967ad062fad4b34d0d7332966","sourceLocalRef":"textb