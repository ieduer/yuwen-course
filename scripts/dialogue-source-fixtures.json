    "lesson-1711-p1": [
      {
        "id": "language-er",
        "word": "而",
        "type": "function-word",
        "sourceSentence": "順風而呼，聲非加疾也，而聞者彰；君子博學而日參省乎己。",
        "meaning": "把「順風」與「呼」相接，表示修飾；「而聞者彰」與聲音未加強相轉折；「博學而日參省」表示遞進。",
        "explanation": "比較每個而前後成分的關係；不同語境不套用同一個現代連詞。術語不能替代句意說明。",
        "dictionaryId": "xc-er",
        "annotationIds": [],
        "difficulty": null,
        "variants": [
          "比較「順風而呼」與「而聞者彰」：兩個「而」連接的內容是甚麼，關係相同嗎？請用自己的話說明。",
          "把「君子博學而日參省乎己」與「順風而呼」中的「而」換成適當的現代說法，解釋兩處為甚麼不能都機械譯成「但是」。"
        ],
        "proposedDemand": "context-comparison",
        "calibrationStatus": "pending-real-model",
        "scoringRole": "none",
        "passageQuotes": [
          "顺风而呼",
          "而闻者彰",
          "君子博学而日参省乎己"
        ],
        "misconceptions": [
          "只報術語，未解釋語境",
          "照抄提示，未獨立改述"
        ]
      },
      {
        "id": "language-yu",
        "word": "于",
        "type": "function-word",
        "sourceSentence": "青，取之于藍，而青于藍。",
        "meaning": "「取之于藍」的于引出來源；「青于藍」的于引出比較對象。",
        "explanation": "依教材兩條註釋，分別還原成「從藍草取得」與「比藍草顏色深」；不只報詞性名稱。",
        "annotationIds": [
          "footnote-11143-3",
          "footnote-11143-4"
        ],
        "dictionaryStatus": "specialist-image-awaiting-verification",
        "difficulty": null,
        "variants": [
          "「取之于藍」與「青于藍」中的「于」分別引出甚麼？請把兩處改寫成現代說法。",
          "若把「青于藍」解作「從藍草取得」，會混淆哪兩個意思？請用兩處原句說明。"
        ],
        "proposedDemand": "context-comparison",
        "calibrationStatus": "pending-real-model",
        "scoringRole": "none",
        "passageQuotes": [
          "青，取之于蓝，而青于蓝"
        ],
        "misconceptions": [
          "只報術語，未解釋語境",
          "照抄提示，未獨立改述"
        ],
        "dictionaryId": "xc-yu"
      },
      {
        "id": "grammar-water",
        "word": "水",
        "type": "grammar",
        "sourceSentence": "假舟楫者，非能水也，而絕江河。",
        "meaning": "「水」在此表示游泳這個動作；句意是借助舟船的人未必善於游泳，卻能渡過江河。",
        "explanation": "教材註「能水：善於游水。水，游泳。」說明句法作用與語境，不能只報「活用」術語。",
        "annotationIds": [
          "footnote-11143-23"
        ],
        "difficulty": null,
        "variants": [
          "「非能水也」的「水」在句中指事物還是動作？請根據上下文說明，並改寫這句話。",
          "如果把「水」只解釋為江水，為何無法說通「假舟楫者，非能水也」？請解釋它在這句中的作用。"
        ],
        "proposedDemand": "context-reformulation",
        "calibrationStatus": "pending-real-model",
        "scoringRole": "none",
        "passageQuotes": [
          "假舟楫者，非能水也，而绝江河"
        ],
        "misconceptions": [
          "只報術語，未解釋語境",
          "照抄提示，未獨立改述"
        ]
      },
      {
        "id": "grammar-one",
        "word": "一",
        "type": "grammar",
        "sourceSentence": "用心一也。",
        "meaning": "「一」說的是專一，不是心的數量。",
        "explanation": "沿用教材「一：專一」的註釋；把這一判斷與前文寫蚓的行為相連。",
        "annotationIds": [
          "footnote-11143-39"
        ],
        "difficulty": null,
        "variants": [
          "「用心一也」的「一」能否只譯成數量「一個」？請改寫句意，並說明與前文的關係。",
          "課文用「一」說明蚓能做成事情的原因。它在此描述甚麼狀態？請用自己的話解釋。"
        ],
        "proposedDemand": "context-reformulation",
        "calibrationStatus": "pending-real-model",
        "scoringRole": "none",
        "passageQuotes": [
          "用心一也"
        ],
        "misconceptions": [
          "只報術語，未解釋語境",
          "照抄提示，未獨立改述"
        ]
      },
      {
        "id": "grammar-wuyi",
        "word": "无以",
        "type": "grammar",
        "sourceSentence": "故不积跬步，无以至千里；不积小流，无以成江海。",
        "passageQuotes": [
          "故不积跬步，无以至千里；不积小流，无以成江海。"
        ],
        "meaning": "無以是沒有用來達成某事的條件或辦法，不是「不用」。",
        "explanation": "沿用教材無以註釋，對比條件的缺乏與主動放棄；保留積累與結果的關係。",
        "annotationIds": [
          "footnote-11143-31"
        ],
        "difficulty": null,
        "proposedDemand": "context-reformulation",
        "calibrationStatus": "pending-real-model",
        "scoringRole": "none",
        "variants": [
          "「無以至千里」能不能理解為「不用走到千里」？請改寫整句，說明差別。",
          "把「不積小流，無以成江海」改寫為自己的話，說明前後兩部分的條件關係。"
        ],
        "misconceptions": [
          "只報術語，未解釋語境",
          "照抄提示，未獨立改述"
        ]
      },
      {
        "id": "grammar-modifier",
        "word": "爪牙之利、筋骨之强",
        "type": "grammar",
        "sourceSentence": "蚓无爪牙之利，筋骨之强，上食埃土，下饮黄泉，用心一也。",
        "passageQuotes": [
          "蚓无爪牙之利，筋骨之强，上食埃土，下饮黄泉，用心一也。"
        ],
        "meaning": "蚯蚓沒有鋒利的爪牙、強健的筋骨，卻能向上吃泥土、向下飲地下水；此處利、強說明爪牙與筋骨的性質。",
        "explanation": "語序分析是依課文作的教學解釋，不冒充教材已有的句式註釋；接受能還原修飾關係的說明，不能只答定語後置。",
        "annotationIds": [
          "footnote-11143-37",
          "footnote-11143-38",
          "footnote-11143-39"
        ],
        "difficulty": null,
        "proposedDemand": "syntax-and-effect",
        "calibrationStatus": "pending-real-model",
        "scoringRole": "none",
        "variants": [
          "「爪牙之利，筋骨之強」中的利、強分別說明甚麼？請改成現代語序，並說明作者為甚麼接著寫蚓能做的事。",
          "如果把「爪牙之利」讀成「爪牙帶來的利益」，與本句前後有何衝突？請還原兩組修飾關係。"
        ],
        "misconceptions": [
          "只報術語，未解釋語境",
          "照抄提示，未獨立改述"
        ]
      }
