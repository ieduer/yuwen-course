    "lesson-1498": [
      {
        "id": "language-he",
        "word": "何",
        "type": "function-word",
        "sourceSentence": "江畔何人初见月？江月何年初照人？",
        "passageQuotes": [
          "江畔何人初见月？江月何年初照人？"
        ],
        "meaning": "何人問人，何年問時間；兩問把個人的初見擴展到人與月的久遠關係。",
        "explanation": "疑問用法與本詩的追問是兩層：先說清問甚麼，再依前後詩句分析；不把修辭效果冒充詞典釋義。",
        "annotationIds": [],
        "difficulty": null,
        "proposedDemand": "context-comparison",
        "calibrationStatus": "pending-real-model",
        "scoringRole": "none",
        "variants": [
          "「何人」和「何年」各在追問甚麼？若只說「何是疑問詞」，還缺少哪一層句意？",
          "請把這兩問改為自己的話，再說明「初」和兩個「何」怎樣把問題推向久遠的時間。"
        ],
        "misconceptions": [
          "只報術語，未解釋語境",
          "照抄提示，未獨立改述"
        ],
        "dictionaryId": "xc-he",
        "dictionaryStatus": "specialist-image-awaiting-verification"
      },
      {
        "id": "language-dan",
        "word": "但",
        "type": "function-word",
        "sourceSentence": "不知江月待何人，但见长江送流水。",
        "passageQuotes": [
          "不知江月待何人，但见长江送流水。"
        ],
        "meaning": "但見是只見，限制眼前能看見的範圍，不宜直接套成現代轉折詞「但是」。",
        "explanation": "詞義依指定虛詞詞典的副詞用法核對；上下句從不知到但見的認知變化是文本解讀，允許有證據的不同表述。",
        "annotationIds": [],
        "difficulty": null,
        "proposedDemand": "context-comparison",
        "calibrationStatus": "pending-real-model",
        "scoringRole": "none",
        "variants": [
          "「但見」若換成「只看見」，與上句「不知」有何聯繫？請解釋，不能只把但譯成但是。",
          "這裡的「但」限制了甚麼？請分別說明詩中人不知道的事與眼前看見的事。"
        ],
        "misconceptions": [
          "只報術語，未解釋語境",
          "照抄提示，未獨立改述"
        ],
        "dictionaryId": "xc-dan",
        "dictionaryStatus": "specialist-image-awaiting-verification"
      },
      {
        "id": "grammar-moon",
        "word": "卷不去、拂还来",
        "type": "grammar",
        "sourceSentence": "玉户帘中卷不去，捣衣砧上拂还来。",
        "passageQuotes": [
          "玉户帘中卷不去，捣衣砧上拂还来。"
        ],
        "meaning": "卷不去、拂還來的是月光；承接前面的月，動作與不能排遣的相思聯繫起來。",
        "explanation": "沿用教材對玉戶簾中卷不去的註解。省略內容的還原須有前句依據；不把月光真的有意志當作者生平事實。",
        "annotationIds": [
          "footnote-10076-11"
        ],
        "difficulty": null,
        "proposedDemand": "syntax-and-effect",
        "calibrationStatus": "pending-real-model",
        "scoringRole": "none",
        "variants": [
          "「卷不去」「拂還來」省略了甚麼？請從前後詩句找到依據，再說明為甚麼不直接寫思念。",
          "請把兩句省略的對象補回，說明兩個動作為甚麼都未奏效；不要只報省略句這個名稱。"
        ],
        "misconceptions": [
          "只報術語，未解釋語境",
